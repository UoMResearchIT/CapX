# Environment variables for Docker Compose
# Copy this file to .env and fill in your values:
#   cp .env.sample .env

# ASP.NET Core environment (Development, Production)
ASPNETCORE_ENVIRONMENT=Development

# Secret key for JWT/API authentication (min 32 characters)
API_KEY_SECRET=your-secret-key-at-least-32-characters

# Connection string for the main PPMTool SQLite database
# Note: Uses state/ volume mount path for Docker
# CONNECTION_STRING is set in compose.yml, override here if needed

# Connection string for leave bookings database (MySQL)
LEAVEBOOKINGS_CONNECTION_STRING=connection-string-for-leave-bookings-db

# Optional: Seed dummy data on startup (TRUE/FALSE)
SEED_DUMMY_DATA=FALSE

# Optional: Default superuser details (for development)
SUPERUSER_NAME=Your Name
SUPERUSER_USERNAME=your_username
SUPERUSER_EMAIL=your.email@example.com

# Optional: Override default ports
# CAPX_HTTP_PORT=3000
# CAPX_API_PORT=8080
