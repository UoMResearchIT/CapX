# Environment variables for Docker Compose
# Copy this file to .env and fill in your values:
#   cp .env.sample .env

# ASP.NET Core environment, Development, Production.
ASPNETCORE_ENVIRONMENT=Development

# Build configuration: Local, Debug, Release
BUILD_CONFIGURATION=Debug

# Secret key for JWT/API authentication (min 32 characters)
API_KEY_SECRET=your-secret-key-at-least-32-characters

# Connection string for the main PPMTool SQLite database
CONNECTION_STRING=Data Source=state/PPMTool.db;Cache=Shared;Mode=ReadWriteCreate;

# Connection string for leave bookings database
LEAVEBOOKINGS_CONNECTION_STRING=Data Source=state/LeaveBookings.db;Cache=Shared;Mode=ReadWriteCreate;

# Port mappings
CAPX_HTTP_PORT=3000
CAPX_API_PORT=8080

# Optional: Local - Debugging settings
SEED_DUMMY_DATA=FALSE
SUPERUSER_NAME=
SUPERUSER_USERNAME=
SUPERUSER_EMAIL=
