# Set this to "Production" on the production server and "Development" on the development server
ASPNETCORE_ENVIRONMENT=Development

# The port for the API
ASPNETCORE_URLS=http://*:6000

# Connection string to the DB
# e.g. "Data Source=../capx/PPMTool.db;Cache=Shared;" for API in production
# e.g. "Data Source=../PPMTool/PPMTool.db;Cache=Shared;" for API locally
# e.g. "Data Source=PPMTool.db;Cache=Shared;" for API in docker locally
CONNECTION_STRING=
