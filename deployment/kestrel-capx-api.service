[Unit]
Description=CapX API kestrel server

[Service]
EnvironmentFile=/var/www/capx-api/variables-api.env
WorkingDirectory=/var/www/capx-api
ExecStart=/usr/bin/dotnet /var/www/capx-api/PPMTool.API.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=capx-api
User=www-data

[Install]
WantedBy=multi-user.target
