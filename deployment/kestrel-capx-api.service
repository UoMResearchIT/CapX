[Unit]
Description=CapX API kestrel server

[Service]
WorkingDirectory=/var/www/capx-api
ExecStart=/usr/bin/dotnet /var/www/capx-api/PPMTool.API.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=capx-api
User=www-data
# Set this to "Production" on the production server and "Development" on the development server
Environment=ASPNETCORE_ENVIRONMENT=Development
Environment=ASPNETCORE_URLS=http://*:6000

[Install]
WantedBy=multi-user.target
