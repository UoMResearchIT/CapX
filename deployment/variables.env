# Secret for the API key generator
# Minimum 32-character long
API_KEY_SECRET=

# Runtime .NET environment.
# Set this to "Production" on the production server and "Development" on the development server
ASPNETCORE_ENVIRONMENT=Development

# URL where to send Sentry crash reports
SENTRY_DSN=

# Whether to seed dummy data: True or False
SEED_DUMMY_DATA=

# Name of super user
SUPERUSER_NAME=

# Username of superuser for authentication
SUPERUSER_USERNAME=

# Email address of superuser for notifications
SUPERUSER_EMAIL=

# Connection string to the DB
# e.g. "Data Source=PPMTool.db;Cache=Shared;"
CONNECTION_STRING=
