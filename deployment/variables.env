# Secret for the API key generator
# Minimum 32-character long
API_KEY_SECRET=

# Runtime .NET environment.
# Set this to "Production" on the production server and "Development" on the development server
ASPNETCORE_ENVIRONMENT=Development

# URL where to send Sentry crash reports
SENTRY_DSN=

# Whether to seed dummy data: True or False
SEED_DUMMY_DATA=

# Name of super user
SUPERUSER_NAME=

# Username of superuser for authentication
SUPERUSER_USERNAME=

# Email address of superuser for notifications
SUPERUSER_EMAIL=

# Connection string to the DB
# e.g. "Data Source=PPMTool.db;Cache=Shared;"
CONNECTION_STRING=

# Connection string for the leave bookings database
LEAVE_BOOKINGS_DATABASE=

# Address to send the emails from
MAIL_FROM_ADDRESS=

# SMTP server to send mail requests to
MAIL_SMTP_SERVER=

# CAS/Shibboleth protocol version
# Usually this is either 2 or 3.
CAS_PROTOCOL=2

# Base URL of the CAS/Shib endpoints
CAS_BASE_URL=

# Base URL of the Entra ID authentication service
# e.g. https://login.microsoftonline.com/
ENTRA_INSTANCE=

# The primary domain of the tenant
# e.g. yourtenant.onmicrosoft.com 
ENTRA_DOMAIN=

# ID of the tenant
# e.g. 72f988bf-86f1-41af-91ab-2d7cd011db47
ENTRA_TENANT_ID=

# ID of the registered app
ENTRA_CLIENT_ID=

# Secret associated with the registered app
ENTRA_CLIENT_SECRET=

# Local path where Entra redirects the browser after successful authentication
# e.g. /signin-oidc
ENTRA_CALLBACK_PATH=

# Which type of authentication provider to user
# Can be "CAS" or "AzureAd"
AUTH_TYPE=

# URL of the site that is whitelisted with the authentication endpoints
# Basically the URL of the site to which auth flow returns
AUTH_HOST_URL=
