# Secret for the API key generator
API_KEY_SECRET=

# Set this to "Production" on the production server and "Development" on the development server
ASPNETCORE_ENVIRONMENT=Development

# Sentry
SENTRY_DSN=

# Seed dummy data
SEED_DUMMY_DATA=
SUPERUSER_NAME=
SUPERUSER_USERNAME=
SUPERUSER_EMAIL=

# Connection string to the DB
# e.g. "Data Source=PPMTool.db;Cache=Shared;"
CONNECTION_STRING=

# Connection string to the Leave Bookings DB
# e.g. "Server=127.0.0.1;Port=3307;Database=<Database>;Uid=<UID>;Pwd=<Password>;" Do not forget to update the values with <>.
LEAVEBOOKINGS_CONNECTION_STRING=
