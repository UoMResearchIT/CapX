# Secret for the API key generator
API_KEY_SECRET=

# Set this to "Production" on the production server and "Development" on the development server
ASPNETCORE_ENVIRONMENT=Development

# Sentry
SENTRY_DSN=

# Seed dummy data
SEED_DUMMY_DATA=
SUPERUSER_NAME=
SUPERUSER_USERNAME=
SUPERUSER_EMAIL=

# Connection string to the DB
# e.g. "Data Source=../capx/PPMTool.db;Cache=Shared;" for API in production
# e.g. "Data Source=../PPMTool/PPMTool.db;Cache=Shared;" for API locally
# e.g. "Data Source=PPMTool.db;Cache=Shared;" for API in docker and app locally
CONNECTION_STRING=