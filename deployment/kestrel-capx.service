[Unit]
Description=CapX web app and API kestrel server

[Service]
EnvironmentFile=/var/www/capx/variables.env
WorkingDirectory=/var/www/capx
ExecStart=/usr/bin/dotnet /var/www/capx/PPMTool.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=capx
User=www-data

[Install]
WantedBy=multi-user.target
