[Unit]
Description=CapX app kestrel server

[Service]
WorkingDirectory=/var/www/capx
ExecStart=/usr/bin/dotnet /var/www/capx/PPMTool.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=capx
User=www-data
# Set this to "Production" on the production server and "Development" on the development server
Environment=ASPNETCORE_ENVIRONMENT=Development 

[Install]
WantedBy=multi-user.target
