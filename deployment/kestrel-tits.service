[Unit]
Description=T:ITS app kestrel server

[Service]
WorkingDirectory=/var/www/tits
ExecStart=/usr/bin/dotnet /var/www/tits/PPMTool.dll
Restart=always
# Restart service after 10 seconds if the dotnet service crashes:
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=tits
User=www-data
# Set this to "Production" on the production server and "Development" on the development server
Environment=ASPNETCORE_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target
