@page "/managefinancialitems/summary"
@inherits BasePage
@using PPMTool.Models
@using PPMTool.Data.Entities
@using PPMTool.Data.Enums
@using PPMTool.Pages.Components
@using Radzen
@using System.ComponentModel.DataAnnotations
<PageTitle>Finance Summary - CapX</PageTitle>

<FeatureCheckComponent Feature="FeatureType.ProjectFinance">

    <div class="container">
        <div class="row align-items-center">
            <div class="col mr-auto">
                <h1>Finance Summary</h1>
            </div>
            <div class="col-auto">
                <RadzenButton Click="@(args => GoToFinanceItems())" Text="Finance Items" Icon="payments" />
            </div>
        </div>
        <hr />
        @if (Loading)
        {
            <LoadingComponent />
        }
        else
        {
            <RadzenCard>
                <div style="overflow-x: auto; width: 100%;">
                    <RadzenDataGrid Data="@items"
                                    ColumnWidth="8rem"
                                    TItem="FinanceSummaryItem"
                                    FilterMode="FilterMode.Simple"
                                    AllowSorting="true"
                                    AllowFiltering="true"
                                    PageSize="15"
                                    AllowPaging="true"
                                    ShowPagingSummary="true"
                                    AllowColumnResize="true"
                                    @ref="dataGrid">
                        <Columns>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" 
                                                  Property="StartDate" 
                                                  Title="Start Date" 
                                                  FormatString="{0:dd/MM/yyyy}" 
                                                  Type="typeof(DateTime)" 
                                                  FilterMode="FilterMode.SimpleWithMenu" 
                                                  FilterOperator="FilterOperator.GreaterThanOrEquals"
                                                  Width="13rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" 
                                                  Property="EndDate" 
                                                  Title="End Date" 
                                                  FormatString="{0:dd/MM/yyyy}"
                                                  Type="typeof(DateTime)"
                                                  FilterMode="FilterMode.SimpleWithMenu"
                                                  FilterOperator="FilterOperator.LessThanOrEquals"
                                                  Width="13rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectRTP" Title="@($"{GetSetting(SettingType.ProjectAbbreviation)}")" Width="5rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectName" Title="Project Name" Width="15rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectPI" Title="Project PI" Width="10rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectPM" Title="PM" Width="10rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectStatus" Title="Status" Width="10rem">
                                <Template Context="item">
                                    @item.ProjectStatus.ToNiceString()
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="Faculty.Code" Title="@($"{GetSetting(SettingType.OrgUnitUpper)}")">
                                <Template Context="item">
                                    @item.Faculty.Code
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="School.Code" Title="@($"{GetSetting(SettingType.OrgUnitLower)}")">
                                <Template Context="item">
                                    @item.School.Code
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="CostModel" Title="Cost Model" Width="8rem">
                                <Template Context="item">
                                    @(item.CostModel.GetAttribute<DisplayAttribute>().Name)
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="DayRateForGrid" Title="Day Rate">
                                <Template Context="item">
                                    @(item.DayRateForGrid.HasValue ? item.DayRateForGrid.Value.ToString("C0") : "N/A")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="Budget" Title="Agreed Budget Total" FormatString="{0:C0}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="BudgetDirectCostsForGrid" Title="Agreed Budget Directs" FormatString="{0:C0}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="BudgetIndirectCostsForGrid" Title="Agreed Budget Indirects">
                                <Template Context="item">
                                    @(item.BudgetIndirectCostsForGrid.HasValue ? item.BudgetIndirectCostsForGrid.Value.ToString("C0") : "N/A")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="PlannedTotalCost" Title="Planned Cost Total">
                                <Template Context="item">
                                    <span style="color:@item.PlannedCostColour">@item.PlannedTotalCost.ToString("C0")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="PlannedTechnicalCosts" Title="Planned Cost Technical" FormatString="{0:C0}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="PlannedLeadershipCostsForGrid" Title="Planned Cost Leadership">
                                <Template Context="item">
                                    @(item.PlannedLeadershipCostsForGrid.HasValue ? item.PlannedLeadershipCostsForGrid.Value.ToString("C0") : "N/A")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="PlannedIndirectCostsForGrid" Title="Planned Cost Indirects">
                                <Template Context="item">
                                    @(item.PlannedIndirectCostsForGrid.HasValue ? item.PlannedIndirectCostsForGrid.Value.ToString("C0") : "N/A")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ActualTotalCost" Title="Actual Cost Total">
                                <Template Context="item">
                                    <span style="color:@item.ActualCostColour">@item.ActualTotalCost.ToString("C0")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ActualTechnicalCosts" Title="Actual Cost Technical" FormatString="{0:C0}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ActualLeadershipCostsForGrid" Title="Actual Cost Leadership">
                                <Template Context="item">
                                    @(item.ActualLeadershipCostsForGrid.HasValue ? item.ActualLeadershipCostsForGrid.Value.ToString("C0") : "N/A")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ActualIndirectCostsForGrid" Title="Actual Cost Indirects">
                                <Template Context="item">
                                    @(item.ActualIndirectCostsForGrid.HasValue ? item.ActualIndirectCostsForGrid.Value.ToString("C0") : "N/A")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ActualHours" Title="Actual Hours" FormatString="{0:F2}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsRequestedTotal" Title="Funds Requested Total">
                                <Template Context="item">
                                    <span style="color:@item.FundsRequestedColour">@item.FundsRequestedTotal.ToString("C0")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsDI" Title="Funds Requested DI">
                                <Template Context="item">
                                    <span style="color:@item.FundsDIColour">@item.FundsDI.ToString("C0")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsDA" Title="Funds Requested DA" FormatString="{0:C0}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsRequestedOther" Title="Funds Requested Other" FormatString="{0:C0}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsReceivedTotal" Title="Funds Received Total">
                                <Template Context="item">
                                    <span style="color:@item.FundsReceivedColour">@item.FundsReceivedTotal.ToString("C0")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsReceivedDI" Title="Funds Received DI">
                                <Template Context="item">
                                    <span style="color:@item.FundsDIColour">@item.FundsReceivedDI.ToString("C0")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsDA" Title="Funds Received DA" FormatString="{0:C0}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsReceivedOther" Title="Funds Received Other" FormatString="{0:C0}" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ListOfFundingSources" Title="Funding Sources" Filterable="false" Width="12rem">
                                <Template Context="item">
                                    @item.ListOfFundingSources
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsOwed" Title="Owed" Filterable="false">
                                <Template Context="item">
                                    <span style="color: @item.FundsOwedColour;">@item.FundsOwed.ToString("C0")</span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </RadzenCard>
        }
    </div>

</FeatureCheckComponent>