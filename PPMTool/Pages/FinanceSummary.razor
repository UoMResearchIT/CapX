@page "/managefinancialitems/summary"
@inherits BasePage
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Pages.Components
@using Radzen
@using System.ComponentModel.DataAnnotations
<PageTitle>Finance Summary - CapX</PageTitle>

<div class="container">
    <div class="row align-items-center">
        <div class="col mr-auto">
            <h1>Finance Summary</h1>
        </div>
        <div class="col-auto">
            <RadzenButton Click="@(args => GoToFinanceItems())" Text="Finance Items" Icon="payments" />
        </div>
    </div>
    <hr />
    <RadzenCard>
        <RadzenDataGrid Data="@items"
                        TItem="FinanceSummaryItem"
                        ColumnWidth="5rem"
                        FilterMode="FilterMode.CheckBoxList"
                        AllowSorting="true"
                        AllowFiltering="true"
                        PageSize="15"
                        AllowPaging="true"
                        ShowPagingSummary="true"
                        AllowColumnResize="true"
                        Density="Density.Compact"
                        @ref="dataGrid">
            <Columns>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="StartDate" Title="Start Date" FormatString="{0:yyyy-MM-dd}" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="EndDate" Title="End Date" FormatString="{0:yyyy-MM-dd}" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectRTP" Title="RTP" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectName" Title="Project Name" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectPI" Title="Project PI" MinWidth="10px" Width="7rem" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectPM" Title="PM" MinWidth="10px" Width="7rem" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectStatus" Title="Project Status" MinWidth="10px">
                    <Template Context="item">
                        @item.ProjectStatus.ToNiceString()
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="Faculty" Title="Faculty" MinWidth="10px">
                    <Template Context="item">
                        @item.Faculty.ToNiceString()
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="School" Title="School" MinWidth="10px">
                    <Template Context="item">
                        @item.School.ToNiceString()
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="CostModel" Title="Cost Model" Width="8rem" MinWidth="10px">
                    <Template Context="item">
                        @(item.CostModel.GetAttribute<DisplayAttribute>().Name)
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="DayRate" Title="Day Rate" FormatString="{0:C}" MinWidth="10px">
                    <Template Context="item">
                        @(item.CostModel == CostModel.DayRate ? item.DayRate.ToString("C0") : "N/A")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="Budget" Title="Budget" FormatString="{0:C}" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="PlannedCost" Title="Planned" MinWidth="10px">
                    <Template Context="item">
                        <span class="@item.PlannedCostColour">@item.PlannedCost.ToString("C")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ActualCost" Title="Actual" MinWidth="10px">
                    <Template Context="item">
                        <span class="@item.ActualCostColour">@item.ActualCost.ToString("C")</span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsDA" Title="DA Expected" FormatString="{0:C}" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsDI" Title="DI Estimate" FormatString="{0:C}" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Title="DI Expected" MinWidth="10px">
                    <Template Context="item">
                        <span style="color:@item.FundsDIColour">
                            @item.GetReceivedDI().ToString("C0")
                        </span>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsRequestedOther" Title="Other Requested" FormatString="{0:C}" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsReceivedOther" Title="Other Received" FormatString="{0:C}" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsOwed" Title="Owed" MinWidth="10px">
                    <Template Context="item">
                        <span class="@item.FundsOwedColour">@item.FundsOwed.ToString("C")</span>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenCard>
</div>