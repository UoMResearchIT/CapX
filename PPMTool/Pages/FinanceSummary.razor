@page "/managefinancialitems/summary"
@inherits BasePage
@using PPMTool.Models
@using PPMTool.Data.Entities
@using PPMTool.Data.Enums
@using PPMTool.Pages.Components
@using Radzen
@using System.ComponentModel.DataAnnotations
<PageTitle>Finance Summary - CapX</PageTitle>

<FeatureCheckComponent Feature="FeatureType.ProjectFinance">

    <div class="container">
        <div class="row align-items-center">
            <div class="col mr-auto">
                <h1>Finance Summary</h1>
            </div>
            <div class="col-auto">
                <RadzenButton Click="@(args => GoToFinanceItems())" Text="Finance Items" Icon="payments" />
            </div>
        </div>
        <hr />
        @if (Loading)
        {
            <LoadingComponent />
        }
        else
        {
            <RadzenCard>
                <div style="overflow-x: auto; width: 100%;">
                    <RadzenDataGrid Data="@items"
                                    ColumnWidth="8rem"
                                    TItem="FinanceSummaryItem"
                                    FilterMode="FilterMode.Simple"
                                    AllowSorting="true"
                                    AllowFiltering="true"
                                    PageSize="15"
                                    AllowPaging="true"
                                    ShowPagingSummary="true"
                                    AllowColumnResize="true"
                                    @ref="dataGrid">
                        <Columns>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" 
                                                  Property="StartDate" 
                                                  Title="Start Date" 
                                                  FormatString="{0:dd/MM/yyyy}" 
                                                  Type="typeof(DateTime)" 
                                                  FilterMode="FilterMode.SimpleWithMenu" 
                                                  FilterOperator="FilterOperator.GreaterThanOrEquals"
                                                  Width="13rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" 
                                                  Property="EndDate" 
                                                  Title="End Date" 
                                                  FormatString="{0:dd/MM/yyyy}"
                                                  Type="typeof(DateTime)"
                                                  FilterMode="FilterMode.SimpleWithMenu"
                                                  FilterOperator="FilterOperator.LessThanOrEquals"
                                                  Width="13rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectRTP" Title="@($"{GetSetting(SettingType.ProjectAbbreviation)}")" Width="5rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectName" Title="Project Name" Width="15rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectPI" Title="Project PI" Width="10rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectPM" Title="PM" Width="10rem" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ProjectStatus" Title="Status" Width="10rem">
                                <Template Context="item">
                                    @item.ProjectStatus.ToNiceString()
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="Faculty.Code" Title="@($"{GetSetting(SettingType.OrgUnitUpper)}")">
                                <Template Context="item">
                                    @item.Faculty.Code
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="School.Code" Title="@($"{GetSetting(SettingType.OrgUnitLower)}")">
                                <Template Context="item">
                                    @item.School.Code
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="CostModel" Title="Cost Model" Width="8rem">
                                <Template Context="item">
                                    @(item.CostModel.GetAttribute<DisplayAttribute>().Name)
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="DayRate" Title="Day Rate" FormatString="{0:C}" Filterable="false">
                                <Template Context="item">
                                    @(item.CostModel == CostModel.DayRate ? item.DayRate.ToString("C0") : "N/A")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="Budget" Title="Budget" FormatString="{0:C}" Filterable="false" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="PlannedTotalCost" Title="Planned" Filterable="false">
                                <Template Context="item">
                                    <span style="color: @item.PlannedCostColour;">@item.PlannedTotalCost.ToString("C")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="ActualTotalCost" Title="Actual" Filterable="false">
                                <Template Context="item">
                                    <span style="color: @item.ActualCostColour;">@item.ActualTotalCost.ToString("C")</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsDA" Title="DA Expected" FormatString="{0:C}" Filterable="false" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsDI" Title="DI Estimate" FormatString="{0:C}" Filterable="false" />
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Title="DI Expected" Filterable="false">
                                <Template Context="item">
                                    <span style="color: @item.FundsDIColour;">
                                        @item.GetReceivedDI().ToString("C0")
                                    </span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsRequestedOther" Title="Other Requested" FormatString="{0:C}" Filterable="false"/>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsReceivedOther" Title="Other Received" FormatString="{0:C}" Filterable="false"/>
                            <RadzenDataGridColumn TItem="FinanceSummaryItem" Property="FundsOwed" Title="Owed" Filterable="false">
                                <Template Context="item">
                                    <span style="color: @item.FundsOwedColour;">@item.FundsOwed.ToString("C")</span>
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </div>
            </RadzenCard>
        }
    </div>

</FeatureCheckComponent>