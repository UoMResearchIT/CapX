@page "/manageskills"
@inherits DataGridPage<SkillTag>
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
<PageTitle>Manage Skills - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>Manage Skills</h1>
        </div>
        <div class="col-auto">
            <RadzenButton class="float-right" Text="Add" Icon="add" Click="@InsertRow" Disabled="@(entityToInsert != null)" />
        </div>
    </div>
    @if (ErrorMessage != null)
    {
        <StatusMessageComponent Message="ErrorMessage" />
    }
    <hr />
    <RadzenDataGrid @ref="dataGrid"
                    AllowFiltering="@(dataGridEntities != null && dataGridEntities.Count > 0)"
                    AllowPaging="true"
                    PageSize="15"
                    AllowSorting="true"
                    EditMode="DataGridEditMode.Single"
                    Data="@dataGridEntities"
                    TItem="SkillTag"
                    RowUpdate="@OnUpdateRow"
                    RowCreate="@OnCreateRow"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn TItem="SkillTag" Property="Name" Title="Name" Width="280px" MinWidth="10px">
                <EditTemplate Context="tag">
                    <RadzenTextBox class="no-margin" @bind-Value="tag.Name" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SkillTag" Property="ControlledName" Title="Controlled Name" Width="280px" MinWidth="10px">
                <EditTemplate Context="tag">
                    <RadzenTextBox class="no-margin" @bind-Value="tag.ControlledName" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SkillTag" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="120px" MinWidth="10px" Title="Actions">
                <Template Context="tag">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(tag))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(tag))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" />
                </Template>
                <EditTemplate Context="tag">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(tag))" MouseEnter="@(args => ShowTooltip(args, "Save"))" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(tag))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(tag))" MouseEnter="@(args => ShowTooltip(args, "Delete"))" Visible="@(entityToInsert == null)" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <br />
</div>