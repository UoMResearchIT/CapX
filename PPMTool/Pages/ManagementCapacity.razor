@page "/managementcapacity"
@inherits BaseCapacityPage
@using PPMTool.Pages.Components
@using PPMTool.Data
<PageTitle>Management Capacity - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col">
            <h1>Management Capacity</h1>
        </div>
    </div>
    <hr />
    @if (Loading)
    {
        <LoadingComponent />
    }
    else
    {
        <div class="card">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                <RadzenDropDown @bind-Value=@chosenPeople
                                Data=@filteredPeople
                                TextProperty="Name"
                                ValueProperty="Name"
                                Multiple=true
                                AllowClear=true
                                Placeholder="Filter Manager"
                                Chips=true
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                FilterOperator="StringFilterOperator.Contains"
                                AllowFiltering="true"
                                Style="width: 100%; max-width: 400px;"
                                Change="@(async args => await PeopleSelectionChangedAsync(args))"
                                LoadData="@LoadFilteredPeople"
                                Disabled="@Loading" />
                <CapacityChartControlComponent FinishedSwitchChanged="@(async value => await FinishedSwitchChangedAsync(value))"
                                               LeaversSwitchChanged="@(async value => await LeaversSwitchChangedAsync(value))"
                                               UnFundedSwitchChanged="@(async value => await UnFundedSwitchChangedAsync(value))"
                                               SetZoomToMonthsAhead="@SetZoomToMonthsAhead"
                                               SessionStorageTag="@GetSessionStorageTag()"
                                               @ref=controlComponent />
            </RadzenStack>
        </div>

        @if (chartModels == null || chartModels.Count == 0)
        {
            <div class="card">
                <p class="lead">No data to show for the selected managers</p>
            </div>
        }
        else
        {
            <!-- Legend -->
            <CapacityLegendComponent ShowProjectModeLegend="false" />

            <!-- Chart -->
            <div class="row">
                @for (int i = 0; i < chartModels.Count; ++i)
                {
                    <div class="col" style="min-width: 50rem;">
                        <div class="card my-1">
                            <CapacityChartComponent ChartModel=@chartModels[i]
                                                    OnDataPointSelection="@(async item => await DataPointsSelectedAsync(item))"
                                                    OnChartZoomed="@OnChartZoomed" />
                        </div>
                    </div>
                }
            </div>
        }
        <hr />
    }
</div>
