@page "/managecodes"
@inherits DataGridPage<InnateCode>
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>Manage Innate Codes</h1>
        </div>
        <div class="col-auto">
            <RadzenButton class="float-right" Text="Add" Icon="add" Click="@InsertRow" Disabled=@(entityToInsert != null) />
        </div>
    </div>
    @if (statusMessage != null)
    {
        <StatusMessageComponent Message="statusMessage" />
    }
    <hr />
    <RadzenDataGrid @ref="dataGrid"
                    AllowFiltering="true"
                    AllowPaging="true"
                    PageSize="15"
                    AllowSorting="true"
                    ShowPagingSummary="true"
                    EditMode="DataGridEditMode.Single"
                    FilterMode="FilterMode.Simple"
                    Data="@dataGridEntities"
                    TItem="InnateCode"
                    RowUpdate="@OnUpdateRow"
                    RowCreate="@OnCreateRow"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
        <Columns>
            <RadzenDataGridColumn TItem="InnateCode" Property="ActivityCode" Title="Activity Code" Width="250px" MinWidth="10px">
                <EditTemplate Context="code">
                    <RadzenTextBox @bind-Value="code.ActivityCode" Style="width:100%; display: block;"/>
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="InnateCode" Property="ActivityName" Title="Activity Name" Width="350px" MinWidth="10px">
                <EditTemplate Context="code">
                    <RadzenTextBox @bind-Value="code.ActivityName" Style="width:100%; display: block;" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="InnateCode" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="120px" MinWidth="10px" Title="Actions">
                <Template Context="code">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(code))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(code))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" />
                </Template>
                <EditTemplate Context="code">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(code))" MouseEnter="@(args => ShowTooltip(args, "Save"))" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(code))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(code))" MouseEnter="@(args => ShowTooltip(args, "Delete"))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</div>