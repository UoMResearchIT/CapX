@page "/capacity"
@inherits BasePage

@using PPMTool.Data

<div class="container" style="max-width: none; width: 80%">
    @if (IsLoading)
    {
        <div class="spinner"></div>
    }
    else
    {
        <h1>Capacity</h1>
        <div class="card">
            <div class="row">
                <div class="col-auto">
                    Choose RSE:
                </div>
                <div class="col-auto mr-auto">
                    <EditForm Model="this">
                        <InputSelect @bind-Value="ChosenPerson">
                            <option value="All">All</option>
                            @foreach (var c in nameOptions)
                            {
                            <option value="@c">@c</option>
                            }
                    </InputSelect>
                </EditForm>
            </div>
            <div class="col-auto">
                Include Unfunded:
            </div>
            <div class="col" style="display: flex">
                <RadzenSwitch @bind-Value="@IncludeUnFunded" />
            </div>
            <div class="col-auto">
                @tooltipText
            </div>
        </div>
    </div>
        <div class="card">
            @if (teamCapacityProfiles == null)
            {
                <p class="lead">No data to show</p>
            }
            else
            {
                <ApexChart @ref="chart"
                   TItem="CapacityItem"
                   Title="@chartTitle"
                   Options=options
                   XAxisType="XAxisType.Datetime"
                   OnDataPointEnter="@OnDataPointHover"
                   OnDataPointLeave="@OnDataPointHoverLeave">
                    <ChildContent>
                        <ApexRangeSeries TItem="CapacityItem"
                                 Items="chartSource"
                                 XValue="@(e => e.ProjectName == null ? e.PersonName : e.ProjectName)"
                                 YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                 YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                                 PointColor="@(e => e.GetColourString())" />
                    </ChildContent>
                </ApexChart>

            }
        </div>
    }
</div>