@page "/capacity"
@inherits BasePage

@using PPMTool.Data

<div class="container">
    @if (IsLoading)
    {
        <div class="spinner"></div>
    }
    else
    {
        <h1>Capacity</h1>
        <div class="card">
            <EditForm Model="this">
                <div class="row">
                    <div class="col-auto">
                        Who is available?
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryStartDate" DateFormat="d" />
                    </div>
                    <div class="col-auto">
                        to
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryEndDate" DateFormat="d" />
                    </div>
                    <div class="col-auto">
                        Include Unfunded:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <button type="submit" class="btn btn-primary" @onclick=@RunQuery> <i class="oi oi-check" /></button>
                    </div>
                </div>
            </EditForm>
            <hr />
            <h3>Query Results</h3>
            @if (QueryResults != null)
            {
                @foreach (var p in QueryResults)
                {
                    <div class="row">
                        <div class="col-lg-2">@p.Name</div>
                        <div class="col">@string.Join(",", p.SkillTags.Select(x => x.Name.ToString()))</div>
                    </div>
                }
            }
            else
            {
                <p>No results to show</p>
            }
        </div>
        <hr />
        <h2>Charts</h2>
        <div class="card">
            <div class="row">
                <div class="col-auto">
                    Choose RSE:
                </div>
                <div class="col-auto mr-auto">
                    <EditForm Model="this">
                        <InputSelect @bind-Value="ChosenPerson">
                            <option value="All">All</option>
                            @foreach (var c in nameOptions)
                            {
                            <option value="@c">@c</option>
                            }
                        </InputSelect>
                    </EditForm>
                </div>
                <div class="col-auto">
                    Include Unfunded:
                </div>
                <div class="col" style="display: flex">
                    <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                </div>
                <div class="col-auto">
                    @tooltipText
                </div>
            </div>
        </div>
        <div class="card">
            @if (chartSource == null || chartSource.Count < 1)
            {
                <p class="lead">No data to show</p>
            }
            else
            {
                <div class="row">
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#e3001b"></rect> </svg> &gt;100%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#00783c"></rect> </svg> =100%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#fc9803"></rect> </svg> &gt;50%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#ffd500"></rect> </svg> &le;50%</div>
                </div>
                <ApexChart @ref="chart"
                   TItem="ChartItem"
                   Options=options
                   XAxisType="XAxisType.Datetime"
                   OnDataPointEnter="@OnDataPointHover"
                   OnDataPointLeave="@OnDataPointHoverLeave">
                    <ChildContent>
                        <ApexRangeSeries TItem="ChartItem"
                                 Items="chartSource"
                                 XValue="@(e => e.Label)"
                                 YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                 YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                                 PointColor="@(e => e.GetColourStringFTE())" />
                    </ChildContent>
                </ApexChart>

            }
        </div>
    }
</div>
