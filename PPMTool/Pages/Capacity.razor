@page "/capacity"
@inherits BasePage

@using PPMTool.Data

<div class="container">
    @if (isLoading)
    {
        <div class="spinner"></div>
    }
    else
    {
        <div class="row">
            <div class="col">
                <h1>Capacity</h1>
            </div>
            <div class="col-auto" style="align-content: center">
                <button class="btn btn-primary" type="button" @onclick="ExportCapacityData"><i class="oi oi-data-transfer-download" /> Export</button>
            </div>
        </div>
        <div class="card">
            <EditForm Model="this">
                <div class="row align-items-center">
                    <div class="col-auto">
                        Who is available?
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryStartDate" DateFormat="d" />
                    </div>
                    <div class="col-auto">
                        to
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="queryEndDate" DateFormat="d" />
                    </div>
                    <div class="col-auto">
                        <div class="row align-items-center p-1">
                            <div class="col">
                                Include Unfunded:
                            </div>
                            <div class="col-auto" style="display: flex">
                                <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                            </div>
                        </div>
                        <div class="row align-items-center p-1">
                            <div class="col">
                                Include Leavers:
                            </div>
                            <div class="col-auto" style="display: flex">
                                <RadzenSwitch @bind-Value="@IncludeLeavers" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary" @onclick=@RunQueryAsync> <i class="oi oi-check" /> Run</button>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-danger" @onclick=@ClearQueryAsync> <i class="oi oi-x" /> Clear</button>
                    </div>
                </div>
            </EditForm>
            <hr />
            <h3>Query Results</h3>
            @if (!string.IsNullOrEmpty(queryErrorMessage))
            {
                <p class="text-danger">@queryErrorMessage</p>
            }
            @if (queryResults != null)
            {
                <table class="table table-sm table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Skills</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Availability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in queryResults)
                        {
                            <tr>
                                <td>@res.Person.Name</td>
                                <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                <td>@res.StartDate.ToShortDateString()</td>
                                <td>@res.EndDate.ToShortDateString()</td>
                                <td>@(res.AvailabilityPercent)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No results to show</p>
            }
        </div>
        <hr />
        <h2>Charts</h2>
        <div class="card">
            <div class="row align-items-center">
                <div class="col-auto">
                    Choose RSE:
                </div>
                <div class="col-auto mr-auto">
                    <EditForm Model="this">
                        <InputSelect @bind-Value="ChosenPerson">
                            <option value="All">All</option>
                            @foreach (var c in nameOptions)
                            {
                                <option value="@c">@c</option>
                            }
                        </InputSelect>
                    </EditForm>
                </div>
                <div class="col-auto">
                    Include Unfunded:
                </div>
                <div class="col" style="display: flex">
                    <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                </div>
                <div class="col-auto">
                    Include Leavers:
                </div>
                <div class="col" style="display: flex">
                    <RadzenSwitch @bind-Value="@IncludeLeavers" />
                </div>
            </div>
        </div>
        <div class="card">
            @if (chartSource == null || chartSource.Count < 1)
            {
                <p class="lead">No data to show</p>
            }
            else
            {
                <!-- Legend -->
                <div class="row">
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(49)"></rect> </svg> &lt;50%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(74)"></rect> </svg> &lt;75%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(99)"></rect> </svg> &lt;100%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(100)"></rect> </svg> =100%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(101)"></rect> </svg> &gt;100%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(126)"></rect> </svg> &gt;125%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(151)"></rect> </svg> &gt;150%</div>
                </div>

                <!-- Chart -->
                <ApexChart @ref="chart"
                   TItem="ChartItem"
                   Options=options
                   XAxisType="XAxisType.Datetime"
                   OnDataPointSelection=DataPointsSelected>
                    <ChildContent>
                        <ApexRangeSeries TItem="ChartItem"
                                 Items="chartSource"
                                 XValue="@(e => e.Label)"
                                 YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                 YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                                 PointColor="@(e => e.Colour)" />
                    </ChildContent>
                    <ApexPointTooltip>
                        <div class="m-2">
                            @{
                                var point = (ListPoint<ChartItem>)context.DataPoint;
                                <div class="m-0 p-3 @(point.Items.FirstOrDefault()?.IsHatched ?? false ? "bg-warning" : "bg-transparent")">
                                    <h3>@point.Items.FirstOrDefault()?.Value1% @(point.Items.FirstOrDefault()?.IsHatched ?? false ? "(Provisional)" : "")</h3>
                                    <span class="me-1">@DateTimeOffset.FromUnixTimeMilliseconds(Convert.ToInt64(point.Y?.Min())).ToString("dd MMM yyy") - </span>
                                    <span class="me-1">@DateTimeOffset.FromUnixTimeMilliseconds(Convert.ToInt64(point.Y?.Max())).ToString("dd MMM yyy")</span>
                                </div>
                            }
                        </div>
                    </ApexPointTooltip>
                </ApexChart>

            }
        </div>
    }
</div>
