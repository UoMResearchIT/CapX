@page "/capacity"
@inherits BasePage

@using PPMTool.Data

<div class="container">
    <div class="row">
        <div class="col">
            <h1>Capacity</h1>
        </div>
        <div class="col-auto" style="align-content: center">
            <RadzenButton ButtonType="ButtonType.Button" Click="ExportCapacityData" Text="Export" Icon="download" Disabled=!EditAuthorised />
        </div>
    </div>
    @if (EditAuthorised)
    {
        <div class="card">
            <EditForm Model="this">
                <div class="row align-items-center">
                    <div class="col-auto">
                        Who is available?
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryStartDate" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col-auto">
                        to
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="queryEndDate" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col-auto">
                        at
                    </div>
                    <div class="col-auto">
                        <RadzenNumeric TValue="double" Min="0" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="requiredFTE" />
                    </div>
                    <div class="col-auto">
                        FTE
                    </div>
                </div>
                <div class="row align-items-center p-1">
                    <div class="col-auto">
                        Include Unfunded:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                    </div>
                    <div class="col-auto">
                        Include Leavers:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeLeavers" />
                    </div>
                    <div class="col-auto">
                        <RadzenButton ButtonType="ButtonType.Submit" Click=@RunQueryAsync Text="Run" Icon="directions_run"/>
                    </div>
                    <div class="col-auto">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Click=@ClearQueryAsync Text="Clear" Icon="close"/>
                    </div>
                </div>
            </EditForm>
            <hr />
            <h3>Query Results</h3>
            @if (!string.IsNullOrEmpty(queryErrorMessage))
            {
                <p class="text-danger">@queryErrorMessage</p>
            }
            @if (queryResultsAvailable)
            {
                @if (fullMatch.Count > 0)
                {
                    <b>Full Match</b>
                    <table class="table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Skills</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in fullMatch)
                            {
                                <tr>
                                    <td>@res.Person.Name</td>
                                    <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                    <td>@res.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@res.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(res.AvailabilityPercent) FTE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (partialMatchPercent.Count > 0)
                {
                    <b>Partial Match (FTE)</b>
                    <table class="table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Skills</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in partialMatchPercent)
                            {
                                <tr>
                                    <td>@res.Person.Name</td>
                                    <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                    <td>@res.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@res.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(res.AvailabilityPercent) FTE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (partialMatchDuration.Count > 0)
                {
                    <b>Partial Match (Duration)</b>
                    <table class="table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Skills</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in partialMatchDuration)
                            {
                                <tr>
                                    <td>@res.Person.Name</td>
                                    <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                    <td>@res.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@res.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(res.AvailabilityPercent) FTE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (partialMatchBoth.Count > 0)
                {
                    <b>Partial Match (FTE and Duration)</b>
                    <table class="table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Skills</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in partialMatchBoth)
                            {
                                <tr>
                                    <td>@res.Person.Name</td>
                                    <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                    <td>@res.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@res.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(res.AvailabilityPercent) FTE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else
            {
                <p>No results to show</p>
            }
        </div>
    }
    <hr />
    <h2>Charts</h2>
    <div class="card">
        <div class="row align-items-center">
            <div class="col-auto mr-auto">
                <RadzenDropDown @bind-Value=@chosenPeople Data=@people TextProperty="Name" ValueProperty="Name"
                                Multiple=true AllowClear=true Placeholder="Filter RSE" Chips=true
                                Style="width: 100%; max-width: 400px;" Change="@(args => PeopleSelectionChanged(args))" Disabled=!EditAuthorised />
            </div>
            <div class="col-auto mr-auto">
                <RadzenDropDown @bind-Value=@chosenManager Data=@managers TextProperty="Name"
                                Multiple=false AllowClear=true Placeholder="Filter Manager" Chips=true
                                Style="width: 100%; max-width: 400px;" Change="@(args => ManagerSelectionChanged(args))" Disabled=!EditAuthorised />
            </div>
            <div class="col-auto">
                Include Unfunded:
            </div>
            <div class="col-auto" style="display: flex">
                <RadzenSwitch @bind-Value="@IncludeUnFunded" />
            </div>
            <div class="col-auto">
                Include Leavers:
            </div>
            <div class="col" style="display: flex">
                <RadzenSwitch @bind-Value="@IncludeLeavers" />
            </div>
        </div>
    </div>
    <div class="card">
        @if (chartSource == null || chartSource.Count < 1)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <!-- Legend -->
            <div class="row">
                <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(49)"></rect> </svg> &lt;50%</div>
                <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(74)"></rect> </svg> &lt;75%</div>
                <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(99)"></rect> </svg> &lt;100%</div>
                <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(100)"></rect> </svg> =100%</div>
                <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(101)"></rect> </svg> &gt;100%</div>
                <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(126)"></rect> </svg> &gt;125%</div>
                <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="@ChartItem.GetColourStringPercentage(151)"></rect> </svg> &gt;150%</div>
            </div>

            <!-- Chart -->
            <ApexChart @ref="chart"
                        TItem="ChartItem"
                        Options=options
                        XAxisType="XAxisType.Datetime"
                        OnDataPointSelection=DataPointsSelected>
                <ChildContent>
                    <ApexRangeSeries TItem="ChartItem"
                                        Items="chartSource"
                                        XValue="@(e => e.Label)"
                                        YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                        YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                                        PointColor="@(e => e.Colour)" />
                </ChildContent>
                <ApexPointTooltip>
                    <div class="m-2">
                        @{
                            var point = (ListPoint<ChartItem>)context.DataPoint;
                            <div class="m-0 p-3 @(point.Items.FirstOrDefault()?.IsHatched ?? false ? "bg-warning" : "bg-transparent")">
                                <h3>@point.Items.FirstOrDefault()?.Value1 FTE @(point.Items.FirstOrDefault()?.IsHatched ?? false ? "(Provisional)" : "")</h3>
                                <span class="me-1">@DateTimeOffset.FromUnixTimeMilliseconds(Convert.ToInt64(point.Y?.Min())).ToString("dd MMM yyy") - </span>
                                <span class="me-1">@DateTimeOffset.FromUnixTimeMilliseconds(Convert.ToInt64(point.Y?.Max())).ToString("dd MMM yyy")</span>
                            </div>
                        }
                    </div>
                </ApexPointTooltip>
            </ApexChart>

        }
    </div>
</div>
