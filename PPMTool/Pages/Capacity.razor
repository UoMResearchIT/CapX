@page "/capacity"
@inherits BasePage

@using PPMTool.Pages.Components
@using PPMTool.Data

@{
    bool ReadAuthorised = EditAuthorised || IsReader;
}

<div class="container">
    <div class="row">
        <div class="col">
            <h1>Capacity</h1>
        </div>
        <div class="col-auto" style="align-content: center">
            <RadzenButton ButtonType="ButtonType.Button" Click="ExportCapacityData" Text="Export" Icon="download" Disabled=!ReadAuthorised />
        </div>
    </div>
    <hr />
    <h2>Charts</h2>
    <div class="card">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenDropDown @bind-Value=@chosenPeople Data=@filteredPeople TextProperty="Name" ValueProperty="Name"
                            Multiple=true AllowClear=true Placeholder="Filter RSE" Chips=true
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                            Style="width: 100%; max-width: 400px;" Change="@(args => PeopleSelectionChanged(args))"
                            LoadData="@LoadFilteredPeople" Disabled=@(!ReadAuthorised || Loading) />
            <RadzenDropDown @bind-Value=@chosenManager Data=@filteredManagers TextProperty="Name"
                            Multiple=false AllowClear=true Placeholder="Filter Manager" Chips=true
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                            Style="width: 100%; max-width: 400px;" Change="@(args => ManagerSelectionChanged(args))"
                            LoadData="@LoadFilteredManagers" Disabled=@(!ReadAuthorised || Loading) />
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem">
                Include Unfunded:
                <RadzenSwitch @bind-Value="@IncludeUnFunded" Disabled="@Loading" />
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem">
                Include Leavers:
                <RadzenSwitch @bind-Value="@IncludeLeavers" Disabled="@Loading" />
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem">
                Include Finished:
                <RadzenSwitch @bind-Value="@IncludeFinished" Disabled="@Loading" />
            </RadzenStack>
        </RadzenStack>
    </div>
    
    @if (Loading)
    {
        <LoadingComponent />
    }
    else if (confirmedChartItems == null || confirmedChartItems.Count < 1)
    {
        <div class="card">
            <p class="lead">No data to show for the selected people.</p>
        </div>
    }
    else if (chosenManager != null && (chosenPeople == null || chosenPeople.Count() == 0))
    {
        <div class="card">
            <p class="lead">Select one or more RSEs to view capacity information for projects owned by this project manager.</p>
        </div>
    }
    else
    {
        <!-- Legend -->
        <div class="card">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Start" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.SpaceBetween" Gap="1.5rem">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center" Gap="0.4rem">
                    <RadzenText Text="Capacity:" TextStyle="TextStyle.Subtitle1" class="center-text" />
                    <RadzenStack Gap="0.2rem" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(49)" /></svg>
                        <RadzenText Text="&lt;50%" class="center-text" />
                    </RadzenStack>
                    <RadzenStack Gap="0.2rem" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(74)" /></svg>
                        <RadzenText Text="&lt;75%" class="center-text" />
                    </RadzenStack>
                    <RadzenStack Gap="0.2rem" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(99)" /></svg>
                        <RadzenText Text="&lt;100%" class="center-text" />
                    </RadzenStack>
                    <RadzenStack Gap="0.2rem" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(100)" /></svg>
                        <RadzenText Text="=100%" class="center-text" />
                    </RadzenStack>
                    <RadzenStack Gap="0.2rem" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(101)" /></svg>
                        <RadzenText Text="&gt;100%" class="center-text" />
                    </RadzenStack>
                    <RadzenStack Gap="0.2rem" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(126)" /></svg>
                        <RadzenText Text="&gt;125%" class="center-text" />
                    </RadzenStack>
                    <RadzenStack Gap="0.2rem" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(151)" /></svg>
                        <RadzenText Text="&gt;150%" class="center-text" />
                    </RadzenStack>
                </RadzenStack>
                @if (ChosenPeople != null && ChosenPeople.Count() > 0)
                {
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center" Gap="0.4rem">
                        <RadzenText Text="Assignments:" TextStyle="TextStyle.Subtitle1" class="center-text" />
                        <RadzenStack Gap="0.2rem" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                            <RadzenText Text="0 FTE" class="center-text" />
                            <svg width=200 height=20 xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <linearGradient id="Gradient1">
                                        <stop offset="0%" stop-color="@ChartItem.GetColourStringPercentage(0, true)" />
                                        <stop offset="100%" stop-color="@ChartItem.GetColourStringPercentage(100, true)" />
                                    </linearGradient>
                                </defs>
                                <rect width="200" height="20" rx="15" fill="url(#Gradient1)" />
                            </svg>
                            <RadzenText Text="1.0 FTE" class="center-text" />
                        </RadzenStack>
                    </RadzenStack>
                }
            </RadzenStack>
        </div>

        <!-- Chart -->
        <div class="card">
        <div class="row">
            @for (int i = 0; i < chartTitles.Count; ++i)
            {
                <div class="@(chartTitles.Count == 1 ? "col" : "col-6")">
                        <CapacityChartComponent Title=@chartTitles[i]
                                                ChartOptions="@chartOptions[i]"
                                                ConfirmedChartItems="@confirmedChartItems[i]"
                                                ProvisionalChartItems="@provisionalChartItems[i]"
                                                OnDataPointSelection="@DataPointsSelected"
                                                OnChartZoomed="@OnChartZoomed" />
                </div>
            }
        </div>
        </div>
    }
    <hr />

    @if (ReadAuthorised)
    {
        <h2>Availability Query</h2>
        <div class="card">
            <EditForm Model="this">
                <div class="row align-items-center">
                    <div class="col-auto">
                        Who is available?
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryStartDate" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col-auto">
                        to
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="queryEndDate" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col-auto">
                        at
                    </div>
                    <div class="col-auto">
                        <RadzenNumeric TValue="double" Min="0" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="requiredFTE" />
                    </div>
                    <div class="col-auto">
                        FTE
                    </div>
                </div>
                <div class="row align-items-center p-1">
                    <div class="col-auto">
                        Include Unfunded:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                    </div>
                    <div class="col-auto">
                        Include Leavers:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeLeavers" />
                    </div>
                    <div class="col-auto">
                        <RadzenButton ButtonType="ButtonType.Submit" Click=@RunQuery Text="Run" Icon="directions_run" Disabled="@Loading" />
                    </div>
                    <div class="col-auto">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Click=@(() => ClearQuery(true)) Text="Clear" Icon="close" Disabled="@Loading" />
                    </div>
                </div>
            </EditForm>
            <hr />
            <h3>Query Results</h3>
            @if (!string.IsNullOrEmpty(queryErrorMessage))
            {
                <p class="text-danger">@queryErrorMessage</p>
            }
            @if (queryResultsAvailable)
            {
                @if (fullMatch.Count > 0)
                {
                    <b>Full Match</b>
                    <CapacityQueryTableComponent Results="fullMatch" />
                }

                @if (partialMatchPercent.Count > 0)
                {
                    <b>Partial Match (FTE)</b>
                    <CapacityQueryTableComponent Results="partialMatchPercent" />
                }

                @if (partialMatchDuration.Count > 0)
                {
                    <b>Partial Match (Duration)</b>
                    <CapacityQueryTableComponent Results="partialMatchDuration" />
                }

                @if (partialMatchBoth.Count > 0)
                {
                    <b>Partial Match (FTE and Duration)</b>
                    <CapacityQueryTableComponent Results="partialMatchBoth" />
                }
            }
            else
            {
                <p>No results to show</p>
            }
        </div>
    }
    <hr />
</div>
