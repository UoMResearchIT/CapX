@page "/capacity"
@inherits BaseCapacityPage
@using PPMTool.Pages.Components
@using PPMTool.Data
<PageTitle>Capacity - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col">
            <h1>Capacity</h1>
        </div>
    </div>
    <hr />
    <h2>Charts</h2>
    <div class="card">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenDropDown @bind-Value=@ChosenPeople
                            Data=@filteredPeople
                            TextProperty="Name"
                            ValueProperty="Name"
                            Multiple=true
                            AllowClear=true
                            Placeholder="Filter RSE"
                            Chips=true
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="StringFilterOperator.Contains"
                            AllowFiltering="true"
                            Style="width: 100%; max-width: 400px;"
                            Change="@(args => PeopleSelectionChanged(args))"
                            LoadData="@LoadFilteredPeople"
                            Disabled=@(!ReadOrEditAuthorised || Loading) />
            @if (HasStaffInList())
            {
                <RadzenButton Text="My Staff" Click="FilterToMyStaff" />
            }
            <RadzenDropDown @bind-Value=@chosenManager
                            Data=@filteredManagers
                            TextProperty="Name"
                            Multiple=false
                            AllowClear=true
                            Placeholder="Filter Project Manager"
                            Chips=true
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="StringFilterOperator.Contains"
                            AllowFiltering="true"
                            Style="width: 100%; max-width: 400px;"
                            Change="@(args => ManagerSelectionChanged(args))"
                            LoadData="@LoadFilteredManagers"
                            Disabled=@(!ReadOrEditAuthorised || Loading) />
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem">
                Include Unfunded:
                <RadzenSwitch @bind-Value="@IncludeUnFunded" Disabled="@Loading" />
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem">
                Include Leavers:
                <RadzenSwitch @bind-Value="@IncludeLeavers" Disabled="@Loading" />
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem">
                Include Finished:
                <RadzenSwitch @bind-Value="@IncludeFinished" Disabled="@Loading" />
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem">
                <RadzenButton Text="3 Months" Click="@(() => SetZoomToMonthsAhead(3))" />
                <RadzenButton Text="6 Months" Click="@(() => SetZoomToMonthsAhead(6))" />
                <RadzenButton Text="9 Months" Click="@(() => SetZoomToMonthsAhead(9))" />
                <RadzenButton Text="12 Months" Click="@(() => SetZoomToMonthsAhead(12))" />
            </RadzenStack>
        </RadzenStack>
    </div>

    @if (Loading)
    {
        <LoadingComponent />
    }
    else if (chartModels == null || chartModels.Count < 1)
    {
        <div class="card">
            <p class="lead">No data to show for the selected people</p>
        </div>
    }
    else
    {
        <!-- Legend -->
        <CapacityLegendComponent ShowProjectModeLegend="@(ChosenPeople != null && ChosenPeople.Count() > 0)" />

        <!-- Chart -->
        <div class="row">
            @for (int i = 0; i < chartModels.Count; ++i)
            {
                <div class="col" style="min-width: 50rem;">
                    <div class="card my-1">
                        <CapacityChartComponent ChartModel=@chartModels[i]
                                                OnDataPointSelection="@DataPointsSelected"
                                                OnChartZoomed="@OnChartZoomed" />
                    </div>
                </div>
            }
        </div>
    }
    <hr />

    @if (ReadOrEditAuthorised)
    {
        <h2>Availability Query</h2>
        <div class="card">
            <EditForm Model="this">
                <div class="row align-items-center p-1">
                    <div class="col-auto">
                        Who is available?
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryStartDate" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col-auto">
                        to
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="queryEndDate" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col-auto">
                        at
                    </div>
                    <div class="col-auto">
                        <RadzenNumeric TValue="double" Min="0" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="requiredFTE" />
                    </div>
                    <div class="col-auto">
                        FTE
                    </div>
                </div>
                <div class="row align-items-center p-1">
                    <div class="col-auto">
                        Include Unfunded:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                    </div>
                    <div class="col-auto">
                        Include Leavers:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeLeavers" />
                    </div>
                    <div class="col-auto">
                        <RadzenButton ButtonType="ButtonType.Submit" Click=@RunQuery Text="Run" Icon="directions_run" Disabled="@Loading" />
                    </div>
                    <div class="col-auto">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Click=@(() => ClearQuery(true)) Text="Clear" Icon="close" Disabled="@Loading" />
                    </div>
                </div>
            </EditForm>
            <hr />
            <h3>Query Results</h3>
            @if (!string.IsNullOrEmpty(queryErrorMessage))
            {
                <p class="text-danger">@queryErrorMessage</p>
            }
            @if (queryResultsAvailable)
            {
                @if (fullMatch.Count > 0)
                {
                    <b>Full Match</b>
                    <CapacityQueryTableComponent Results="fullMatch" />
                }

                @if (partialMatchPercent.Count > 0)
                {
                    <b>Partial Match (FTE)</b>
                    <CapacityQueryTableComponent Results="partialMatchPercent" />
                }

                @if (partialMatchDuration.Count > 0)
                {
                    <b>Partial Match (Duration)</b>
                    <CapacityQueryTableComponent Results="partialMatchDuration" />
                }

                @if (partialMatchBoth.Count > 0)
                {
                    <b>Partial Match (FTE and Duration)</b>
                    <CapacityQueryTableComponent Results="partialMatchBoth" />
                }
            }
            else
            {
                <p>No results to show</p>
            }
        </div>
    }
    <hr />
</div>
