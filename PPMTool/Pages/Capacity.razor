@page "/capacity"
@inherits BasePage
@using PPMTool.Pages.Components

@using PPMTool.Data

<div class="container">
    <div class="row">
        <div class="col">
            <h1>Capacity</h1>
        </div>
        <div class="col-auto" style="align-content: center">
            <RadzenButton ButtonType="ButtonType.Button" Click="ExportCapacityData" Text="Export" Icon="download" Disabled=!EditAuthorised />
        </div>
    </div>
    <hr />

    <h2>Charts</h2>
    <div class="card">
        <div class="row align-items-center">
            <div class="col-auto mr-auto">
                <RadzenDropDown @bind-Value=@chosenPeople Data=@filteredPeople TextProperty="Name" ValueProperty="Name"
                                Multiple=true AllowClear=true Placeholder="Filter RSE" Chips=true
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                                Style="width: 100%; max-width: 400px;" Change="@(args => PeopleSelectionChanged(args))"
                                LoadData="@LoadFilteredPeople" Disabled=@(!EditAuthorised || Loading) />
            </div>
            <div class="col-auto mr-auto">
                <RadzenDropDown @bind-Value=@chosenManager Data=@filteredManagers TextProperty="Name"
                                Multiple=false AllowClear=true Placeholder="Filter Manager" Chips=true
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true"
                                Style="width: 100%; max-width: 400px;" Change="@(args => ManagerSelectionChanged(args))"
                                LoadData="@LoadFilteredManagers" Disabled=@(!EditAuthorised || Loading) />
            </div>
            <div class="col-auto">
                Include Unfunded:
            </div>
            <div class="col-auto" style="display: flex">
                <RadzenSwitch @bind-Value="@IncludeUnFunded" Disabled="@Loading" />
            </div>
            <div class="col-auto">
                Include Leavers:
            </div>
            <div class="col" style="display: flex">
                <RadzenSwitch @bind-Value="@IncludeLeavers" Disabled="@Loading" />
            </div>
        </div>
    </div>
    
    @if (Loading)
    {
        <LoadingComponent />
    }
    else if (confirmedChartItems == null || confirmedChartItems.Count < 1)
    {
        <div class="card">
            <p class="lead">No data to show for the selected people.</p>
        </div>
    }
    else if (chosenManager != null && (chosenPeople == null || chosenPeople.Count() == 0))
    {
        <div class="card">
            <p class="lead">Select one or more RSEs to view capacity information for projects owned by this project manager.</p>
        </div>
    }
    else
    {
        <!-- Legend -->
            
        <div class="card">
            <div class="row">
                <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(49)" /></svg> &lt;50%</div>
                <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(74)" /></svg> &lt;75%</div>
                <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(99)" /></svg> &lt;100%</div>
                <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(100)" /></svg> =100%</div>
                <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(101)" /></svg> &gt;100%</div>
                <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(126)" /></svg> &gt;125%</div>
                <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(151)" /></svg> &gt;150%</div>
            </div>
        </div>

        <!-- Chart -->
        <div class="card">
        <div class="row">
            @for (int i = 0; i < chartTitles.Count; ++i)
            {
                <div class="@(chartTitles.Count == 1 ? "col" :"col-6")">
                        <CapacityChartComponent Title=@chartTitles[i]
                                                ChartOptions="@chartOptions[i]"
                                                ConfirmedChartItems="@confirmedChartItems[i]"
                                                ProvisionalChartItems="@provisionalChartItems[i]"
                                                OnDataPointSelection="@DataPointsSelected"
                                                OnChartZoomed="@OnChartZoomed" />
                </div>
            }
        </div>
        </div>
    }
    <hr />

    @if (EditAuthorised)
    {
        <h2>Availability Query</h2>
        <div class="card">
            <EditForm Model="this">
                <div class="row align-items-center">
                    <div class="col-auto">
                        Who is available?
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryStartDate" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col-auto">
                        to
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="queryEndDate" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col-auto">
                        at
                    </div>
                    <div class="col-auto">
                        <RadzenNumeric TValue="double" Min="0" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="requiredFTE" />
                    </div>
                    <div class="col-auto">
                        FTE
                    </div>
                </div>
                <div class="row align-items-center p-1">
                    <div class="col-auto">
                        Include Unfunded:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                    </div>
                    <div class="col-auto">
                        Include Leavers:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeLeavers" />
                    </div>
                    <div class="col-auto">
                        <RadzenButton ButtonType="ButtonType.Submit" Click=@RunQuery Text="Run" Icon="directions_run" Disabled="@Loading" />
                    </div>
                    <div class="col-auto">
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Click=@(() => ClearQuery(true)) Text="Clear" Icon="close" Disabled="@Loading" />
                    </div>
                </div>
            </EditForm>
            <hr />
            <h3>Query Results</h3>
            @if (!string.IsNullOrEmpty(queryErrorMessage))
            {
                <p class="text-danger">@queryErrorMessage</p>
            }
            @if (queryResultsAvailable)
            {
                @if (fullMatch.Count > 0)
                {
                    <b>Full Match</b>
                    <table class="table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Skills</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in fullMatch)
                            {
                                <tr>
                                    <td>@res.Person.Name</td>
                                    <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                    <td>@res.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@res.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(res.AvailabilityPercent) FTE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (partialMatchPercent.Count > 0)
                {
                    <b>Partial Match (FTE)</b>
                    <table class="table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Skills</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in partialMatchPercent)
                            {
                                <tr>
                                    <td>@res.Person.Name</td>
                                    <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                    <td>@res.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@res.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(res.AvailabilityPercent) FTE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (partialMatchDuration.Count > 0)
                {
                    <b>Partial Match (Duration)</b>
                    <table class="table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Skills</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in partialMatchDuration)
                            {
                                <tr>
                                    <td>@res.Person.Name</td>
                                    <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                    <td>@res.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@res.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(res.AvailabilityPercent) FTE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (partialMatchBoth.Count > 0)
                {
                    <b>Partial Match (FTE and Duration)</b>
                    <table class="table table-sm table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Skills</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Availability</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in partialMatchBoth)
                            {
                                <tr>
                                    <td>@res.Person.Name</td>
                                    <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                    <td>@res.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@res.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@(res.AvailabilityPercent) FTE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else
            {
                <p>No results to show</p>
            }
        </div>
    }
    <hr />
</div>
