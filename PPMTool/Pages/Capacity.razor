@page "/capacity"
@inherits BasePage

@using PPMTool.Data

<div class="container">
    @if (IsLoading)
    {
        <div class="spinner"></div>
    }
    else
    {
        <h1>Capacity</h1>
        <div class="card">
            <EditForm Model="this">
                <div class="row align-items-center">
                    <div class="col-auto">
                        Who is available?
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryStartDate" DateFormat="d" />
                    </div>
                    <div class="col-auto">
                        to
                    </div>
                    <div class="col-auto">
                        <RadzenDatePicker @bind-Value="QueryEndDate" DateFormat="d" />
                    </div>
                    <div class="col-auto">
                        Include Unfunded:
                    </div>
                    <div class="col-auto" style="display: flex">
                        <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary" @onclick=@RunQueryAsync> <i class="oi oi-check" /></button>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-danger" @onclick=@ClearQueryAsync> <i class="oi oi-x"/></button>
                    </div>
                </div>
            </EditForm>
            <hr />
            <h3>Query Results</h3>
            @if (!string.IsNullOrEmpty(QueryErrorMessage))
            {
                <p class="text-danger">@QueryErrorMessage</p>
            }
            @if (QueryResults != null)
            {
                <table class="table table-sm table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Skills</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Availability</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var res in QueryResults)
                        {
                            <tr>
                                <td>@res.Person.Name</td>
                                <td>@string.Join(",", res.Person.SkillTags.Select(x => x.Name))</td>
                                <td>@res.StartDate.ToShortDateString()</td>
                                <td>@res.EndDate.ToShortDateString()</td>
                                <td>@(res.AvailabilityPercent)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No results to show</p>
            }
        </div>
        <hr />
        <h2>Charts</h2>
        <div class="card">
            <div class="row">
                <div class="col-auto">
                    Choose RSE:
                </div>
                <div class="col-auto mr-auto">
                    <EditForm Model="this">
                        <InputSelect @bind-Value="ChosenPerson">
                            <option value="All">All</option>
                            @foreach (var c in nameOptions)
                            {
                            <option value="@c">@c</option>
                            }
                        </InputSelect>
                    </EditForm>
                </div>
                <div class="col-auto">
                    Include Unfunded:
                </div>
                <div class="col" style="display: flex">
                    <RadzenSwitch @bind-Value="@IncludeUnFunded" />
                </div>
                <div class="col-auto">
                    @tooltipText
                </div>
            </div>
        </div>
        <div class="card">
            @if (chartSource == null || chartSource.Count < 1)
            {
                <p class="lead">No data to show</p>
            }
            else
            {
                <div class="row">
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#e3001b"></rect> </svg> &gt;100%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#00783c"></rect> </svg> =100%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#fc9803"></rect> </svg> &gt;50%</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#ffd500"></rect> </svg> &le;50%</div>
                </div>
                <ApexChart @ref="chart"
                   TItem="ChartItem"
                   Options=options
                   XAxisType="XAxisType.Datetime"
                   OnDataPointEnter="@OnDataPointHover"
                   OnDataPointLeave="@OnDataPointHoverLeave">
                    <ChildContent>
                        <ApexRangeSeries TItem="ChartItem"
                                 Items="chartSource"
                                 XValue="@(e => e.Label)"
                                 YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                 YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                                 PointColor="@(e => e.GetColourStringFTE(e.Value1))" />
                    </ChildContent>
                </ApexChart>

            }
        </div>
    }
</div>
