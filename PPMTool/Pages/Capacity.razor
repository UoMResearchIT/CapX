@page "/capacity"
@inherits BasePage

@using PPMTool.Data

<div class="container">
    @if (IsLoading)
    {
        <div class="spinner"></div>
    }
    else
    {
        <div class="row">
            <div class="col-auto mr-auto">
                <h1>Capacity</h1>
            </div>
        </div>
        <div class="card">
            @if (teamCapacityProfiles == null)
            {
                <p class="lead">No data to show</p>
            }
            else
            {
                <ApexChart TItem="CapacityItem"
                           Title="Load"
                           Options=options
                           XAxisType="XAxisType.Datetime">
                    @foreach (CapacityItem item in chartSource)
                    {
                        <ApexRangeSeries TItem="CapacityItem"
                                         Items="chartSource"
                                         XValue="@(e => e.PersonName)"
                                         YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                         YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                                         Color="@item.GetColourString()"
                                         Name="@item.FTE.ToString("F0")" />
                    }
                </ApexChart>
            }
        </div>
    }
</div>