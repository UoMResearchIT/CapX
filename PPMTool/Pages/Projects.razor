@page "/projects"
@inherits PPMTool.Pages.BaseProjectPage
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using static PPMTool.Enums.Extensions
@using System.ComponentModel.DataAnnotations
<PageTitle>Projects - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>@($"Manage Projects")</h1>
        </div>
        <div class="col-auto">
            <RadzenButton Text="Add" Icon="add" Click="@AddProject" Disabled=!EditAuthorised />
        </div>
    </div>
    <hr />
    @if (Loading)
    {
        <LoadingComponent />
    }
    else if (projects == null)
    {
        <spinner> </spinner>
        <div class="card">
            <p class="lead">No data to show</p>
        </div>
    }
    else
    {
        <div class="card">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenText Text="Include Finished" Style="margin-bottom: 0.1rem" />
                <RadzenSwitch @bind-Value="@IncludeFinished" />
            </RadzenStack>
        </div>
        <div class="card">
            <RadzenDataGrid AllowFiltering="@(projects != null && projects.Count() > 0)"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.Simple"
                            EditMode="DataGridEditMode.Single"
                            AllowSorting="true"
                            PageSize="10"
                            AllowPaging="true"
                            ShowPagingSummary="true"
                            Data="@projects"
                            TItem="Project"
                            ColumnWidth="8rem"
                            SelectionMode="DataGridSelectionMode.Single"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            @bind-Settings="@Settings">
                <Columns>
                    <RadzenDataGridColumn TItem="Project" Property="RTP" Title="RTP" Frozen="true" Width="5rem" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="Name" Title="Name" Frozen="true" Width="16rem" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="PI" Title="PI" Width="14rem" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ProjectManager.Name" Title="PM" Width="14rem" MinWidth="10px">
                        <Template Context="proj">
                            @(proj.ProjectManager?.Name ?? "Not Set")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="ProjectStatus" Title="Project Status" MinWidth="10px">
                        <Template Context="proj">
                            @proj.ProjectStatus.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Faculty" Title="Faculty" MinWidth="10px">
                        <Template Context="proj">
                            @proj.Faculty.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="School" Title="School" MinWidth="10px">
                        <Template Context="proj">
                            @proj.School.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="CostModel" Title="Cost Model" Width="14rem" MinWidth="10px">
                        <Template Context="proj">
                            @(proj.CostModel.GetAttribute<DisplayAttribute>().Name)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="DayRate" Title="Day Rate" Width="8rem" MinWidth="10px">
                        <Template Context="proj">
                            @(proj.CostModel == CostModel.DayRate ? proj.DayRate.ToString("C0") : "N/A")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Budget" Title="Budget" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ActualCost" Title="Actual Cost" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="FundsReceived" Title="Funds Received" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ManagementTaskFTE" Title="Mgmt FTE" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ActualWorkHours" Title="Actual Work" FormatString="{0:F0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="StartDate" Title="Start Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="EndDate" Title="End Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Title="Details" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="6rem" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="proj">
                            <RadzenButton Icon="info" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => NavigateToProjectDetails(proj.ProjectId))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Details"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</div>