@page "/projects"
@page "/"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Enums
@using PPMTool.Data
@using PPMTool.Data.Entities

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>Projects</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick=@AddProject><i class="oi oi-plus" /></button>
        </div>
    </div>
    
        @if (projects == null)
        {
            <div class="card">
            <p class="lead">No data to show</p>
            </div>
        }
        else
        {
            <div class="card">
            <RadzenDataGrid @ref="projectGrid"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.Advanced"
                        EditMode="DataGridEditMode.Single"
                        AllowSorting="true"
                        PageSize="10"
                        AllowPaging="true"
                        ShowPagingSummary="true"
                        Data="@projects"
                        TItem="Project"
                        ColumnWidth="120px"
                        SelectionMode="DataGridSelectionMode.Single"
                        LogicalFilterOperator="LogicalFilterOperator.Or"
                        RowSelect="@(e => ProjectClicked(e.ProjectId))">
                <Columns>
                    <RadzenDataGridColumn TItem="Project" Title="Status" Frozen="true" Filterable="false" Sortable="false" TextAlign="TextAlign.Left" Width="100px">
                        <Template Context="proj">
                            @if (proj.ScheduleStatus == ScheduleStatus.OnSchedule)
                            {
                                <RadzenIcon Icon="verified" IconStyle="IconStyle.Success" title="Project On Schedule" />
                            }
                            else if (proj.ScheduleStatus == ScheduleStatus.Ahead)
                            {
                                <RadzenIcon Icon="warning" IconStyle="IconStyle.Warning" title="Project Ahead" />
                            }
                            else
                            {
                                <RadzenIcon Icon="error" IconStyle="IconStyle.Danger" title="Project Late"/>    
                            }
                            @if (proj.BudgetStatus == BudgetStatus.OnBudget)
                            {
                                <RadzenIcon Icon="verified" IconStyle="IconStyle.Success" title="On Budget" />
                            }
                            else if (proj.BudgetStatus == BudgetStatus.Underspend)
                            {
                                <RadzenIcon Icon="warning" IconStyle="IconStyle.Warning" title="Underspent" />
                            }
                            else
                            {
                                <RadzenIcon Icon="error" IconStyle="IconStyle.Danger" title="Overspent"/>    
                            }
                            @if(proj.FundsReceived < proj.Budget)
                            {
                                <RadzenIcon Icon="error" IconStyle="IconStyle.Danger" title="Funding Shortfall"/>    
                            }
                            else
                            {
                                <RadzenIcon Icon="verified" IconStyle="IconStyle.Success" title="Fully Funded" />    
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Name" Title="Name" Frozen="true" />
                    <RadzenDataGridColumn TItem="Project" Frozen="true" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="60px">
                        <Template Context="proj">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditProject(proj))" @onclick:stopPropagation="true">
                            </RadzenButton>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="PI" Title="PI" />
                    <RadzenDataGridColumn TItem="Project" Property="Portfolio" Title="Portfolio">
                        <Template Context="proj">
                            @proj.Portfolio.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Budget" Title="Budget" FormatString="{0:C0}" />
                    <RadzenDataGridColumn TItem="Project" Property="ActualCost" Title="Actual Cost" FormatString="{0:C0}" />
                    <RadzenDataGridColumn TItem="Project" Property="FundsReceived" Title="Funds Received" FormatString="{0:C0}" />
                    <RadzenDataGridColumn TItem="Project" Property="FundingStatus" Title="Funding Status">
                        <Template Context="proj">
                            @proj.FundingStatus.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="StartDate" Title="Start Date" FormatString="{0:d}" />
                    <RadzenDataGridColumn TItem="Project" Property="EndDate" Title="End Date" FormatString="{0:d}" />
                </Columns>
            </RadzenDataGrid>
            </div>
            <hr />
            <div class="card">
                <div class="row">
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#e3001b"></rect> </svg> &gt;35hrs/week</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#00783c"></rect> </svg> =35hrs/week</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#fc9803"></rect> </svg> &gt;17.5hrs/week</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#ffd500"></rect> </svg> &le;17.5hrs/week</div>
                </div>
                <ApexChart TItem="ChartItem"
                       Title="Schedule"
                       XAxisType="XAxisType.Datetime"
                       Options=options>

                    <ApexRangeSeries TItem="ChartItem"
                                 Items="chartSource"
                                 XValue="@(e => e.Label)"
                                 YMinValue="@(e =>e.StartDate.ToUnixTimeMilliseconds())"
                                 YMaxValue="@(e =>e.EndDate.ToUnixTimeMilliseconds())"
                                 PointColor="@(e => e.GetColourStringWork())" />

                </ApexChart>
            </div>
        }
</div>