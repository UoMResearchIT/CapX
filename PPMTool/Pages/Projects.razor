@page "/projects"
@inherits PPMTool.Pages.BaseProjectPage
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using PPMTool.Data
@using static PPMTool.Enums.Extensions
@using System.ComponentModel.DataAnnotations
<PageTitle>Projects - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>@($"Manage Projects")</h1>
        </div>
        <div class="col-auto">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenText Text="Include Finished" Style="margin-bottom: 0.1rem" />
                <RadzenSwitch @bind-Value="@IncludeFinished" />
                <RadzenButton Text="Add" Icon="add" Click="@AddProject" Disabled="@(!EditAuthorised || Loading)" />
            </RadzenStack>
        </div>
    </div>
    <hr />
    <div class="card">
        @if (Loading)
        {
            <LoadingComponent />
        }
        else if (projects == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <RadzenDataGrid AllowFiltering="true"
                            AllowColumnResize="true"
                            AllowSorting="true"
                            FilterMode="FilterMode.SimpleWithMenu"
                            PageSize="@pageCount"
                            Count="@count"
                            AllowPaging="true"
                            ShowPagingSummary="true"
                            Data="@projects"
                            TItem="Project"
                            ColumnWidth="8rem"
                            SelectionMode="DataGridSelectionMode.Single"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            @bind-Settings="@Settings"
                            @ref="dataGrid"
                            LoadData="@OnLoadData">
                <Columns>
                    <RadzenDataGridColumn TItem="Project" Property="RTP" Title="RTP" Frozen="true" Width="7rem" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="Name" Title="Name" Frozen="true" Width="15rem" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="PI" Title="PI" Width="14rem" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ProjectManager.Name" Title="PM" Width="15rem" MinWidth="10px">
                        <Template Context="p">
                            @(p.ProjectManager?.Name ?? "Not Set")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="ProjectStatus" Title="Project Status" MinWidth="10px">
                        <Template Context="p">
                            @p.ProjectStatus.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Faculty" Title="Faculty" MinWidth="10px">
                        <Template Context="p">
                            @p.Faculty.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="School" Title="School" MinWidth="10px">
                        <Template Context="p">
                            @p.School.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="LeadershipFTE" Title="Mgmt FTE" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="StartDate" Title="Start Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="EndDate" Title="End Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="CostModel" Title="Cost Model" Width="14rem" MinWidth="10px">
                        <Template Context="p">
                            @(p.CostModel.GetAttribute<DisplayAttribute>().Name)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Project.DayRate" Title="Day Rate" Width="8rem" MinWidth="10px">
                        <Template Context="p">
                            @(p.CostModel == CostModel.DayRate ? p.DayRate.ToString("C0") : "N/A")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Project.Budget" Title="Budget" FormatString="{0:C0}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="Project.ActualCost" Title="Actual Cost" FormatString="{0:C0}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Title="Funds Received" FormatString="{0:C0}" MinWidth="10px">
                        <Template Context="p">
                            @(InvoiceService.GetFundsReceived(Context, p.ProjectId).ToString("C0"))
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Project.ActualWorkHours" Title="Actual Work" FormatString="{0:F0}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Title="Details" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="6rem" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="p">
                            <RadzenButton Icon="info" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => NavigateToProjectDetails(p.ProjectId))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Details"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </div>
</div>