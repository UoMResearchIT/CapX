@page "/projects"
@page "/"
@using PPMTool.Enums

<div class="container">
    <h1>Projects</h1>
    <a class="btn btn-primary" href="/addproject"><i class="oi oi-plus" /></a>
    <div class="card">
        @if (projects == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <table class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th class="sort-th" @onclick="@(() => SortTable("Name"))">
                            Name
                            <span class="fa @(SetSortIcon("Name"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("PI"))">
                            PI
                            <span class="fa @(SetSortIcon("PI"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("Portfolio"))">
                            Portfolio
                            <span class="fa @(SetSortIcon("Portfolio"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("Budget"))">
                            Budget
                            <span class="fa @(SetSortIcon("Budget"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("ActualCost"))">
                            Actual Cost
                            <span class="fa @(SetSortIcon("ActualCost"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("FundsReceived"))">
                            Funds Received
                            <span class="fa @(SetSortIcon("FundsReceived"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("FundingStatus"))">
                            Funding Status
                            <span class="fa @(SetSortIcon("FundingStatus"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("StartDate"))">
                            Start Date
                            <span class="fa @(SetSortIcon("StartDate"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("EndDate"))">
                            End Date
                            <span class="fa @(SetSortIcon("EndDate"))"></span>
                        </th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in projects)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.PI</td>
                            <td>@p.Portfolio.ToNiceString()</td>
                            <td>@p.Budget.ToString("C0")</td>
                            <td>@p.ActualCost.ToString("C0")</td>
                            <td>@p.FundsReceived.ToString("C0")</td>
                            <td>@p.FundingStatus.ToNiceString()</td>
                            <td>@p.StartDate.ToShortDateString()</td>
                            <td>@p.EndDate.ToShortDateString()</td>
                            <td><a class="btn btn-primary" href="/projectdetails/@p.ProjectId"><i class="oi oi-info" /></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>