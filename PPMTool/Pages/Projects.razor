@page "/projects"
@page "/"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components

@if (userRole.RoleType == RoleType.Superuser || userRole.RoleType == RoleType.Manager)
{
    <div class="container">
        <h1>My Projects</h1>
        <hr />
        @if (ownedProjects == null)
        {
            <LoadingComponent />            
        }
        else if (ownedProjects.Count() == 0)
        {
            <RadzenText Text="You don't have any projects to manage!" />
        }
        else
        {
            foreach (var p in ownedProjects)
            {
                <div class="card my-1">
                    <div class=row style="align-items:center">
                        <div class="col-auto">
                            <RadzenText TextStyle=TextStyle.H5 Text="@p.GetFullName()" />
                        </div>
                        <div class="col">
                            @if (!p.HasActiveStatusMessages())
                            {
                                <RadzenIcon Icon="check" IconStyle="IconStyle.Success" />
                            }
                        </div>
                        <div class="col-auto">
                            <RadzenButton Icon="arrow_forward" ButtonStyle="ButtonStyle.Primary" Text="Details" Click="@(args => NavigateToProjectDetails(p.ProjectId))" @onclick:stopPropagation="true" />
                        </div>
                        <div class="col-auto">
                            <RTPButtonComponent Page=@this Project=p />
                        </div>
                    </div>
                    <MessageSummaryComponent Project=p />
                </div>
            }
        }
    </div>
    <br />
}

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>All Projects</h1>
        </div>
        <div class="col-auto">
            <RadzenButton Text="Add" Icon="add" Click="@AddProject" Disabled=!EditAuthorised />
        </div>
    </div>
    <hr />
    @if (loading)
    {
        <LoadingComponent />
    }
    else if (projects == null)
    {
        <spinner> </spinner>
        <div class="card">
            <p class="lead">No data to show</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="row align-items-center mb-3">
                <div class="col-auto">
                    Include Finished?:
                </div>
                <div class="col-auto" style="display: flex">
                    <RadzenSwitch @bind-Value="@IncludeFinished" />
                </div>
            </div>
            <RadzenDataGrid AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.Simple"
                            EditMode="DataGridEditMode.Single"
                            AllowSorting="true"
                            PageSize="10"
                            AllowPaging="true"
                            ShowPagingSummary="true"
                            Data="@projects"
                            TItem="Project"
                            ColumnWidth="120px"
                            SelectionMode="DataGridSelectionMode.Single"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            @bind-Settings="@Settings">
                <Columns>
                    <RadzenDataGridColumn TItem="Project" Title="Status" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Left" Width="100px">
                        <Template Context="proj">
                            @if (proj.ScheduleStatus == ScheduleStatus.OnSchedule)
                            {
                                <RadzenIcon Icon="verified" IconStyle="IconStyle.Success" title="Project On Schedule" />
                            }
                            else if (proj.ScheduleStatus == ScheduleStatus.Ahead)
                            {
                                <RadzenIcon Icon="warning" IconStyle="IconStyle.Warning" title="Project Ahead" />
                            }
                            else
                            {
                                <RadzenIcon Icon="error" IconStyle="IconStyle.Danger" title="Project Late" />
                            }
                            @if (proj.BudgetStatus == BudgetStatus.OnBudget)
                            {
                                <RadzenIcon Icon="verified" IconStyle="IconStyle.Success" title="On Budget" />
                            }
                            else if (proj.BudgetStatus == BudgetStatus.Underspend)
                            {
                                <RadzenIcon Icon="warning" IconStyle="IconStyle.Warning" title="Underspent" />
                            }
                            else
                            {
                                <RadzenIcon Icon="error" IconStyle="IconStyle.Danger" title="Overspent" />
                            }
                            @if (proj.FundsReceived < proj.Budget)
                            {
                                <RadzenIcon Icon="error" IconStyle="IconStyle.Danger" title="Funding Shortfall" />
                            }
                            else
                            {
                                <RadzenIcon Icon="verified" IconStyle="IconStyle.Success" title="Fully Funded" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="60px">
                        <Template Context="proj">
                            <RadzenButton Icon="arrow_forward" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => NavigateToProjectDetails(proj.ProjectId))" @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="RTP" Title="RTP" Frozen="true" Width="100px" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="Name" Title="Name" Frozen="true" Width="180px" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="PI" Title="PI" Width="150px" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ProjectManager.Name" Title="PM" Width="150px" MinWidth="10px">
                        <Template Context="proj">
                            @(proj.ProjectManager?.Name ?? "Not Set")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="ProjectStatus" Title="Project Status" MinWidth="10px">
                        <Template Context="proj">
                            @proj.ProjectStatus.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Portfolio" Title="Portfolio" MinWidth="10px">
                        <Template Context="proj">
                            @proj.Portfolio.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Budget" Title="Budget" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ActualCost" Title="Actual Cost" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="FundsReceived" Title="Funds Received" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ActualWorkHours" Title="Actual Work" FormatString="{0:F0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="StartDate" Title="Start Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="EndDate" Title="End Date" FormatString="{0:d}" MinWidth="10px" />
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</div>