@page "/projects"
@page "/"
@using PPMTool.Enums

<div class="container">
    <h1>Projects</h1>
    <a class="btn btn-primary" href="/addproject"><i class="oi oi-plus"/></a>
    <div class="card">
        @if (projects == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <table class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>PI</th>
                        <th>Portfolio</th>
                        <th>Budget</th>
                        <th>Actual Cost</th>
                        <th>Funds Received</th>
                        <th>Funding Status</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in projects)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.PI</td>
                            <td>@p.Portfolio.ToNiceString()</td>
                            <td>@p.Budget.ToString("C0")</td>
                            <td>@p.ActualCost.ToString("C0")</td>
                            <td>@p.FundsReceived.ToString("C0")</td>
                            <td>@p.FundingStatus.ToNiceString()</td>
                            <td>@p.StartDate.ToShortDateString()</td>
                            <td>@p.EndDate.ToShortDateString()</td>
                            <td><a class="btn btn-primary" href="/projectdetails/@p.ProjectId"><i class="oi oi-info"/></a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>