@page "/projects"
@inherits PPMTool.Pages.BaseProjectPage
@using PPMTool.Data.Context
@using PPMTool.Data.Enums
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using PPMTool.Data
@using static PPMTool.Data.Enums.Extensions
@using System.ComponentModel.DataAnnotations
<PageTitle>Projects - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>@($"Manage Projects")</h1>
        </div>
        <div class="col-auto">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenLabel Text="Include Finished" Style="margin-bottom: 0.1rem" Component="IncludeFinished" />
                <RadzenSwitch @bind-Value="@IncludeFinished" Name="IncludeFinished"/>
                <RadzenButton Text="Add" Icon="add" Click="@AddProject" Disabled="@(!EditAuthorised || Loading)" />
            </RadzenStack>
        </div>
    </div>
    <hr />
    <RadzenCard>
        @if (Loading)
        {
            <LoadingComponent />
        }
        else if (projects == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <DataGridWithPaging AllowFiltering="true"
                                AllowColumnResize="true"
                                AllowSorting="true"
                                FilterMode="FilterMode.Simple"
                                Count="@count" 
                                Data="@projects"
                                TItem="Project"
                                ColumnWidth="8rem"
                                SelectionMode="DataGridSelectionMode.Single"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                PagingPage="@this"
                                @bind-Settings="@Settings"
                                @ref="dataGrid"
                                LoadData="@LoadData">
                <Columns>
                    <RadzenDataGridColumn TItem="Project" Property="RTP" Title="@($"{GetSetting(SettingType.ProjectAbbreviation)}")" Frozen="true" Width="7rem" MinWidth="10px" FilterMode="FilterMode.SimpleWithMenu" />
                    <RadzenDataGridColumn TItem="Project" Property="Name" Title="Name" Frozen="true" Width="15rem" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="PI" Title="PI" Width="14rem" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ProjectManager.Name" Title="PM" Width="15rem" MinWidth="10px">
                        <Template Context="p">
                            @(p.ProjectManager?.Name ?? "Not Set")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="ProjectStatus" Title="Project Status" MinWidth="10px">
                        <Template Context="p">
                            @p.ProjectStatus.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="School.Faculty.Code" Title="@($"{GetSetting(SettingType.OrgUnitUpper)}")" MinWidth="10px" FilterMode="FilterMode.Simple" FilterProperty="School.Faculty.Code" SortProperty="School.Faculty.Code">
                        <Template Context="p">
                            <span title="@p.School.Faculty.Name">@p.School.Faculty.Code</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="School.Code" Title="@($"{GetSetting(SettingType.OrgUnitLower)}")" MinWidth="10px" FilterMode="FilterMode.Simple" FilterProperty="School.Code" SortProperty="School.Code">
                        <Template Context="p">
                             <span title="@p.School.Name">@p.School.Code</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <!-- Default datetimes added when creating a Project are Max and Min to be shaped when tasks are added -->
                    <RadzenDataGridColumn TItem="Project"
                                          Property="StartDate"
                                          Title="Start Date"
                                          FormatString="{0:dd/MM/yyyy}"
                                          Type="typeof(DateTime)"
                                          FilterMode="FilterMode.SimpleWithMenu"
                                          FilterOperator="FilterOperator.GreaterThanOrEquals"
                                          Width="13rem">
                        <Template Context="p">
                            @if (p.StartDate == DateTime.MaxValue)
                            {
                                <StatusMessageComponent Message="@(new StatusMessage("No tasks!", StatusMessage.MessageType.Error))" />
                            }
                            else
                            {
                                @p.StartDate.ToShortDateString()
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project"
                                          Property="EndDate"
                                          Title="End Date"
                                          FormatString="{0:dd/MM/yyyy}"
                                          Type="typeof(DateTime)"
                                          FilterMode="FilterMode.SimpleWithMenu"
                                          FilterOperator="FilterOperator.LessThanOrEquals"
                                          Width="13rem">
                        <Template Context="p">
                            @if (p.EndDate == DateTime.MinValue)
                            {
                                <StatusMessageComponent Message="@(new StatusMessage("No tasks!", StatusMessage.MessageType.Error))" />
                            }
                            else
                            {
                                @p.EndDate.ToShortDateString()
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    @if (FeatureService.IsFeatureEnabled(FeatureType.ProjectFinance))
                    {
                        <RadzenDataGridColumn TItem="Project" Property="CostModel" Title="Cost Model" Width="14rem" MinWidth="10px">
                            <Template Context="p">
                                @(p.CostModel.GetAttribute<DisplayAttribute>().Name)
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Project" Property="DayRate" Title="Day Rate" Width="8rem" Filterable="false">
                            <Template Context="p">
                                @(p.CostModel == CostModel.DayRate ? p.DayRate.ToString("C0") : "N/A")
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="Project" 
                                              Property="Budget" 
                                              Title="Budget" 
                                              FormatString="{0:C0}" 
                                              Width="10rem" 
                                              Type="typeof(double)" 
                                              FilterMode="FilterMode.SimpleWithMenu" 
                                              FilterOperator="FilterOperator.GreaterThanOrEquals" />
                        <RadzenDataGridColumn TItem="Project" 
                                              Property="ActualCost" 
                                              Title="Actual Cost" 
                                              FormatString="{0:C0}" 
                                              Width="10rem"
                                              Type="typeof(double)"
                                              FilterMode="FilterMode.SimpleWithMenu"
                                              FilterOperator="FilterOperator.GreaterThanOrEquals" />
                        <RadzenDataGridColumn TItem="Project" 
                                              Property="FundsReceived" 
                                              Title="Funds Received" 
                                              Width="10rem"
                                              Type="typeof(double)"
                                              FilterMode="FilterMode.SimpleWithMenu"
                                              FilterOperator="FilterOperator.GreaterThanOrEquals">
                            <Template Context="p">
                                @p.FundsReceived.ToString("C0")
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="Project" 
                                          Property="ActualWorkHours" 
                                          Title="Actual Work" 
                                          FormatString="{0:F0}" 
                                          MinWidth="10px" 
                                          Width="10rem"
                                          Type="typeof(double)"
                                          FilterMode="FilterMode.SimpleWithMenu"
                                          FilterOperator="FilterOperator.GreaterThanOrEquals" />
                    <RadzenDataGridColumn TItem="Project" Title="Details" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="6rem" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="p">
                            <RadzenButton Icon="info" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => NavigateToProjectDetails(p.ProjectId))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Details"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </DataGridWithPaging>
        }
    </RadzenCard>
</div>