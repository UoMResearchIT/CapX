@page "/projects"
@page "/"
@using PPMTool.Enums

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>Projects</h1>
        </div>
        <div class="col-auto">
            <a class="btn btn-primary" href="/addproject"><i class="oi oi-plus" /></a>
        </div>
    </div>
    <div class="card">
        @if (projects == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th class="clickable" @onclick="@(() => SortTable("Name"))">
                                Name
                                <span class="fa @(SetSortIcon("Name"))"></span>
                            </th>
                            <th class="clickable" @onclick="@(() => SortTable("PI"))">
                                PI
                                <span class="fa @(SetSortIcon("PI"))"></span>
                            </th>
                            <th class="clickable" @onclick="@(() => SortTable("Portfolio"))">
                                Portfolio
                                <span class="fa @(SetSortIcon("Portfolio"))"></span>
                            </th>
                            <th class="clickable" @onclick="@(() => SortTable("Budget"))">
                                Budget
                                <span class="fa @(SetSortIcon("Budget"))"></span>
                            </th>
                            <th class="clickable" @onclick="@(() => SortTable("ActualCost"))">
                                Actual Cost
                                <span class="fa @(SetSortIcon("ActualCost"))"></span>
                            </th>
                            <th class="clickable" @onclick="@(() => SortTable("FundsReceived"))">
                                Funds Received
                                <span class="fa @(SetSortIcon("FundsReceived"))"></span>
                            </th>
                            <th class="clickable" @onclick="@(() => SortTable("FundingStatus"))">
                                Funding Status
                                <span class="fa @(SetSortIcon("FundingStatus"))"></span>
                            </th>
                            <th class="clickable" @onclick="@(() => SortTable("StartDate"))">
                                Start Date
                                <span class="fa @(SetSortIcon("StartDate"))"></span>
                            </th>
                            <th class="clickable" @onclick="@(() => SortTable("EndDate"))">
                                End Date
                                <span class="fa @(SetSortIcon("EndDate"))"></span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in projects)
                        {
                            <tr class="clickable" @onclick="@(e => ProjectClicked(p.ProjectId))">
                                <td>@p.Name</td>
                                <td>@p.PI</td>
                                <td>@p.Portfolio.ToNiceString()</td>
                                <td>@p.Budget.ToString("C0")</td>
                                <td>@p.ActualCost.ToString("C0")</td>
                                <td>@p.FundsReceived.ToString("C0")</td>
                                <td>@p.FundingStatus.ToNiceString()</td>
                                <td>@p.StartDate.ToShortDateString()</td>
                                <td>@p.EndDate.ToShortDateString()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>