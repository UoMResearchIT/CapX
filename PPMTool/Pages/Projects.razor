@page "/projects"
@page "/"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using static PPMTool.Enums.Extensions

@if (userRole.RoleType == RoleType.Superuser || userRole.RoleType == RoleType.Manager)
{
    <div class="container">
        <h1>My Projects</h1>
        <hr />
        @if (ownedProjects == null)
        {
            <LoadingComponent />            
        }
        else if (ownedProjects.Count() == 0)
        {
            <RadzenText Text="You don't have any projects to manage!" />
        }
        else
        {
            foreach (var project in ownedProjects.OrderBy(x => x.ProjectStatus))
            {
                <div class="card my-1">
                    <RadzenStack Orientation="Radzen.Orientation.Vertical">
                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                            <RadzenStack Orientation="Radzen.Orientation.Horizontal"AlignItems="AlignItems.Center">
                                <RadzenText TextStyle="TextStyle.H5" Text="@project.GetFullName()" />
                                <RadzenBadge
                                    Style="margin-bottom: 0.5rem"
                                    BadgeStyle="@(
                                        project.ProjectStatus.IsFinishedOrCancelled() ? BadgeStyle.Light : 
                                        project.ProjectStatus == ProjectStatus.Active ? BadgeStyle.Success : 
                                        project.ProjectStatus == ProjectStatus.Funded ? BadgeStyle.Info :
                                        BadgeStyle.Light)"
                                    Text="@project.ProjectStatus.ToNiceString()" />
                            </RadzenStack>
                            <RadzenStack Orientation="Radzen.Orientation.Horizontal"AlignItems="AlignItems.Center" JustifyContent="JustifyContent.End" Gap="0.3rem">
                                <RadzenButton Click=@(args => EditProject(project)) Text="Edit" Icon="edit" Disabled=!EditAuthorised />
                                <RadzenSplitButton ButtonStyle="ButtonStyle.Primary" Text="Details" Click="@(item => DetailsButtonClicked(item, project))">
                                    <ChildContent>
                                        <RadzenSplitButtonItem Text="Details in New Tab" Value="NewWindow" />
                                    </ChildContent>
                                </RadzenSplitButton>
                            </RadzenStack>
                        </RadzenStack>
                        <MessageSummaryComponent Messages="project.GetLatestStatusMessages()" />
                    </RadzenStack>
                </div>
            }
        }
    </div>
    <br />
}

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>All Projects</h1>
        </div>
        <div class="col-auto">
            <RadzenButton Text="Add" Icon="add" Click="@AddProject" Disabled=!EditAuthorised />
        </div>
    </div>
    <hr />
    @if (Loading)
    {
        <LoadingComponent />
    }
    else if (projects == null)
    {
        <spinner> </spinner>
        <div class="card">
            <p class="lead">No data to show</p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="row align-items-center mb-3">
                <div class="col-auto">
                    Include Finished?:
                </div>
                <div class="col-auto" style="display: flex">
                    <RadzenSwitch @bind-Value="@IncludeFinished" />
                </div>
            </div>
            <RadzenDataGrid AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.Simple"
                            EditMode="DataGridEditMode.Single"
                            AllowSorting="true"
                            PageSize="10"
                            AllowPaging="true"
                            ShowPagingSummary="true"
                            Data="@projects"
                            TItem="Project"
                            ColumnWidth="120px"
                            SelectionMode="DataGridSelectionMode.Single"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            @bind-Settings="@Settings">
                <Columns>
                    <RadzenDataGridColumn TItem="Project" Property="RTP" Title="RTP" Frozen="true" Width="100px" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="Name" Title="Name" Frozen="true" Width="180px" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="PI" Title="PI" Width="150px" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ProjectManager.Name" Title="PM" Width="150px" MinWidth="10px">
                        <Template Context="proj">
                            @(proj.ProjectManager?.Name ?? "Not Set")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="ProjectStatus" Title="Project Status" MinWidth="10px">
                        <Template Context="proj">
                            @proj.ProjectStatus.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Faculty" Title="Faculty" MinWidth="10px">
                        <Template Context="proj">
                            @proj.Faculty.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="School" Title="School" MinWidth="10px">
                        <Template Context="proj">
                            @proj.School.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="DayRate" Title="Day Rate" Width="80px" FormatString="{0:C0}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="Budget" Title="Budget" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ActualCost" Title="Actual Cost" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="FundsReceived" Title="Funds Received" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="ActualWorkHours" Title="Actual Work" FormatString="{0:F0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="StartDate" Title="Start Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Property="EndDate" Title="End Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Project" Title="Details" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="60px" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="proj">
                            <RadzenButton Icon="arrow_forward" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => NavigateToProjectDetails(proj.ProjectId))" @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
</div>