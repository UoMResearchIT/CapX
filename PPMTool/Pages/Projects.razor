@page "/projects"
@page "/"
@using PPMTool.Enums
@using PPMTool.Data
@using PPMTool.Data.Entities

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>Projects</h1>
        </div>
        <div class="col-auto">
            <a class="btn btn-primary" href="/addproject"><i class="oi oi-plus" /></a>
        </div>
    </div>
    <div class="card">
        @if (projects == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <RadzenDataGrid @ref="projectGrid"
                        AllowFiltering="true"
                        AllowColumnResize="true"
                        FilterMode="FilterMode.Advanced"
                        EditMode="DataGridEditMode.Single"
                        AllowSorting="true"
                        PageSize="10"
                        AllowPaging="true"
                        ShowPagingSummary="true"
                        Data="@projects"
                        TItem="Project"
                        ColumnWidth="150px"
                        SelectionMode="DataGridSelectionMode.Single"
                        LogicalFilterOperator="LogicalFilterOperator.Or"
                        RowUpdate="@OnUpdateRow">
                <Columns>
                    <RadzenDataGridColumn TItem="Project" Property="Name" Title="Name" Frozen="true">
                        <EditTemplate Context="proj">
                            <RadzenTextBox @bind-Value="proj.Name" Name="Name" Style="width:100%; display: block;" />
                            <RadzenRequiredValidator Text="Name is required" Component="Name" Popup="true" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="PI" Title="PI">
                        <EditTemplate Context="proj">
                            <RadzenTextBox @bind-Value="proj.PI" Name="PI" Style="width:100%; display: block;" />
                            <RadzenRequiredValidator Text="PI is required" Component="PI" Popup="true" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Portfolio" Title="Portfolio">
                        <Template Context="proj">
                            @proj.Portfolio.ToNiceString()
                        </Template>
                        <EditTemplate Context="proj">
                            <RadzenDropDown @bind-Value="proj.Portfolio" Data="@portfolioOptions" ValueProperty="Portfolio" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="Budget" Title="Budget" FormatString="{0:C0}">
                        <EditTemplate Context="proj">
                            <RadzenNumeric TValue="double" Format="c" @bind-Value=@proj.PlannedCost />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="ActualCost" Title="Actual Cost" FormatString="{0:C0}" />
                    <RadzenDataGridColumn TItem="Project" Property="FundsReceived" Title="Funds Received" FormatString="{0:C0}">
                        <EditTemplate Context="proj">
                            <RadzenNumeric TValue="double" Format="c" @bind-Value=@proj.FundsReceived />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="FundingStatus" Title="Funding Status">
                        <Template Context="proj">
                            @proj.FundingStatus.ToNiceString()
                        </Template>
                        <EditTemplate Context="proj">
                            <RadzenDropDown @bind-Value="proj.FundingStatus" Data="@fundingOptions" ValueProperty="FundingStatus" />
                        </EditTemplate>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Project" Property="StartDate" Title="Start Date" FormatString="{0:d}" />
                    <RadzenDataGridColumn TItem="Project" Property="EndDate" Title="End Date" FormatString="{0:d}" />
                    <RadzenDataGridColumn TItem="Project" Frozen="true" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="120px">
                        <Template Context="proj">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(proj))" @onclick:stopPropagation="true">
                            </RadzenButton>
                            <RadzenButton Icon="info" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => ProjectClicked(proj.ProjectId))" @onclick:stopPropagation="true">
                            </RadzenButton>
                        </Template>
                        <EditTemplate Context="proj">
                            <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => SaveRow(proj))">
                            </RadzenButton>
                            <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(proj))">
                            </RadzenButton>
                        </EditTemplate>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            <div class="card">
                <div class="row">
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#e3001b"></rect> </svg> &gt;35hrs/week</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#00783c"></rect> </svg> =35hrs/week</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#fc9803"></rect> </svg> &gt;17.5hrs/week</div>
                    <div class="col-auto"><svg width=20 height=20> <rect width="20" height="20" fill="#ffd500"></rect> </svg> &le;17.5hrs/week</div>
                </div>
                <ApexChart TItem="ChartItem"
                       Title="Schedule"
                       XAxisType="XAxisType.Datetime"
                       Options=options>

                    <ApexRangeSeries TItem="ChartItem"
                                 Items="chartSource"
                                 XValue="@(e => e.Label)"
                                 YMinValue="@(e =>e.StartDate.ToUnixTimeMilliseconds())"
                                 YMaxValue="@(e =>e.EndDate.ToUnixTimeMilliseconds())"
                                 PointColor="@(e => e.GetColourStringWork())" />

                </ApexChart>
            </div>
        }
    </div>
</div>