@page "/wlmanalysis"
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using DotNetExtensions
@inherits BasePage

<div class="container">
    <RadzenRow>
        <RadzenColumn>
            <h2>Workload Model Analysis</h2>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="card" Style="flex-direction:unset">
        <RadzenColumn>
            <RadzenStack>
                <RadzenText TextStyle="TextStyle.Subtitle1" Text="Innate Report Upload" />
                <RadzenText TextStyle="TextStyle.Body2" Text="If you upload an appropriately-formatted, tab-separated, plain text report downloaded from Innate, this page will generate the workload model analyses for you for each staff member in the report over the period specified in the report, grouped in calendar year quarters." />
            </RadzenStack>
        </RadzenColumn>
        <RadzenColumn>
            <RadzenFileInput @bind-Value=@file @bind-FileName=@fileName @bind-FileSize=@fileSize TValue="byte[]" Style="width: 100%"
                                Accept="text/plain" Change=@(args => OnFileChanged(args, "FileInput")) Error=@(args => OnError(args, "FileInput")) InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})" />
        </RadzenColumn>
    </RadzenRow>
    <hr />
    <RadzenRow>
        <RadzenColumn Style="min-width: 50rem">
            <RadzenCard>
                @if (Loading)
                {
                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                }
                else if (wlmChartItems != null && wlmChartItems.Count > 0)
                {
                    @for (int i = 0; i < wlmChartItems.Count; i++)
                    {
                        <ApexChart TItem="WLMWeeklyDataChartItem"
                                   Title="Duty Demand (FTE)"
                                   Options="@(wlmChartOptions.ElementAt(i))">

                            @for (int j = 0; j < Enum.GetValues(typeof(Duty)).Length; j++)
                            {
                                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                                 Items="wlmChartItems.ElementAt(i).Value"
                                                 SeriesType="@SeriesType.Bar"
                                                 Name="@wlmChartItems.ElementAt(i).Value.First().WeeklyValuesByDuty.Keys.ElementAt(j).GetDescription()"
                                                 XValue="@(e => (wlmChartOptions.ElementAt(i).Xaxis.Categories as string[])?.ElementAt(j))"
                                                 YValue="@(e => Convert.ToDecimal(e.WeeklyValuesByDuty[(Duty)j]))" />
                            }

                        </ApexChart>
                    }
                }
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
    <br />
</div>