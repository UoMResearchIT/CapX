@page "/wlmanalysis"
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Pages.Components
@inherits BasePage
<PageTitle>WLM Analysis - CapX</PageTitle>

<div class="container">
    <RadzenRow>
        <RadzenColumn>
            <RadzenStack Orientation="Radzen.Orientation.Vertical">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                    <h2>Workload Model Analysis</h2>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenText Text="Compare to Workload Model" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: -0.2rem" />
                        <RadzenSwitch @bind-Value="@compareToWLM" Change="@DisplayStyleChanged" />
                        <RadzenText Text="Show as Proportion of Time" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: -0.2rem" />
                        <RadzenSwitch @bind-Value="@normalisedByTotalHours" Change="@DisplayStyleChanged" />
                        <RadzenText Text="Use Stacked Bars" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: -0.2rem" />
                        <RadzenSwitch @bind-Value="@useStackedBars" Change="@DisplayStyleChanged" />
                    </RadzenStack>
                </RadzenStack>
                <HintComponent Message="To view the difference between timesheets and the WLM, enable 'Compare to Workload Model' option. Enable 'Show as Proportion of Time' to view each duty as a fraction of the relevant total booked time. Raw views include all booked time, including absence and closures. Workload Model comparisons exclude absence and closures. Click on a block to navigate to the timesheet for that week." />
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <RadzenRow class="rz-card rz-variant-filled" Style="flex-direction:unset">
        <RadzenColumn>
            <RadzenStack Orientation="Radzen.Orientation.Vertical">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                    <RadzenText Text="Choose Staff:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0" />
                    <RadzenDropDown @bind-Value=@selectedPeople
                                    Data=@availablePeople
                                    TextProperty="Name"
                                    Multiple=true
                                    AllowClear=true
                                    AllowFiltering=true
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    FilterOperator="StringFilterOperator.Contains"
                                    Placeholder="Choose RSEs"
                                    Chips=true
                                    MaxSelectedLabels="20"
                                    Disabled="@Loading"
                                    Style="width: 100%" />
                </RadzenStack>
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.Center">
                        <RadzenText Text="Choose Date Range:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0" />
                        <RadzenDatePicker @bind-Value="@startDate" ShowTime="false" DateFormat="dd/MM/yyyy" Disabled="@Loading" />
                        <RadzenText Text="to" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0" />
                        <RadzenDatePicker @bind-Value="@endDate" ShowTime="false" DateFormat="dd/MM/yyyy" Disabled="@Loading" />
                        <RadzenButton Text="3 Months From Start" Click="@(() => SetEndDate(3))" Disabled="@(Loading || startDate == null)" />
                        <RadzenButton Text="3 Months From End" Click="@(() => SetStartDate(3))" Disabled="@(Loading || endDate == null)" />
                    </RadzenStack>
                    <RadzenButton Text="Generate" Click="GenerateCharts" Disabled="@(Loading || startDate == null || endDate == null || selectedPeople == null || selectedPeople?.Count() == 0)" />
                </RadzenStack>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
    <hr />
    @if (Loading)
    {
        <LoadingComponent @bind-SpinnerText="@loadingMessage" />
    }
    else if (wlmChartItems != null && wlmChartItems.Count > 0)
    {
        <RadzenRow>
            @for (int i = 0; i < wlmChartItems.Count; ++i)
            {
                <WLMChartComponent Title="@wlmChartItems.Keys.ElementAt(i)"
                                   ChartOptions="@wlmChartOptions[i]"
                                   ChartItems="@wlmChartItems.ElementAt(i).Value"
                                   CompareToWorkloadModel="@compareToWLM"
                                   NormalisedByTotalHours="@normalisedByTotalHours"
                                   OnDataPointSelected="@OnDataPointSelection"
                                   UseStackedBars="@useStackedBars" />
            }
        </RadzenRow>
    }
    else
    {
        <RadzenText Text="Choose people and a date range above and click to generate the chart." />
    }
    <br />
</div>