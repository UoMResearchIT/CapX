@page "/addtimesheet/{TimesheetId:int}"
@inherits PPMTool.Pages.DataGridPage<TimesheetEntry>
@using DotNetExtensions
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Pages.Components
@using PPMTool.Services
@using Radzen.Blazor
<PageTitle>Add Timesheet - CapX</PageTitle>

<div class="container">
    @if (TimesheetId > 0 && timesheet == null)
    {
        <RadzenText Text="No timesheet with this ID found in the database!" />
    }
    else
    {
        <div class="row">
            <div class="col">
                @if (TimesheetId <= 0)
                {
                    <h1>Add Timesheet</h1>
                }
                else
                {
                    <h1>Edit Timesheet</h1>
                }
                <RadzenText Text="@($"{timesheet.StartDate.ToShortDateString()} - {timesheet.StartDate.AddDays(6).ToShortDateString()}")"  TextStyle="TextStyle.Subtitle1"/>
            </div>
            <div class="col-auto" style="align-content: center">
                <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Button" Click="@DeleteTimesheet" Text="Delete" Icon="delete" Disabled=!EditAuthorised />
            </div>
        </div>
        <hr />
        <div class="card">
            <EditForm Model="@timesheet" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <div class="col">
                        <h2>Timesheet Entries</h2>
                    </div>
                    <div class="col-auto" style="align-content: center">
                        <RadzenButton Text="Add" Icon="add" Click="@InsertRow" Disabled=@(entityToInsert != null || entityToUpdate != null) />
                    </div>
                </div>
                <RadzenDataGrid @ref="dataGrid"
                                AllowFiltering="false"
                                AllowPaging="false"
                                AllowSorting="true"
                                EditMode="DataGridEditMode.Single"
                                Data="@dataGridEntities"
                                TItem="TimesheetEntry"
                                RowUpdate="@OnUpdateRow"
                                RowCreate="@OnCreateRow"
                                ColumnWidth="5rem">
                    <Columns>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="InnateCodeTask" Title="Innate Code" MinWidth="10px" Width="12rem">
                            <Template Context="entry">
                                <RadzenText TextStyle="TextStyle.Body2" Text="@entry.InnateCodeTask.InnateCode.GetCodeAsString()" Style="width: 100%; white-space:pre-wrap" />
                            </Template>
                            <EditTemplate Context="entry">
                                @if (entry.InnateCodeTask == null)
                                {
                                    <RadzenDropDown TValue="string"
                                                    FilterOperator="StringFilterOperator.Contains"
                                                    AllowFiltering="true"
                                                    Placeholder="Search for Innate Code"
                                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                    Data="@innateCodes.Select(x => x.GetCodeAsString())"
                                                    Style="width: 100%"
                                                    Change="@(args => InnateCodeChanged(args))" />
                                }
                                else
                                {
                                    <RadzenText TextStyle="TextStyle.Body2" Text="@entry.InnateCodeTask.InnateCode.GetCodeAsString()" Style="width: 100%; white-space:pre-wrap" />
                                }
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="InnateCodeTask" Title="Task" MinWidth="10px" Width="12rem">
                            <Template Context="entry">
                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                    @if (entry.InnateCodeTask != null)
                                    {
                                        <svg width=1.1rem height=1.1rem xmlns="http://www.w3.org/2000/svg" title="@entry.InnateCodeTask?.Duty.GetDescription()"> <circle r=".5rem" cx=".5rem" cy=".5rem" fill="@(entry.InnateCodeTask?.Duty.GetAttribute<ColourAttribute>().ColourCode ?? "#609")" /></svg>
                                    }
                                    <RadzenText TextStyle="TextStyle.Body2" Text="@entry.InnateCodeTask.TaskName" Style="width: 100%; white-space:pre-wrap; margin-bottom: 0" />
                                </RadzenStack>
                            </Template>
                            <EditTemplate Context="entry">
                                @if (entry.InnateCodeTask == null)
                                {
                                    <RadzenDropDown TValue="InnateCodeTask"
                                                    Data="@innateCodeTasks"
                                                    TextProperty="TaskName"
                                                    Style="width: 100%"
                                                    @bind-Value="entry.InnateCodeTask" />
                                }
                                else
                                {
                                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                                        @if (entry.InnateCodeTask != null)
                                        {
                                            <svg width=1.1rem height=1.1rem xmlns="http://www.w3.org/2000/svg" title="@entry.InnateCodeTask?.Duty.GetDescription()"> <circle r=".5rem" cx=".5rem" cy=".5rem" fill="@(entry.InnateCodeTask?.Duty.GetAttribute<ColourAttribute>().ColourCode ?? "#609")" /></svg>
                                        }
                                        <RadzenText TextStyle="TextStyle.Body2" Text="@entry.InnateCodeTask.TaskName" Style="width: 100%; white-space:pre-wrap; margin-bottom: 0" />
                                    </RadzenStack>
                                }
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="MondayHours" Title="Mon" MinWidth="10px" FormatString="{0:F2}" Sortable="false" Resizable="false">
                            <EditTemplate Context="entry">
                                <RadzenNumeric TValue="double" Min="0" Step="0.25" Style="width: 100%" @bind-Value="entry.MondayHours" Change="HoursChanged" />
                            </EditTemplate>
                            <FooterTemplate>
                                <RadzenText Text="@mondayHours.ToString("F2")" TextStyle="TextStyle.Subtitle1" />
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="TuesdayHours" Title="Tue" MinWidth="10px" FormatString="{0:F2}" Sortable="false" Resizable="false">
                            <EditTemplate Context="entry">
                                <RadzenNumeric TValue="double" Min="0" Step="0.25" Style="width: 100%" @bind-Value="entry.TuesdayHours" Change="HoursChanged" />
                            </EditTemplate>
                            <FooterTemplate>
                                <RadzenText Text="@tuesdayHours.ToString("F2")" TextStyle="TextStyle.Subtitle1" />
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="WednesdayHours" Title="Wed" MinWidth="10px" FormatString="{0:F2}" Sortable="false" Resizable="false">
                            <EditTemplate Context="entry">
                                <RadzenNumeric TValue="double" Min="0" Step="0.25" Style="width: 100%" @bind-Value="entry.WednesdayHours" Change="HoursChanged" />
                            </EditTemplate>
                            <FooterTemplate>
                                <RadzenText Text="@wednesdayHours.ToString("F2")" TextStyle="TextStyle.Subtitle1" />
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="ThursdayHours" Title="Thu" MinWidth="10px" FormatString="{0:F2}" Sortable="false" Resizable="false">
                            <EditTemplate Context="entry">
                                <RadzenNumeric TValue="double" Min="0" Step="0.25" Style="width: 100%" @bind-Value="entry.ThursdayHours" Change="HoursChanged" />
                            </EditTemplate>
                            <FooterTemplate>
                                <RadzenText Text="@thursdayHours.ToString("F2")" TextStyle="TextStyle.Subtitle1" />
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="FridayHours" Title="Fri" MinWidth="10px" FormatString="{0:F2}" Sortable="false" Resizable="false">
                            <EditTemplate Context="entry">
                                <RadzenNumeric TValue="double" Min="0" Step="0.25" Style="width: 100%" @bind-Value="entry.FridayHours" Change="HoursChanged" />
                            </EditTemplate>
                            <FooterTemplate>
                                <RadzenText Text="@fridayHours.ToString("F2")" TextStyle="TextStyle.Subtitle1" />
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="SaturdayHours" Title="Sat" MinWidth="10px" FormatString="{0:F2}" Sortable="false" Resizable="false">
                            <EditTemplate Context="entry">
                                <RadzenNumeric TValue="double" Min="0" Step="0.25" Style="width: 100%" @bind-Value="entry.SaturdayHours" Change="HoursChanged" />
                            </EditTemplate>
                            <FooterTemplate>
                                <RadzenText Text="@saturdayHours.ToString("F2")" TextStyle="TextStyle.Subtitle1" />
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Property="SundayHours" Title="Sun" MinWidth="10px" FormatString="{0:F2}" Sortable="false" Resizable="false">
                            <EditTemplate Context="entry">
                                <RadzenNumeric TValue="double" Min="0" Step="0.25" Style="width: 100%" @bind-Value="entry.SundayHours" Change="HoursChanged" />
                            </EditTemplate>
                            <FooterTemplate>
                                <RadzenText Text="@sundayHours.ToString("F2")" TextStyle="TextStyle.Subtitle1" />
                            </FooterTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Title="Total" MinWidth="10px" FormatString="{0:F2}" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                            <Template Context="entry">
                                <RadzenText Text="@entry.TotalHours.ToString("F2")" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="TimesheetEntry" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="9.5rem" MinWidth="10px" Title="Actions">
                            <Template Context="entry">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(entry))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(entry))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" />
                            </Template>
                            <EditTemplate Context="entry">
                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(entry))" MouseEnter="@(args => ShowTooltip(args, "Save"))" Disabled="entry.InnateCodeTask == null" />
                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(entry))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(entry))" MouseEnter="@(args => ShowTooltip(args, "Delete"))" Visible="@(entityToInsert == null)" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                <hr />
                <div class="row">
                    <div class="col">
                        <h4>Status</h4>
                        <RadzenStack Orientation="Radzen.Orientation.Vertical" Style="margin-bottom: 1rem">
                            <RadzenDropDown @bind-Value="timesheet.Status"
                                            TValue="TimesheetStatus"
                                            Data="Enum.GetValues<TimesheetStatus>()">
                                <Template Context="item">
                                    <RadzenBadge BadgeStyle="@(((TimesheetStatus)item).GetBadgeStyle())" class="timesheet-status-style" Style="width:auto" Text="@(((TimesheetStatus)item).ToNiceString())" />
                                </Template>
                            </RadzenDropDown>
                            <RadzenTextArea @bind-Value="timesheet.Info" Placeholder="Add any notes on this timesheet here..." Style="width: 100%" />
                        </RadzenStack>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Update" Icon="check" />
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Button" Click="DiscardTimesheet" Text="Discard" Icon="close" />
                    </div>
                </div>
                @if (ErrorMessage != null)
                {
                    <br />
                    <StatusMessageComponent Message=@ErrorMessage />
                }
            </EditForm>
        </div>
    }
</div>
