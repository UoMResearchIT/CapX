@page "/managecodes/addinnatecode/{InnateCodeId:int}"
@inherits DataGridPage<InnateCodeTask>
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using PPMTool.Data.Enums
<PageTitle>Add Timesheet Code - CapX</PageTitle>

<FeatureCheckComponent Feature="FeatureType.Timesheets">

    <div class="container">
    @if (innateCode != null)
    {
        @if (InnateCodeId <= 0)
        {
            <h1>Add New Timesheet Code</h1>
        }
        else
        {
            <h1>Edit <i>@(innateCode?.GetSensibleObjectName())</i></h1>
        }
        
        <hr />
        <RadzenCard>
            <EditForm Model="@innateCode">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col-3">
                        <RadzenLabel class="radzen-form-label" Text="Activity Code" /><br />
                        <RadzenTextBox class="radzen-text-box" @bind-Value="innateCode.ActivityCode" />
                    </div>
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="Activity Name" /><br />
                        <RadzenTextBox class="radzen-text-box" @bind-Value="innateCode.ActivityName" />
                    </div>
                    <div class="col-2">
                        <RadzenLabel class="radzen-form-label" Text="Active" Component="IsActive" /><br />
                        <RadzenSwitch @bind-Value="innateCode.IsActive" Style="margin-top: 1rem" Name="IsActive" Change="@ActivityActiveChanged" />
                    </div>
                    <div class="col-2">
                        <RadzenLabel class="radzen-form-label" Text="Sensitive" Component="IsSensitive" /><br />
                        <RadzenSwitch @bind-Value="innateCode.IsSensitive" Style="margin-top: 1rem" Name="IsSensitive" />
                    </div>
                </div>

                <hr />
                <div class="row">
                    <div class="col">
                        <h2>Current Tasks</h2>
                    </div>
                    <div class="col-auto" style="align-content: center">
                        <RadzenButton Text="Defaults" Icon="add" Click="@AddDefaults" Disabled=@(entityToInsert != null || entityToUpdate != null) />
                    </div>
                    <div class="col-auto" style="align-content: center">
                        <RadzenButton Text="Add" Icon="add" Click="@InsertRow" Disabled=@(entityToInsert != null || entityToUpdate != null) />
                    </div>
                </div>
                <RadzenDataGrid @ref="dataGrid"
                                AllowFiltering="@(dataGridEntities != null && dataGridEntities.Count > 0)"
                                AllowSorting="true"
                                EditMode="DataGridEditMode.Single"
                                FilterMode="FilterMode.Simple"
                                Data="@dataGridEntities"
                                TItem="InnateCodeTask"
                                RowUpdate="@OnUpdateRow"
                                RowCreate="@OnCreateRow"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                    <Columns>
                        <RadzenDataGridColumn TItem="InnateCodeTask" Property="TaskName" Title="Task Name" Width="15rem" MinWidth="10px">
                            <EditTemplate Context="task">
                                <RadzenTextBox class="no-margin"  @bind-Value="task.TaskName" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="InnateCodeTask" Property="Duty" Title="Duty" Width="15rem" MinWidth="10px">
                            <Template Context="task">
                                @(task.Duty.GetDescription())
                            </Template>
                            <EditTemplate Context="task">
                                <RadzenDropDown TValue="Duty"
                                                @bind-Value="task.Duty"
                                                Data="duties"
                                                ValueProperty="Value"
                                                TextProperty="Text" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="InnateCodeTask" Property="IsActive" Title="Active" Width="5rem" MinWidth="10px">
                                <Template Context="c">
                                    <RadzenStack AlignItems="AlignItems.Start" Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.NoWrap">
                                        <RadzenSwitch @bind-Value="c.IsActive" Disabled="true" Name="IsActive" />
                                        <RadzenLabel Style="visibility: hidden" Component="IsActive" Text="Is Active?" />
                                    </RadzenStack>
                                </Template>
                                <EditTemplate Context="c">
                                    <RadzenStack AlignItems="AlignItems.Start" Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.NoWrap">
                                        <RadzenSwitch @bind-Value="c.IsActive" Disabled="@(!c.InnateCode.IsActive)" Name="IsActive" />
                                        <RadzenLabel Style="visibility: hidden" Component="IsActive" Text="Is Active?" />
                                    </RadzenStack>
                                </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="InnateCodeTask" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="8rem" MinWidth="10px" Title="Actions">
                            <Template Context="c">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(c))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(c))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" Disabled="@(tasksWithBookings.Contains(c.InnateCodeTaskId))" />
                            </Template>
                            <EditTemplate Context="c">
                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(c))" MouseEnter="@(args => ShowTooltip(args, "Save"))"/>
                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(c))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))"/>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </EditForm>
        </RadzenCard>
    }
</div>

</FeatureCheckComponent>