@page "/splittask/{ProjectId:int}/{SubTaskId:int}"
@inherits BasePage
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Pages.Components
@using PPMTool.Services

<div class="row">
    <div class="col">
        <h1>Split Task @originalAddTaskComponent?.TaskModel.Name</h1>
    </div>
</div>

@if (!EditAuthorised)
{
    <div class="row">
        <ProjectManagerOnlyComponent />
    </div>
}
<hr />

<RadzenStack Gap="1rem" Orientation="Radzen.Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenText TextStyle="TextStyle.Body1">This task currently runs from <b>@originalAddTaskComponent?.TaskModel.StartDate.ToShortDateString()</b> to <b>@originalAddTaskComponent?.TaskModel.EndDate.ToShortDateString()</b></RadzenText>
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.Body1">Choose how to split the task:</RadzenText>
        <RadzenSelectBar TValue="bool" @bind-Value="@splitOnDate" Change="@SelectedSplitLogicChanged">
            <Items>
                <RadzenSelectBarItem Text="Date" Value="true" />
                <RadzenSelectBarItem Text="Days" Value="false" />
            </Items>
        </RadzenSelectBar>
    </RadzenStack>
    @if(splitOnDate)
    {
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.Body1">First day of the new task:</RadzenText>
            <RadzenDatePicker ShowTime="false" DateFormat="dd/MM/yyyy" @bind-Value="@splitDate" Change="@(args => SplitDateChanged(null))" />
        </RadzenStack>
    }
    else
    {
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.Body1">Number of days retained in original task:</RadzenText>
            <RadzenNumeric TValue="double?" @bind-Value="@splitValue" Min="@Convert.ToDecimal(0.5)" Step="0.5" Change="@(args => SplitValueChanged(null))" />
            <RadzenText TextStyle="TextStyle.Body1">days</RadzenText>
        </RadzenStack>
    }
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
        <RadzenText TextStyle="TextStyle.Body1">Choose how to share the actuals:</RadzenText>
        <RadzenSelectBar TValue="ActualsLogic" @bind-Value="@selectedActualsLogic" Change="@SelectedSplitLogicChanged">
            <Items>
                <RadzenSelectBarItem Text="Overflow to Split Task" Value="ActualsLogic.Overflow" />
                <RadzenSelectBarItem Text="Divide by Split Proportion" Value="ActualsLogic.Divide" />
                <RadzenSelectBarItem Text="Leave All on Original" Value="ActualsLogic.Leave" />
            </Items>
        </RadzenSelectBar>
    </RadzenStack>
</RadzenStack>
<hr />
@if (errorMessage != null)
{
    <div class="row">
        <StatusMessageComponent Message="errorMessage" />
    </div>
}
@if (warningMessage != null)
{
    <div class="row">
        <StatusMessageComponent Message="warningMessage" />
    </div>
}
@if(errorMessage != null || warningMessage != null)
{
    <hr />
}

<div class="row">
    <div class="col-6">
        <AddTask @ref="@originalAddTaskComponent" IsSplit="true" ProjectId="@ProjectId" TaskId="@(SubTaskId ?? 0)" />
    </div>
    <div class="col-6 vr">
        <AddTask @ref="@newAddTaskComponent" IsSplit="true" IsCopy="true" ProjectId="@ProjectId" TaskId="@(SubTaskId ?? 0)" />
    </div>
</div>
<hr />

<div class="row">
    <div class="col-auto">
        <RadzenButton Click="UpdateSubTasks" Text="Update" Icon="refresh" />
    </div>
    <div class="col"></div>
    <div class="col-auto">
        <RadzenStack JustifyContent="JustifyContent.End" Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem" Style="width:100%">
            <RadzenButton Click="UpdateAndSave" Text="Update & Save" Icon="check" Disabled=!EditAuthorised />
            <RadzenButton ButtonStyle="ButtonStyle.Danger" Click="DiscardChanges" Text="Discard" Icon="close" />
        </RadzenStack>
    </div>
</div>
<hr />