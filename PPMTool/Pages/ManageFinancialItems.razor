@page "/managefinancialitems"
@inherits BasePage
@using PPMTool.Data.Entities
@using Radzen
<PageTitle>Payments and Invoices - CapX</PageTitle>

<div class="container">
    <div class="row align-items-center">
        <div class="col mr-auto">
            <h1>Payments and Invoices</h1>
            <RadzenText Text="@(selectedProject?.GetFullName() ?? "All Projects")" TextStyle="TextStyle.Subtitle1" />
        </div>
        <div class="col-auto">
            <RadzenButton Icon="add" Text="Add" Click="AddPaymentOrInvoice" />
        </div>
    </div>
    <hr />
    <div class="card">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenText Text="Project:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0;" />
            <RadzenDropDown AllowClear="true"
                            AllowFiltering="true"
                            AllowSelectAll="false"
                            Data="@projects"
                            @bind-Value="selectedProject"
                            Change="@(args => OnProjectChange(args))"
                            Multiple="false"
                            Placeholder="Select Project"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            FilterOperator="StringFilterOperator.Contains"
                            class="radzen-dropdown"
                            LoadData="LoadProjectDropdownWithFilter">
                <Template>
                    @((context as Project)?.GetFullName())
                </Template>
            </RadzenDropDown>
            <RadzenButton Click="@(args => GoToProjectDetails())" Text="Project" Icon="info" Disabled="@(selectedProject == null)" />
        </RadzenStack>
        <RadzenTabs>
            <Tabs>
                <RadzenTabsItem Text="Invoices">
                    <RadzenDataGrid Data="@invoices" TItem="Invoice">
                        <Columns>
                            <RadzenDataGridColumn TItem="Invoice" Property="InvoiceId" Title="Invoice ID" />
                            <RadzenDataGridColumn TItem="Invoice" Property="Project.RTP" Title="RTP" />
                            <RadzenDataGridColumn TItem="Invoice" Property="KeyDate" Title="Invoice Date" />
                            <RadzenDataGridColumn TItem="Invoice" Property="Value" Title="Amount" />
                            <RadzenDataGridColumn TItem="Invoice" Property="InvoiceReference" Title="Reference" />
                            <RadzenDataGridColumn TItem="Invoice" Property="InvoiceStatus" Title="Status" />
                            <RadzenDataGridColumn TItem="Invoice" Property="Description" Title="Notes" />
                            <RadzenDataGridColumn TItem="Invoice" Context="invoice" Title="Actions">
                                <Template Context="invoice">
                                    <RadzenButton Text="Edit" Click="@(args => EditPaymentOrInvoice(invoice))" />
                                    <RadzenButton Text="View" Click="@(args => ViewInvoiceDocumentAsync(invoice))" Disabled="@(string.IsNullOrWhiteSpace(invoice.InvoiceUrl))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Payments">
                    <RadzenDataGrid Data="@payments" TItem="Payment">
                        <Columns>
                            <RadzenDataGridColumn TItem="Payment" Property="PaymentId" Title="Payment ID" />
                            <RadzenDataGridColumn TItem="Invoice" Property="Project.RTP" Title="RTP" />
                            <RadzenDataGridColumn TItem="Payment" Property="KeyDate" Title="Payment Date" />
                            <RadzenDataGridColumn TItem="Payment" Property="Value" Title="Amount" />
                            <RadzenDataGridColumn TItem="Invoice" Property="Description" Title="Notes" />
                            <RadzenDataGridColumn TItem="Payment" Property="Invoice.InvoiceId" Title="Associated Invoice" />
                            <RadzenDataGridColumn TItem="Payment" Context="payment" Title="Actions">
                                <Template Context="payment">
                                    <RadzenButton Text="Edit" Click="@(args => EditPaymentOrInvoice(payment))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </div>
</div>