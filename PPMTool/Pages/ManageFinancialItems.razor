@page "/managefinancialitems"
@inherits BasePage
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Pages.Components
@using Radzen
@using DotNetExtensions
<PageTitle>Payments and Invoices - CapX</PageTitle>

<div class="container">
    <div class="row align-items-center">
        <div class="col mr-auto">
            <h1>Payments and Invoices</h1>
            <RadzenText Text="@(selectedProject?.GetFullName() ?? "All Projects")" TextStyle="TextStyle.Subtitle1" />
        </div>
        <div class="col-auto">
            <RadzenButton Click="@(args => GoToFinanceSummary())" Text="Summary" Icon="list" />
        </div>
    </div>
    @if (selectedProject == null)
    {
        <HintComponent Message="Selected a project to be able to add an item or navigate to that project's details page" />
    }
    <hr />
    <div class="card">
        <div class="row">
            <div class="col-auto align-content-center">
                <RadzenText Text="Project:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0;" />
            </div>
            <div class="col align-content-center">
                <RadzenDropDown AllowClear="true"
                                AllowFiltering="true"
                                AllowSelectAll="false"
                                Data="@projects"
                                @bind-Value="selectedProject"
                                Change="@(args => OnProjectChange(args))"
                                Multiple="false"
                                Placeholder="Select Project"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                FilterOperator="StringFilterOperator.Contains"
                                class="radzen-dropdown"
                                LoadData="LoadProjectDropdownWithFilter">
                    <Template>
                        @((context as Project)?.GetFullName())
                    </Template>
                </RadzenDropDown>
            </div>
            <div class="col-auto align-content-center">
                <RadzenButton Click="@(args => GoToProjectDetails())" Text="View Project" Icon="info" Disabled="@(selectedProject == null)" />
            </div>
        </div>
        @if (selectedProject != null)
        {
            <hr />
            <div class="row">
                <div class="col align-content-center">
                    <ProjectDetailsSummaryComponent FinanceSummaryItem="@financeSummaryItem" />
                </div>
            </div>
            <hr />
        }
        <div class="row align-items-center">
            <div class="col">
                <h2>Finance Items</h2>
            </div>
            <div class="col-auto align-content-end">
                <RadzenButton ButtonType="ButtonType.Button" Click="ExportFinanceItems" Text="Export" Icon="download" Disabled="@(!EditAuthorised || exportRunning)" class="mr-2" />
                <RadzenButton Icon="add" Text="Add" Click="@(() => AddOrEditPaymentOrInvoice(null))" Disabled="@(selectedProject == null)" />
            </div>
        </div>
        <RadzenTabs @bind-SelectedIndex="selectedTab">
            <Tabs>
                <RadzenTabsItem Text="Invoices">
                    <RadzenDataGrid Data="@invoices"
                                    TItem="Invoice"
                                    ColumnWidth="5rem"
                                    FilterMode="FilterMode.Simple"
                                    AllowSorting="true"
                                    AllowFiltering="true"
                                    PageSize="10"
                                    AllowPaging="true"
                                    @ref="@dataGridInvoices">
                        <Columns>
                            <RadzenDataGridColumn TItem="Invoice" Property="InvoiceId" Title="Invoice ID" MinWidth="10px" Width="3rem" />
                            <RadzenDataGridColumn TItem="Invoice" Property="InvoiceReference" Title="Reference" MinWidth="10px" />
                            <RadzenDataGridColumn TItem="Invoice" Property="Project.RTP" Title="RTP" MinWidth="10px" Width="3rem" />
                            <RadzenDataGridColumn TItem="Invoice" Property="KeyDate" Title="Invoice Date" FormatString="{0:d}" MinWidth="10px" />
                            <RadzenDataGridColumn TItem="Invoice" Property="Value" Title="Amount" FormatString="{0:C0}" MinWidth="10px" />
                            <RadzenDataGridColumn TItem="Invoice" Title="Received" MinWidth="10px" Filterable="false" Sortable="false">
                                <Template Context="invoice">
                                    @invoice.Payments.Sum(x => x.Value).ToString("C0")
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Invoice" Property="Status" Title="Status" MinWidth="10px" Width="6rem">
                                <Template Context="invoice">
                                    <RadzenBadge Text="@invoice.Status.GetDescription()" BadgeStyle="@invoice.Status.GetBadgeStyle()" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Invoice" Property="Description" Title="Notes" MinWidth="10px" Width="10rem">
                                <Template Context="invoice">
                                    <p style="white-space:pre-wrap; margin-bottom:0;">@invoice.Description</p>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Invoice" Title="Actions" MinWidth="10px">
                                <Template Context="invoice">
                                    <RadzenButton Icon="edit" Click="@(args => AddOrEditPaymentOrInvoice(invoice))" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                                    <RadzenButton Icon="visibility" Click="@(args => ViewInvoiceDocumentAsync(invoice))" Disabled="@(string.IsNullOrWhiteSpace(invoice.InvoiceUrl))" MouseEnter="@(args => ShowTooltip(args, "View"))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenTabsItem>
                <RadzenTabsItem Text="Payments">
                    <RadzenDataGrid Data="@payments"
                                    TItem="Payment"
                                    ColumnWidth="5rem"
                                    FilterMode="FilterMode.Simple"
                                    AllowSorting="true"
                                    AllowFiltering="true"
                                    class="white-space:pre-wrap"
                                    PageSize="10"
                                    AllowPaging="true"
                                    @ref="@dataGridPayments">
                        <Columns>
                            <RadzenDataGridColumn TItem="Payment" Property="PaymentId" Title="Payment ID" MinWidth="10px" Width="3rem" />
                            <RadzenDataGridColumn TItem="Payment" Property="Invoice.InvoiceId" Title="Associated Invoice" MinWidth="10px" Width="3rem">
                                <Template Context="payment">
                                    @(payment.Invoice == null ? "-" : payment.Invoice.InvoiceId)
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Invoice" Property="Project.RTP" Title="RTP" MinWidth="10px" Width="3rem"/>
                            <RadzenDataGridColumn TItem="Payment" Property="KeyDate" Title="Payment Date" FormatString="{0:d}" MinWidth="10px" />
                            <RadzenDataGridColumn TItem="Payment" Property="Value" Title="Amount" FormatString="{0:C0}" MinWidth="10px" />
                            <RadzenDataGridColumn TItem="Payment" Property="Description" Title="Notes" MinWidth="10px" Width="10rem">
                                <Template Context="payment">
                                    <p style="white-space:pre-wrap; margin-bottom:0;">@payment.Description</p>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="Payment" Title="Actions" MinWidth="10px" Width="2rem">
                                <Template Context="payment">
                                    <RadzenButton Icon="edit" Click="@(args => AddOrEditPaymentOrInvoice(payment))" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    </div>
</div>