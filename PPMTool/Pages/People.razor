@page "/people"
@inherits BasePage
@using PPMTool.Enums
@using PPMTool.Data.Entities

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>People</h1>
        </div>
        <div class="col-auto">
            <RadzenButton Text="Add" Icon="add" Click="@AddPerson" Disabled=!EditAuthorised />
        </div>
        <div class="col-auto">
            <RadzenButton Text="Tags" Icon="style" Click="@ManageSkills" Disabled=!EditAuthorised />
        </div>
    </div>
    <hr />
    <div class="card">
        @if (people == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <RadzenDataGrid AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.Simple"
                            AllowSorting="true"
                            Data="@people"
                            TItem="Person"
                            ColumnWidth="150px"
                            SelectionMode="DataGridSelectionMode.Single"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            AllowPaging="true"
                            PageSize="@pageCount"
                            PagerHorizontalAlign="HorizontalAlign.Left"
                            ShowPagingSummary="true"
                            Count="@count"
                            LoadData="@LoadData">
                <Columns>
                    <RadzenDataGridColumn TItem="Person" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="60px">
                        <Template Context="p">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => EditPerson(p))" @onclick:stopPropagation="true" Disabled=!EditAuthorised>
                            </RadzenButton>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Person" Property="Name" Title="Name" Frozen="true" FilterOperator="FilterOperator.Contains" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="ShortName" Title="Initials" FilterOperator="FilterOperator.StartsWith" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="DayRate" Title="Day Rate" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="StartDate" Title="Started" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="EndDate" Title="Left" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="FTE" Title="FTE" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="AvailabilityChanges" Title="Availability Changes" Sortable="false" MinWidth="10px">
                        <Template Context="p">
                            @string.Join(" | ", p.AvailabilityChanges.Select(d => $"{d.ChangeDate.ToShortDateString()} to {d.AvailabilityFTE}"))
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Person" Property="SkillTags" Title="Skills" Sortable="false" MinWidth="10px">
                        <Template Context="p">
                            @string.Join(',', p.SkillTags.Select(t => t.Name))
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </div>
</div>
