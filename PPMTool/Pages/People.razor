@page "/people"
@inherits BasePage
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>People</h1>
        </div>
        <div class="col-auto">
            <RadzenButton Text="Add" Icon="add" Click="@AddPerson" Disabled=!EditAuthorised />
        </div>
        <div class="col-auto">
            <RadzenButton Text="Tags" Icon="style" Click="@ManageSkills" Disabled=!EditAuthorised />
        </div>
    </div>
    <hr />
    @if (EditAuthorised)
    {
        <div class="row">
            <div class="col">
                <h2>Absent Today</h2>
            </div>
        </div>
        <div class="row">
            <div class="col">
                @if (currentAbsences == null)
            {
                <LoadingComponent />            
            }
            else if (currentAbsences.Count() == 0)
            {
                <RadzenText Text="There is no-one currently absent." />
            }
            else
            {
                foreach (var absence in currentAbsences.OrderBy(x => x.EndDate))
                {
                    <AbsenceSummaryComponent Absence="absence" EditPerson="@((person) => EditAbsence(person))" />
                }
            }
                </div>
            </div>
        <hr/>
    }
    <div class="row">
        <div class="col">
            <h2>All People</h2>
        </div>
    </div>
    <div class="card">
        @if (people == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <RadzenDataGrid AllowFiltering="@(people != null && people.Count() > 0)"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.Simple"
                            AllowSorting="true"
                            Data="@people"
                            TItem="Person"
                            ColumnWidth="150px"
                            SelectionMode="DataGridSelectionMode.Single"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            AllowPaging="true"
                            PageSize="@pageCount"
                            PagerHorizontalAlign="HorizontalAlign.Left"
                            ShowPagingSummary="true"
                            Count="@count"
                            LoadData="@LoadData">
                <Columns>
                    <RadzenDataGridColumn TItem="Person" Property="Name" Title="Name" Frozen="true" FilterOperator="FilterOperator.Contains" MinWidth="10px">
                        <Template Context="p">
                            <span style="display: flex; align-items: center">
                                @if (p.IsCurrentlyAbsent())
                                {
                                    <RadzenIcon Style="margin-right: 5px" Icon="info" IconStyle="IconStyle.Info" title=@($"Person is currently absent!") />
                                }
                                @p.Name
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Person" Property="ShortName" Title="Initials" Width="80px" FilterOperator="FilterOperator.StartsWith" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="StartDate" Title="Started" Width="80px" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="EndDate" Title="Left" Width="80px" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="FTE" Title="FTE" Width="50px" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="AvailabilityChanges" Title="Availability Changes" Sortable="false" MinWidth="10px">
                        <Template Context="p">
                            @string.Join(" | ", p.AvailabilityChanges.Select(d => $"{d.ChangeDate.ToShortDateString()} to {d.AvailabilityFTE}"))
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Person" Property="SkillTags" Title="Skills" Sortable="false" MinWidth="10px">
                        <Template Context="p">
                            @string.Join(',', p.SkillTags.Select(t => t.Name))
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Person" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="60px" FrozenPosition="FrozenColumnPosition.Right" Title="Edit">
                        <Template Context="p">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => EditPerson(p))" @onclick:stopPropagation="true" Disabled=!EditAuthorised MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </div>
</div>
