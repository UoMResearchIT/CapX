@page "/people"
@inherits BasePage
@using PPMTool.Enums

<div class="container">
    <h1>People</h1>
    <a class="btn btn-primary" href="/addperson"><i class="oi oi-plus" /></a>
    <div class="card">
        @if (people == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <table class="table table-responsive table-striped table-hover">
                <thead>
                    <tr>
                        <th class="sort-th" @onclick="@(() => SortTable("Name"))">
                            Name
                            <span class="fa @(SetSortIcon("Name"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("ShortName"))">
                            Short Name
                            <span class="fa @(SetSortIcon("ShortName"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("HourlyRate"))">
                            Hourly Rate
                            <span class="fa @(SetSortIcon("HourlyRate"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("AvailabilityFTE"))">
                            Maximum FTE
                            <span class="fa @(SetSortIcon("AvailabilityFTE"))"></span>
                        </th>
                        <th class="sort-th" @onclick="@(() => SortTable("NextAvailable"))">
                            Next Available
                            <span class="fa @(SetSortIcon("NextAvailable"))"></span>
                        </th>
                        <th class="sort-th">Skills</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in people)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.ShortName</td>
                            <td>£@p.HourlyRate</td>
                            <td>@p.AvailabilityFTE</td>
                            <td>@p.NextAvailable.ToShortDateString()</td>
                            <td>@string.Join(',', p.SkillTags.Select(t => t.Name))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
