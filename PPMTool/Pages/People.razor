@page "/people"
@inherits BasePage
@using PPMTool.Enums

<div class="container">
    <h1>People</h1>
    <a class="btn btn-primary" href="/addperson"><i class="oi oi-plus" /></a>
    <div class="card">
        <label>Sort By:</label>
        <select class="form-select form-select-sm" @bind="@SortingOption">
            @foreach (var item in sortAndFilterOptions)
            {
                <option value="@item">@item.ToNiceString()</option>
            }
        </select>
    </div>
    <div class="card">
        @if (people == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <table class="table table-responsive table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Short Name</th>
                        <th>Hourly Rate</th>
                        <th>Maximum FTE</th>
                        <th>Next Available</th>
                        <th>Skills</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in people)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.ShortName</td>
                            <td>£@p.HourlyRate</td>
                            <td>@p.AvailabilityFTE</td>
                            <td>@p.NextAvailable.ToShortDateString()</td>
                            <td>@string.Join(',', p.SkillTags.Select(t => t.Name))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
