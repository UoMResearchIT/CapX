@page "/people"
@inherits BasePage
@using PPMTool.Data.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
<PageTitle>People - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>People</h1>
        </div>
        <div class="col-auto">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenText Text="Show Leavers" Style="margin-bottom: 0.1rem" />
                <RadzenSwitch @bind-Value="@IncludeLeavers" Disabled="@(Loading || ActiveUserRoleType == RoleType.Developer)" />
                <RadzenButton Text="Add" Icon="add" Click="@AddPerson" Disabled="@(!EditAuthorised || Loading)" />
            </RadzenStack>
        </div>
    </div>
    <hr />
    <RadzenCard>
        @if (Loading)
        {
            <LoadingComponent />
        }
        else if (people == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <RadzenDataGrid AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.Simple"
                            AllowSorting="true"
                            Data="@people"
                            TItem="Person"
                            ColumnWidth="150px"
                            SelectionMode="DataGridSelectionMode.Single"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            LogicalFilterOperator="LogicalFilterOperator.And"
                            AllowPaging="true"
                            PageSize="@PageCount"
                            ShowPagingSummary="true"
                            PageSizeOptions="@PageSizeOptions"
                            PagerHorizontalAlign="HorizontalAlign.Left"
                            PagerPosition="PagerPosition.TopAndBottom"
                            PageSizeChanged="@OnPageSizeChangedAsync"
                            Count="@count"
                            LoadData="@LoadData">
                <Columns>
                    <RadzenDataGridColumn TItem="Person" Property="Name" Title="Name" Frozen="true" FilterOperator="FilterOperator.Contains" MinWidth="10px">
                        <Template Context="p">
                            <span style="display: flex; align-items: center">
                                @if (p.IsCurrentlyAbsent())
                                {
                                    <RadzenIcon Style="margin-right: 5px" Icon="info" IconStyle="IconStyle.Info" title=@($"Person is currently absent!") />
                                }
                                @p.Name
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Person" Property="ShortName" Title="Initials" Width="80px" FilterOperator="FilterOperator.Contains" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="Person" Property="LineManager.Name" Title="Line Manager" FilterProperty="LineManager.Name" SortProperty="LineManager.Name" MinWidth="10px">
                        <Template Context="p">
                            <span style="display: flex; align-items: center">
                                @if (p.LineManager?.IsCurrentlyAbsent() ?? false)
                                {
                                    <RadzenIcon Style="margin-right: 5px" Icon="info" IconStyle="IconStyle.Info" title=@($"Line manager is currently absent!") />
                                }
                                @(p?.LineManager?.Name ?? "Not Set")
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Person" Property="StartDate" Title="Started" Width="80px" FormatString="{0:d}" MinWidth="10px" Filterable="false" />
                    <RadzenDataGridColumn TItem="Person" Property="EndDate" Title="Left" Width="80px" FormatString="{0:d}" MinWidth="10px" Filterable="false" />
                    <RadzenDataGridColumn TItem="Person" Property="WorkloadModelChanges" Title="Current Project Work FTE" Width="50px" MinWidth="10px" Sortable="false" Filterable="false">
                        <Template Context="p">
                            @p.WorkloadModelChanges.Where(x => x.ChangeDate <= DateTime.Today).OrderBy(x => x.ChangeDate).LastOrDefault()?.ProjectWorkFTE
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Person" Property="CurrentGrade" Title="Current Grade" Width="50px" MinWidth="10px" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="p">
                            @p.CurrentGrade
                        </Template>
                    </RadzenDataGridColumn>
                    @if (skillsEnabled)
                    {
                        <RadzenDataGridColumn TItem="Person" Property="SkillTags" Title="Skills" Sortable="false" MinWidth="10px">
                            <Template Context="p">
                                @string.Join(", ", p.OwnedSkills.Select(t => t.SkillTag.Name).OrderBy(x => x))
                            </Template>
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn TItem="Person" Property="SkillsCount" Title="Skill Count" Width="3rem" MinWidth="10px" Filterable="false">
                            <Template Context="p">
                                @TagService.GetCountForPerson(Context, p.PersonId).ToString()
                            </Template>
                        </RadzenDataGridColumn>
                    }
                    <RadzenDataGridColumn TItem="Person" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="100px" FrozenPosition="FrozenColumnPosition.Right" Title="Action">
                        <Template Context="p">
                            <EditOrViewButtonComponent CanViewOnly="@(ActiveUser?.Person?.PersonId == p.PersonId || (ActiveUserRoleType == RoleType.Manager && !IsSuperuserOrLineManagerOfThisPerson(p)))"
                                                       IsDisabled="@(!(ActiveUser?.Person?.PersonId == p.PersonId || ActiveUserRoleType == RoleType.Manager || ActiveUserRoleType == RoleType.Superuser))"
                                                       OnButtonClick="@(canView => EditPerson(p))"
                                                       ShowTooltip="@((args, message) => ShowTooltip(args, message))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>
</div>
