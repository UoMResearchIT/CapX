@page "/people/addavailabilitychange/{PersonId:int}"
@inherits AddPersonProperty<WorkloadModelChange>
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
<PageTitle>Add WLM Change - CapX</PageTitle>

<div class="container">
    @if (personModel != null)
    {
        <h1>Workload Model Changes</h1>
        <RadzenText Text="@personModel.Name" TextStyle="TextStyle.DisplayH5" />
        <hr />
        <RadzenCard>
            <EditForm Model="@personModel">
                <DataAnnotationsValidator />
                <div class="row">
                    <div class="col align-content-center mb-2">
                        <RadzenButton class="float-right" Text="Add" Icon="add" Click="@InsertRow" Disabled=@(entityToInsert != null || entityToUpdate != null || !EditAuthorised) />
                    </div>
                </div>
                <RadzenDataGrid @ref="dataGrid"
                                AllowFiltering="@(dataGridEntities != null && dataGridEntities.Count > 0)"
                                AllowSorting="true"
                                EditMode="DataGridEditMode.Single"
                                FilterMode="FilterMode.Simple"
                                Data="@dataGridEntities"
                                TItem="WorkloadModelChange"
                                RowUpdate="@OnUpdateRow"
                                RowCreate="@OnCreateRow"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                    <Columns>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="ChangeDate" Title="Date of Change" Width="160px" MinWidth="10px">
                            <Template Context="c">
                                @c.ChangeDate.ToShortDateString()
                            </Template>
                            <EditTemplate Context="c">
                                <RadzenDatePicker @bind-Value="c.ChangeDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="Grade" Title="Grade" Width="80px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenNumeric class="radzen-numeric" TValue="int" Min="4" Step="1" Max="9" @bind-Value="c.Grade" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="ProjectWorkFTE" Title="Project" Width="80px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="c.ProjectWorkFTE" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="BusinessAsUsualFTE" Title="BAU" Width="80px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="c.BusinessAsUsualFTE" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="PersonalDevelopmentFTE" Title="PD" Width="80px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="c.PersonalDevelopmentFTE" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="StaffManagementFTE" Title="Staff" Width="80px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="c.StaffManagementFTE" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="ProjectManagementFTE" Title="PM" Width="80px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="c.ProjectManagementFTE" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="ServiceManagementFTE" Title="SM" Width="80px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="c.ServiceManagementFTE" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="ProjectAndServiceManagementFTE" Title="PSM" Width="80px" MinWidth="10px" />
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="ArchitectureFTE" Title="RSA" Width="80px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.001" Max="@Convert.ToDecimal(1.0)" @bind-Value="c.ArchitectureFTE" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Title="Total" Width="80px" MinWidth="10px">
                            <Template Context="c">
                                @c.Total().ToString("F1")
                            </Template>
                            </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Property="Notes" Title="Notes" Width="350px" MinWidth="10px">
                            <EditTemplate Context="c">
                                <RadzenTextBox class="no-margin" TValue="string" @bind-Value="c.Notes" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="WorkloadModelChange" Filterable="false" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center" Width="8rem" MinWidth="10px" Title="Actions">
                            <Template Context="c">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(c))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" Disabled="@(!EditAuthorised)" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(c))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" Disabled="@(!EditAuthorised)" />
                            </Template>
                            <EditTemplate Context="c">
                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(c))" MouseEnter="@(args => ShowTooltip(args, "Save"))" />
                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(c))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))" />
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </EditForm>
        </RadzenCard>
    }
</div>