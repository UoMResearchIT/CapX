@page "/addavailabilitychange/{PersonId:int}"
@inherits BasePage

<div class="container">
    @if (personModel != null)
    {
        <h1>Availability Changes</h1>
        <div class="card">
            <h2>Add New Change</h2>
            <EditForm Model="@changeModel" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <div class="col-3">
                        <label for="ChangeDate">Date of Change</label>
                    </div>
                    <div class="col">
                        <InputDate @bind-Value="changeModel.ChangeDate" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <label for="AvailabilityFTE">New FTE</label>
                    </div>
                    <div class="col">
                        <InputNumber min="0.0" step="0.001" @bind-Value="changeModel.AvailabilityFTE" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-3">
                        <label for="BaselineActivities">Availability Notes</label>
                    </div>
                    <div class="col">
                        <InputText @bind-Value="changeModel.BaselineActivities" />
                    </div>
                </div>
                <div>
                    <button class="btn btn-primary" type="submit"><i class="oi oi-check" /> Add</button>
                </div>
            </EditForm>
        </div>
        <hr />
        <div class="card">
            <h2>Current Changes to Default Availability</h2>
            @if (changeList.Count > 0)
            {
                <table class="table table-sm table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Change Date</th>
                            <th>New FTE</th>
                            <th>Notes</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in changeList)
                        {
                            <tr>
                                <td>@change.ChangeDate.ToShortDateString()</td>
                                <td>@change.AvailabilityFTE</td>
                                <td>@change.BaselineActivities</td>
                                <td><button class="btn btn-danger" @onclick=@(args => DeleteChange(change.AvailabilityChangeId))><i class="oi oi-trash" /> Delete</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="card-body">
                    <i>
                        No data available
                    </i>
                </div>
            }
        </div>
    }
</div>