@page "/addavailabilitychange/{PersonId:int}"
@inherits BasePage

<div class="container">
    @if (personModel != null)
    {
        <h1>Availability Changes</h1>
        <div class="card">
            <h2>Add New Change</h2>
            <EditForm Model="@changeModel" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="Date of Change" /><br />
                        <RadzenDatePicker @bind-Value="changeModel.ChangeDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                    </div>
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="New FTE" /><br />
                        <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.001" @bind-Value="changeModel.AvailabilityFTE" />
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="Baseline Activity Description" /><br />
                        <RadzenTextBox TValue="string" @bind-Value="changeModel.BaselineActivities" />
                    </div>
                </div>
                <div>
                    <RadzenButton Text="Add" Icon="check" ButtonType="ButtonType.Submit" />
                </div>
            </EditForm>
        </div>
        <hr />
        <div class="card">
            <h2>Current Changes to Default Availability</h2>
            @if (changeList.Count > 0)
            {
                <table class="table table-sm table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Change Date</th>
                            <th>New FTE</th>
                            <th>Baseline Activity</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in changeList)
                        {
                            <tr>
                                <td>@change.ChangeDate.ToShortDateString()</td>
                                <td>@change.AvailabilityFTE</td>
                                <td>@change.BaselineActivities</td>
                                <td><RadzenButton ButtonStyle="ButtonStyle.Danger" Click=@(args => DeleteChange(change.AvailabilityChangeId)) Text="Delete" Icon="delete"/></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="card-body">
                    <i>
                        No data available
                    </i>
                </div>
            }
        </div>
    }
</div>