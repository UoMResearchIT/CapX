@page "/addperson/{PersonId:int}"
@inherits BasePage

<div class="container">
    <h1>Add Person</h1>
    <div class="card">
        <EditForm Model="@personModel" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row">
                <div class="col-3">
                    <label for="Name">Name</label>
                </div>
                <div class="col">
                    <InputText @bind-Value="personModel.Name" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="ShortName">Initials</label>
                </div>
                <div class="col">
                    <InputText @bind-Value="personModel.ShortName" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="HourlyRate">Hourly Cost (£ / hour)</label>
                </div>
                <div class="col">
                    <InputNumber min="0.0" step="0.01" placeholder="0.00" @bind-Value="personModel.HourlyRate" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="AvailabilityFTE">Availability (FTE)</label>
                </div>
                <div class="col">
                    <InputNumber min="0.0" max="1.0" step="0.01" @bind-Value="personModel.AvailabilityFTE" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="StartDate">Start Date</label>
                </div>
                <div class="col">
                    <InputDate @bind-Value="personModel.StartDate" />
                </div>
            </div>
            <hr />
            <h3>Skill Tags</h3>
            @foreach (var t in AvailableTags)
            {
                <div class="row">
                    <div class="col-2">
                        @t.Name
                    </div>
                    <div class="col my-1" style="display: flex">
                        <RadzenSwitch @bind-Value="t.Checked" />
                    </div>
                    <br />
                </div>
            }
            <button class="btn btn-primary" type="submit"><i class="oi oi-check" /></button>
        </EditForm>
    </div>
</div>