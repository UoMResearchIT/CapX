@page "/addperson/{PersonId:int}"
@inherits BasePage
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components

<div class="container">
    <div class="row">
        <div class="col mr-auto">
            @if (personModel == null)
            {
                <h1>Add Person</h1>
            }
            else
            {
                <h1>Edit <i>@personModel.Name</i></h1>
                <hr />
                <MessageSummaryComponent Messages="personModel.GetLatestStatusMessages()" />
            }
        </div>
    </div>
    <hr />

    <div class="card">
        <EditForm EditContext="editContext" OnSubmit="@HandleSubmit">
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Name" /><br>
                    <RadzenTextBox TValue="string" @bind-Value="personModel.Name" />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Initials" /><br>
                    <RadzenTextBox TValue="string" @bind-Value="personModel.ShortName" />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Start Date" /><br>
                    <RadzenDatePicker @bind-Value="personModel.StartDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="End Date" /><br>
                    <RadzenDatePicker @bind-Value="personModel.EndDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Post FTE" Component="FTE" /><br>
                    <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Max="@Convert.ToDecimal(1.0)" Step="0.001" @bind-Value="personModel.FTE" />
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col">
                    <div class="row">
                        <div class="col-auto mr-auto py-2">
                            <h3>Skill Tags</h3>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-auto flexbox">
                            <RadzenIcon Icon="search" />
                        </div>
                        <div class="col flexbox pr-3 pl-0">
                        <RadzenAutoComplete
                            @bind-Value=@autoCompleteText
                            Placeholder="Search for Skill Tags to Add"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Data=@availableTags
                            TextProperty="Name"
                            Change=@OnChange
                            Style="width:100%" />
                        </div>
                    </div>
                    <div class="row">
                        <RadzenDataList
                            AllowVirtualization=true
                            class="full-height-list"
                            WrapItems="false"
                            AllowPaging="false"
                            Data="@chosenTags"
                            TItem="SkillTag">
                            <Template Context="tag">
                                <div class="row flexbox p-0">
                                    <div class="col">
                                        @tag.Name
                                    </div>
                                    <div class="col">
                                        @($"{tag.People?.Where(x => x.PersonId != personModel.PersonId)?.Count() ?? 0} other(s) with this tag")
                                    </div>
                                    <div class="col-auto">
                                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="clear" Click="@(args => OnDelete(tag))" MouseEnter="@(args => ShowTooltip(args, "Clear"))" />
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataList>
                    </div>
                </div>
                <div class="col">
                    <div class="row">
                        <div class="col-auto mr-auto py-2">
                            <h3>Workload Model Changes</h3>
                        </div>
                        <div class="col-auto">
                            <RadzenButton Text="Edit" Icon="edit" ButtonType="ButtonType.Button" Click="@(args => EditAvailability())" />
                        </div>
                    </div>
                    <hr />
                    <RadzenDataList AllowVirtualization=true
                                    class="half-height-list"
                                    WrapItems="false"
                                    AllowPaging="false"
                                    Data="@personModel.WorkloadModelChanges.OrderByDescending(x => x.ChangeDate)"
                                    TItem="WorkloadModelChange">
                        <Template Context="d">
                            <div style="width:100%">
                                <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenStack Orientation="Radzen.Orientation.Horizontal">
                                            <RadzenText Text="@d.ChangeDate.ToShortDateString()" TextStyle="TextStyle.Subtitle1" />
                                            <RadzenBadge Style="margin-bottom: 0.5rem; font-size: medium"
                                                         BadgeStyle="BadgeStyle.Info"
                                                         Text="@(d.Total().ToString("F1") + " FTE")" />
                                        </RadzenStack>
                                        <RadzenText Text="@d.Notes" TextStyle="TextStyle.Body2"/>
                                    </RadzenStack>
                                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceAround" AlignItems="AlignItems.Center">
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                            <RadzenText Text="Project Work" TextStyle="TextStyle.Subtitle1" />
                                            <RadzenText Text="BAU" TextStyle="TextStyle.Subtitle1" />
                                            <RadzenText Text="Personal Dev" TextStyle="TextStyle.Subtitle1" />
                                        </RadzenStack>
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                            <RadzenText Text="@d.ProjectWorkFTE.ToString()" />
                                            <RadzenText Text="@d.BusinessAsUsualFTE.ToString()" />
                                            <RadzenText Text="@d.PersonalDevelopmentFTE.ToString()" />
                                        </RadzenStack>
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                            <RadzenText Text="Staff" TextStyle="TextStyle.Subtitle1" />
                                            <RadzenText Text="Project and Service" TextStyle="TextStyle.Subtitle1" />
                                            <RadzenText Text="Architecture" TextStyle="TextStyle.Subtitle1" />
                                        </RadzenStack>
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                            <RadzenText Text="@d.StaffManagementFTE.ToString()" />
                                            <RadzenText Text="@d.ProjectAndServiceManagementFTE.ToString()" />
                                            <RadzenText Text="@d.ArchitectureFTE.ToString()" />
                                        </RadzenStack>
                                    </RadzenStack>
                                </RadzenStack>
                            </div>
                        </Template>
                    </RadzenDataList>
                    <br /><br />
                    <div class="row">
                        <div class="col-auto mr-auto py-2">
                            <h3>Absence</h3>
                        </div>
                        <div class="col-auto">
                            <RadzenButton Text="Edit" Icon="edit" ButtonType="ButtonType.Button" Click="@(args => EditAbsence())" />
                        </div>
                    </div>
                    <hr />
                    <RadzenDataList AllowVirtualization=true
                                    class="half-height-list"
                                    WrapItems="false"
                                    AllowPaging="false"
                                    Data="@personModel.Absences"
                                    TItem="Absence">
                        <Template Context="a">
                            <div class="row flexbox p-0">
                                <div class="col-3">
                                    @a.StartDate.ToShortDateString()
                                </div>
                                <div class="col-3">
                                    to
                                </div>
                                <div class="col-3">
                                    @(a.EndDate?.ToShortDateString() ?? "Not Set")
                                </div>
                            </div>
                        </Template>
                    </RadzenDataList>
                </div>
            </div>
            <DataAnnotationsValidator />
            <ValidationSummary />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="check" />
        </EditForm>
    </div>
</div>