@page "/addperson/{PersonId:int}"
@inherits BasePage
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components

<div class="container">
    <div class="row">
        <div class="col mr-auto">
            @if (personModel == null)
            {
                <h1>Add Person</h1>
            }
            else
            {
                <h1>Edit <i>@personModel.Name</i></h1>
                <hr />
                <MessageSummaryComponent Messages="personModel.GetLatestStatusMessages()" />
            }
        </div>
    </div>
    <hr />

    <div class="card">
        <EditForm EditContext="editContext" OnSubmit="@HandleSubmit">
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Name" /><br>
                    <RadzenTextBox TValue="string" @bind-Value="personModel.Name" />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Initials" /><br>
                    <RadzenTextBox TValue="string" @bind-Value="personModel.ShortName" />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Start Date" /><br>
                    <RadzenDatePicker @bind-Value="personModel.StartDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="End Date" /><br>
                    <RadzenDatePicker @bind-Value="personModel.EndDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Post FTE" Component="FTE" /><br>
                    <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Max="@Convert.ToDecimal(1.0)" Step="0.001" @bind-Value="personModel.FTE" />
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col">
                    <div class="row">
                        <div class="col-auto mr-auto py-2">
                            <h3>Skill Tags</h3>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-auto flexbox">
                            <RadzenIcon Icon="search" />
                        </div>
                        <div class="col flexbox pr-3 pl-0">
                        <RadzenAutoComplete
                            @bind-Value=@autoCompleteText
                            Placeholder="Search for Skill Tags"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Data=@availableTags
                            TextProperty="Name"
                            Change=@OnChange
                            Style="width:100%" />
                        </div>
                    </div>
                    <div class="row">
                        <RadzenDataList
                            AllowVirtualization=true
                            Style="min-height:120px; max-height:720px; overflow:auto; width:100%"
                            WrapItems="false"
                            AllowPaging="false"
                            Data="@chosenTags"
                            TItem="SkillTag">
                            <Template Context="tag">
                                <div class="row flexbox p-0">
                                    <div class="col">
                                        @tag.Name
                                    </div>
                                    <div class="col">
                                        @($"{tag.People.Count} other(s) with this tag")
                                    </div>
                                    <div class="col-auto">
                                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="clear" Click="@(args => OnDelete(tag))" MouseEnter="@(args => ShowTooltip(args, "Clear"))" />
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataList>
                    </div>
                </div>
                <div class="col">
                    <div class="row">
                        <div class="col-auto mr-auto py-2">
                            <h3>Availability Changes</h3>
                        </div>
                        <div class="col-auto">
                            <RadzenButton Text="Edit" Icon="edit" ButtonType="ButtonType.Button" Click="@(args => EditAvailability())" />
                        </div>
                    </div>
                    <hr />
                    <RadzenDataList AllowVirtualization=true
                                    Style="min-height:120px; max-height:360px; overflow:auto; height:auto; width:100%; margin-left:-1rem; margin-right: 1rem"
                                    WrapItems="false"
                                    AllowPaging="false"
                                    Data="@personModel.AvailabilityChanges"
                                    TItem="WorkloadModelChange">
                        <Template Context="d">
                            <div class="row flexbox p-0">
                                <div class="col-3">
                                    @d.ChangeDate.ToShortDateString()
                                </div>
                                <div class="col-3">
                                    @d.ProjectWorkFTE FTE
                                </div>
                                <div class="col-6">
                                    @d.BaselineActivities
                                </div>
                            </div>
                        </Template>
                    </RadzenDataList>
                </div>
            </div>
            <div class="row">
                <div class="col">
                </div>
                <div class="col">
                    <div class="row">
                        <div class="col-auto mr-auto py-2">
                            <h3>Absence</h3>
                        </div>
                        <div class="col-auto">
                            <RadzenButton Text="Edit" Icon="edit" ButtonType="ButtonType.Button" Click="@(args => EditAbsence())" />
                        </div>
                    </div>
                    <hr />
                    <RadzenDataList AllowVirtualization=true
                                    Style="min-height:120px; max-height:360px; overflow:auto; height:auto; width:100%; margin-left:-1rem; margin-right: 1rem"
                                    WrapItems="false"
                                    AllowPaging="false"
                                    Data="@personModel.Absences"
                                    TItem="Absence">
                        <Template Context="a">
                            <div class="row flexbox p-0">
                                <div class="col-3">
                                    @a.StartDate.ToShortDateString()
                                </div>
                                <div class="col-3">
                                    to
                                </div>
                                <div class="col-3">
                                    @(a.EndDate?.ToShortDateString() ?? "Not Set")
                                </div>
                            </div>
                        </Template>
                    </RadzenDataList>
                </div>
            </div>
            <DataAnnotationsValidator />
            <ValidationSummary />
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="check" />
        </EditForm>
    </div>
</div>