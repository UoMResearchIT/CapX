@page "/addperson/{PersonId:int}"
@inherits BasePage

<div class="container">
    <h1>Add Person</h1>
    <div class="card">
        <EditForm EditContext="editContext" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Name" /><br>
                    <RadzenTextBox TValue="string" @bind-Value="personModel.Name" />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Initials" /><br>
                    <RadzenTextBox TValue="string" @bind-Value="personModel.ShortName" />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Start Date" /><br>
                    <RadzenDatePicker @bind-Value="personModel.StartDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="End Date" /><br>
                    <RadzenDatePicker @bind-Value="personModel.EndDate" ShowTime="false" DateFormat="dd/MM/yyyy" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Post FTE" Component="FTE" /><br>
                    <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Max="@Convert.ToDecimal(0.84)" Step="0.001" @bind-Value="personModel.FTE" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Default Day Rate (£)" /><br>
                    <RadzenNumeric class="radzen-numeric" TValue="double" Min="0" Step="1" Placeholder="0" @bind-Value="personModel.DayRate" />
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="col">
                    <h3>Skill Tags</h3>
                    @foreach (var t in availableTags)
                    {
                        <div class="row">
                            <div class="col-6">
                                @t.Name
                            </div>
                            <div class="col-3 my-1" style="display: flex">
                                <RadzenSwitch class="switch-align" @bind-Value="t.Checked" />
                            </div>
                            <br />
                        </div>
                    }
                </div>
                <div class="col">
                    <div class="row">
                        <div class="col-auto mr-auto">
                            <h3>Availability Changes</h3>
                        </div>
                        <div class="col-auto">
                            <RadzenButton Text="Edit" Icon="edit" ButtonType="ButtonType.Button" Click="@(args => EditAvailability())" />
                        </div>
                    </div>
                    @foreach (var d in personModel.AvailabilityChanges)
                    {
                        <div class="row">
                            <div class="col-3">
                                @d.ChangeDate.ToShortDateString()
                            </div>
                            <div class="col-3">
                                @d.AvailabilityFTE
                            </div>
                            <div class="col-6">
                                <p>@d.BaselineActivities</p>
                            </div>
                            <br />
                        </div>
                    }
                </div>
            </div>
            <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="check" />
        </EditForm>
    </div>
</div>