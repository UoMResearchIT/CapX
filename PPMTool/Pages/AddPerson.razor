@page "/people/addperson/{PersonId:int}"
@inherits BasePage
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Pages.Components
<PageTitle>Add Person - CapX</PageTitle>

<div class="container">
    @if (Loading)
    {
        <LoadingComponent />
    }
    else if (!viewAuthorised)
    {
        <StatusMessageComponent Message="@(new StatusMessage("You are not permitted to view this page!", StatusMessage.MessageType.Error))" />
    }
    else
    {
        <div class="row">
            <div class="col mr-auto">
                @if (personModel == null)
                {
                    <h1>Add Person</h1>
                }
                else
                {
                    <div class="row align-items-center">
                        <div class="col">
                            <h1>Edit <i>@personModel.Name</i></h1>
                            <StatusMessageSummaryComponent Messages="personModel.GetLatestStatusMessages()" />
                        </div>
                        @if (PersonId > 0)
                        {
                            <div class="col-auto">
                                <RadzenButton ButtonStyle="ButtonStyle.Primary"
                                              ButtonType="ButtonType.Button"
                                              Click="@EditSkills"
                                              Text="@($"{(IsSuperuserOrLineManagerOrPerson(personModel) ? "Edit" : "View")} Skills")"
                                              Icon="@(IsSuperuserOrLineManagerOrPerson(personModel) ? "edit" : "visibility")"
                                              Disabled="@(ActiveUserRoleType != RoleType.Manager && !IsSuperuserOrLineManagerOrPerson(personModel))" />
                            </div>
                            <div class="col-auto">
                                <RadzenButton ButtonStyle="ButtonStyle.Primary" ButtonType="ButtonType.Button" Click="@ViewCapacity" Text="View Capacity" Icon="lists" />
                            </div>
                            <div class="col-auto">
                                <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Button" Click="@DeletePersonAsync" Text="Delete" Icon="delete" Disabled=!isSuperUser />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
        <hr />

        <RadzenCard>
            <EditForm EditContext="editContext">
                <div class="row">
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="Name" Component="Name" /><br>
                        <RadzenTextBox class="radzen-text-box" Name="Name" @bind-Value="personModel.Name" Disabled="!EditAuthorised" />
                    </div>
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="Initials" Component="Initials" /><br>
                        <RadzenTextBox class="radzen-text-box" Name="Initials" @bind-Value="personModel.ShortName" Disabled=!EditAuthorised />
                    </div>
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="Line Manager" Component="LM" /><br>
                        <RadzenDropDown class="radzen-dropdown" Name="LM" TValue="Person" TextProperty="Name" @bind-Value="personModel.LineManager" Data="@managers" Disabled=!EditAuthorised />
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="Start Date" /><br>
                        <RadzenDatePicker class="radzen-datepicker" @bind-Value="personModel.StartDate" ShowTime="false" DateFormat="dd/MM/yyyy" Disabled=!EditAuthorised />
                    </div>
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="End Date" /><br>
                        <RadzenDatePicker class="radzen-datepicker" @bind-Value="personModel.EndDate" ShowTime="false" DateFormat="dd/MM/yyyy" Disabled=!EditAuthorised />
                    </div>
                    <div class="col">
                        <RadzenLabel class="radzen-form-label" Text="Post FTE" Component="FTE" /><RadzenIcon class="centre-align" IconStyle=IconStyle.Info Icon="info" title="This is the FTE of the post as agreed as part of the department budget. If someone is working less than 1.0 FTE i.e. part-time, this should be reflected as a WLM change." /><br />
                        <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Max="@Convert.ToDecimal(1.0)" Step="0.001" @bind-Value="personModel.FTE" Disabled="@(ActiveUserRoleType != RoleType.Superuser)" />
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col mt-2" style="min-width: 500px">
                        <div class="row align-items-center">
                            <div class="col-auto mr-auto py-2">
                                <h3>Workload Model Changes</h3>
                            </div>
                            <div class="col-auto">
                                <RadzenButton Text="Edit" Icon="edit" ButtonType="ButtonType.Button" Click="@(args => EditAvailability())" Disabled=!EditAuthorised />
                            </div>
                        </div>
                        <hr />
                        <RadzenDataList AllowVirtualization=true
                                        AllowPaging="true"
                                        PageSize="3"
                                        WrapItems="false"
                                        Data="@personModel.WorkloadModelChanges.OrderByDescending(x => x.ChangeDate)"
                                        TItem="WorkloadModelChange">
                            <Template Context="d">
                                <div style="width:100%">
                                    <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                                <RadzenText Text="@d.ChangeDate.ToShortDateString()" TextStyle="TextStyle.Subtitle1" />
                                                <RadzenBadge Style="margin-bottom: 0.5rem; font-size: medium"
                                                             BadgeStyle="BadgeStyle.Primary"
                                                             Text="@($"Grade {d.Grade}")" />
                                                <RadzenBadge Style="margin-bottom: 0.5rem; font-size: medium"
                                                             BadgeStyle="BadgeStyle.Primary"
                                                             Text="@(d.Total().ToString("F1") + " FTE")" />
                                            </RadzenStack>
                                            <RadzenText Text="@d.Notes" TextStyle="TextStyle.Body2"/>
                                        </RadzenStack>
                                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceAround" AlignItems="AlignItems.Center">
                                            <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                                <RadzenText Text="Project Work" TextStyle="TextStyle.Subtitle1" />
                                                <RadzenText Text="BAU" TextStyle="TextStyle.Subtitle1" />
                                                <RadzenText Text="Personal Dev" TextStyle="TextStyle.Subtitle1" />
                                            </RadzenStack>
                                            <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                                <RadzenText Text="@d.ProjectWorkFTE.ToString()" />
                                                <RadzenText Text="@d.BusinessAsUsualFTE.ToString()" />
                                                <RadzenText Text="@d.PersonalDevelopmentFTE.ToString()" />
                                            </RadzenStack>
                                            <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                                <RadzenText Text="Staff" TextStyle="TextStyle.Subtitle1" />
                                                <RadzenText Text="Project / Service" TextStyle="TextStyle.Subtitle1" />
                                                <RadzenText Text="Architecture" TextStyle="TextStyle.Subtitle1" />
                                            </RadzenStack>
                                            <RadzenStack Orientation="Radzen.Orientation.Vertical">
                                                <RadzenText Text="@d.StaffManagementFTE.ToString()" />
                                                <RadzenText Text="@($"{d.ProjectManagementFTE} / {d.ServiceManagementFTE}")"/>
                                                <RadzenText Text="@d.ArchitectureFTE.ToString()" />
                                            </RadzenStack>
                                        </RadzenStack>
                                    </RadzenStack>
                                </div>
                            </Template>
                        </RadzenDataList>
                    </div>
                    <div class="col mt-2" style="min-width: 500px">
                        <div class="row align-items-center">
                            <div class="col-auto mr-auto py-2">
                                <h3>Absence</h3>
                            </div>
                            <div class="col-auto">
                                <RadzenButton Text="Edit" Icon="edit" ButtonType="ButtonType.Button" Click="@(args => EditAbsence())" Disabled=!EditAuthorised />
                            </div>
                        </div>
                        <hr />
                        <RadzenDataList AllowVirtualization=true
                                        WrapItems="false"
                                        AllowPaging="true"
                                        PageSize="9"
                                        Data="@personModel.Absences.OrderByDescending(x => x.StartDate)"
                                        TItem="Absence">
                            <Template Context="a">
                                <div class="row flexbox p-0">
                                    <div class="col-3">
                                        @a.StartDate.ToShortDateString()
                                    </div>
                                    <div class="col-3">
                                        to
                                    </div>
                                    <div class="col-3">
                                        @(a.EndDate?.ToShortDateString() ?? "Not Set")
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataList>
                    </div>
                </div>
                <hr />
                <DataAnnotationsValidator />
            </EditForm>
        </RadzenCard>
    }
</div>