@page "/addperson"
@inherits BasePage

<div class="container">
    <h1>Add Person</h1>
    <div class="card">
        <EditForm Model="@personModel" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row">
                <div class="col">
                    <label for="Name">Name</label>
                </div>
                <div class="col">
                    <InputText @bind-Value="personModel.Name" />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <label for="HourlyRate">Hourly Cost (£ / hour)</label>
                </div>
                <div class="col">
                    <InputNumber min="0.0" step="0.01" placeholder="0.00" @bind-Value="personModel.HourlyRate" />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <label for="AvailabilityFTE">Availability (FTE)</label>
                </div>
                <div class="col">
                    <InputNumber min="0.0" max="1.0" step="0.1" @bind-Value="personModel.AvailabilityFTE" />
                </div>
            </div>

            <div class="form-group">
                <label for="SkillTags">Skills Tags</label><br />
                @foreach (var t in AvailableTags)
                {
                    <div class="row">
                        <div class="col-auto">
                            <label class="switch">
                                <input type="checkbox" @bind-value="t.Checked">
                                <span class="slider round"></span>
                            </label>
                        </div>
                        <div class="col">
                            @t.Name
                        </div>
                        <br />
                    </div>
                }
            </div>
            <button class="btn btn-primary" type="submit">Submit <i class="oi oi-check"/></button>
        </EditForm>
    </div>
</div>