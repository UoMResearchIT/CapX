@page "/profile"
@inherits BasePage
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Pages.Components
<PageTitle>Profile - CapX</PageTitle>

<div class="container">
    @if (Loading)
    {
        <LoadingComponent />
    }
    else
    {
        <div class="row">
            <div class="col">
                <h1>Profile</h1>
            </div>
        </div>
        <div class="row">
            <div class="col">
                <RadzenText Text="@ActiveUser?.Name" TextStyle="TextStyle.DisplayH5" />
            </div>
        </div>
        <hr />

        <div class="card">
            <div class="row">
                <div class="col">
                    <h2>Details</h2>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Name" /><br>
                    <RadzenTextBox Value="@ActiveUser?.Name" Disabled="true" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Role" /><br>
                    <RadzenTextBox Value="@ActiveUserRoleType.ToNiceString()" Disabled="true" />
                </div>
            </div>
            <hr />
            <div class="row align-items-center">
                <div class="col">
                    <h3>API Keys</h3>
                </div>
                <div class="col-auto">
                    <RadzenButton Icon="add" ButtonType="ButtonType.Button" Text="Generate API Key" Click="@(() => GenerateApiKey())" Disabled="Loading" />
                </div>
            </div>
            <RadzenDataList Data="@apiKeys"
            TItem="ApiKey"
            AllowVirtualization=true
            WrapItems="false"
            AllowPaging="false"
            @ref=dataList>
                <Template Context="key">
                    <div class="row p-0">
                        <div class="col align-content-center">
                            <b>Description: </b>@key.Description
                        </div>
                        <div class="col align-content-center">
                            ********************@key.Key.Substring(key.Key.Length - 5, 5)
                        </div>
                        <div class="col align-content-center">
                            @if (key.ExpiresAt < DateTime.UtcNow)
                            {
                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                                    <RadzenIcon Icon="warning" IconStyle="IconStyle.Danger" />
                                    <b class="red">EXPIRED</b>
                                </RadzenStack>
                            }
                            else
                            {
                                <b>Expires: </b>@key.ExpiresAt.ToString("ddd dd MMMM yyyy HH:mm:ss")
                            }
                        </div>
                        <div class="col-auto">
                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenButton ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Medium" class="ms-1" Style="padding: 0" MouseEnter="@(args => ShowTooltip(args, "Copy Key"))">
                                    <div onclick="copyText('@(key.Key)')" style="padding: 0.5rem"><i class="notranslate rz-button-icon-left rzi">@((MarkupString)"content_copy")</i></div>
                                </RadzenButton>
                                <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="delete" Click="@(args => OnDelete(key))" MouseEnter="@(args => ShowTooltip(args, "Delete"))" />
                            </RadzenStack>
                        </div>
                    </div>
                </Template>
            </RadzenDataList>
        </div>
    }
</div>