@using PPMTool.Data
@using PPMTool.Data.Context
@using PPMTool.Data.Entities
@using PPMTool.Data.Helpers
@using PPMTool.Enums
@using System.ComponentModel.DataAnnotations
@using PPMTool.Services
<div class="row">
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Demand (FTE)"
                     Component="Demand" />
        <RadzenNumeric class="radzen-numeric"
                       TValue="double"
                       Min="@Convert.ToDecimal(0.001)"
                       Step="0.001" Placeholder="0.00"
                       @bind-Value="model.Demand"
                       Name="Demand"
                       Disabled="@ReadOnly"
                       Change="@(() => ValueChanged(nameof(model.Demand)))"/>
    </div>
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Start Date" />
        <RadzenDatePicker class="radzen-datepicker"
                          @bind-Value="model.StartDate"
                          ShowTime="false"
                          DateFormat="dd/MM/yyyy"
                          Disabled="@ReadOnly"
                          Change="@(() => ValueChanged(nameof(model.StartDate)))" />
    </div>
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="End Date" />
        <RadzenDatePicker class="radzen-datepicker"
                          @bind-Value="model.EndDate"
                          ShowTime="false"
                          DateFormat="dd/MM/yyyy"
                          Disabled="@ReadOnly"
                          Change="@(() => ValueChanged(nameof(model.EndDate)))" />
    </div>
    <div class="col-3">
        @if (ShowRates && CostModel == CostModel.DayRate)
        {
            <RadzenLabel class="radzen-form-label"
                         Text="Day Rate"
                         Component="DayRate" />
            <RadzenNumeric class="radzen-numeric"
                           TValue="double"
                           Min="0"
                           Step="0.01"
                           Placeholder="0"
                           @bind-Value="model.DayRate"
                           Name="DayRate"
                           Format="C2"
                           Disabled="@(ReadOnly || CostModel != CostModel.DayRate)"
                           Change="@(() => ValueChanged(nameof(model.DayRate)))" />
        }
        else if (ShowRates && CostModel != CostModel.DayRate)
        {
            <RadzenLabel class="radzen-form-label"
                         Text="Day Rate"
                         Component="DayRate" />
            <RadzenNumeric class="radzen-numeric"
                           TValue="double"
                           Min="0"
                           Step="0.01"
                           Placeholder="0"
                           @bind-Value="model.DayRate"
                           Name="DayRate"
                           Format="C2"
                           Disabled="@(ReadOnly || CostModel != CostModel.DayRate)"
                           Change="@(() => ValueChanged(nameof(model.DayRate)))" />
        }
    </div>
</div>
<div class="row">
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Work (Hours)"
                     Component="WorkHours" />
        <RadzenNumeric class="radzen-numeric"
                       TValue="double"
                       Min="0"
                       Step="0.5"
                       Placeholder="0"
                       @bind-Value="model.PlannedWorkHours"
                       Name="WorkHours"
                       Disabled="@ReadOnly"
                       Change="@(() => ValueChanged(nameof(model.PlannedWorkHours)))" />
    </div>
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Duration (Days)"
                     Component="Duration" />
        <RadzenNumeric class="radzen-numeric"
                       TValue="int"
                       Min="0"
                       @bind-Value="model.DurationDays"
                       Name="Duration"
                       Disabled="@ReadOnly"
                       Change="@(() => ValueChanged(nameof(model.DurationDays)))" />
    </div>
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Duration (Billable Days)"
                     Component="DurationBillable" />
        <RadzenNumeric class="radzen-numeric"
                       TValue="int"
                       Min="0"
                       @bind-Value="model.DurationBillableDays"
                       Name="DurationBillable"
                       Disabled="@ReadOnly"
                       Change="@(() => ValueChanged(nameof(model.DurationBillableDays)))" />
    </div>
    <div class="col-3" style="justify-items: end">
        <RadzenLabel class="radzen-form-label"
                     Text="Cost" />
        <RadzenText Text="@model.PlannedCost.ToString("C2")"
                    Style="margin-bottom: 0; margin-top: 0.5rem; font-size: x-large;" />
    </div>
</div>

@code {
    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public CostModel CostModel { get; set; }

    [Parameter]
    public bool ShowRates { get; set; } = true;

    [Parameter]
    public Action<string, TaskConfigModel> ConfigModelUpdated { get; set; }

    [Parameter]
    public PPMToolContext Context { get; set; }

    [Inject]
    private FinancialReferenceService FinancialReferenceService { get; set; }

    private TaskConfigModel model = new TaskConfigModel();

    /// <summary>
    /// Initialisation of the component
    /// </summary>
    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Initialise the model with some defaults
        model.Context = Context;
        model.FinRefService = FinancialReferenceService;
        model.CostModel = CostModel;
        model.StartDate = DateTime.Today;
        model.EndDate = DateTime.Today.AddDays(7);
        model.Update(nameof(model.StartDate));
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // Run a cost update to ensure the model is consistent with the cost model
        model.UpdateCost();
    }

    /// <summary>
    /// Method invoked when any of the inputs are modified
    /// </summary>
    /// <param name="nameOfProperty"></param>
    private void ValueChanged(string nameOfProperty)
    {
        // Only fire if not read-only
        if (ReadOnly) return;

        // Update the other properties on the model
        model.Update(nameOfProperty);

        // If there is a listener, trigger it
        ConfigModelUpdated?.Invoke(nameOfProperty, model);
    }

    /// <summary>
    /// Model which represents the configuration of the task component
    /// </summary>
    public class TaskConfigModel : BaseScheduledTask
    {
        public double DayRate { get; set; } = GlobalDefaults.DayRateDefault;
        public Rate ResourceRate { get; set; } = Rate.Standard;
        public FinancialReferenceService FinRefService { get; set; }
        public PPMToolContext Context { get; set; }

        private CostModel costModel;
        public CostModel CostModel
        {
            get => costModel;
            set
            {
                if (costModel != value)
                {
                    costModel = value;
                    UpdateCost();
                }
            }
        }

        /// <summary>
        /// Update the model parameters. Assumes fixed duration behaviour.
        /// Need to know which one triggered the update to avoid a circular.
        /// 1. Start Date
        /// 2. End Date
        /// 3. Demand
        /// 4. Calendar Duration
        /// 5. Billable Duration
        /// 6. Work (Hours)
        /// 7. DayRate
        /// </summary>
        /// <param name="nameOfPropertyTrigger"></param>
        public void Update(string nameOfPropertyTrigger)
        {
            switch(nameOfPropertyTrigger)
            {
                case nameof(StartDate):
                case nameof(EndDate):

                    // Start / end changed -> update duration, work and cost
                    if (EndDate < StartDate) EndDate = StartDate.Date;
                    UpdateDurationFromDates();
                    UpdateWork(Demand);
                    UpdateCost();
                    break;

                case nameof(Demand):

                    // Demand changed -> update work and cost
                    UpdateWork(Demand);
                    UpdateCost();
                    break;

                case nameof(DurationDays):

                    // Duration changed -> update end, billable days, work and cost
                    UpdateEndDateFromDuration();
                    UpdateWork(Demand);
                    UpdateCost();
                    break;

                case nameof(DurationBillableDays):

                    // Billable Duration changed -> update duration, update end, work and cost
                    DurationDays = (int)GetNumberOfCalendarDays(DurationBillableDays);
                    UpdateEndDateFromDuration();
                    UpdateWork(Demand);
                    UpdateCost();
                    break;

                case nameof(PlannedWorkHours):

                    // Work changed -> update duration and cost
                    UpdateDuration(Demand);
                    UpdateEndDateFromDuration();
                    UpdateCost();
                    break;

                case nameof(DayRate):

                    // Update the cost only
                    UpdateCost();
                    break;
            }
        }

        /// <summary>
        /// Do a cost update based on the current parameters of the model
        /// </summary>
        public void UpdateCost()
        {
            // Reset
            PlannedCost = 0;

            // If using day rate
            if (CostModel == CostModel.DayRate)
            {
                // Use day rate
                PlannedCost = (DayRate * Demand * DurationBillableDays);
            }
            else
            {
                // Break the task into chunks based on financial year boundaries
                foreach (var fyChunk in FinanceHelper.GetFinancialYearDateRanges(StartDate, EndDate))
                {
                    // Find reference data for the financial year
                    var finRef = FinRefService.GetFinancialReferenceForDate(Context, fyChunk.StartDate);

                    // Days in chunk
                    var daysInChunk = fyChunk.EndDate.Subtract(fyChunk.StartDate).TotalDays + 1;
                    var dayScaled = daysInChunk * Demand / 365d;

                    switch (ResourceRate)
                    {
                        case Rate.Junior:
                            PlannedCost += finRef.Grade51Costs * dayScaled;
                            break;

                        case Rate.Standard:
                            PlannedCost += finRef.Grade71Costs * dayScaled;
                            break;

                        case Rate.Senior:
                            PlannedCost += finRef.Grade75Costs * dayScaled;
                            break;
                    }
                }
            }
        }
    }
}