@using PPMTool.Data.Entities
@using PPMTool.Enums
@using System.ComponentModel.DataAnnotations
<div class="row">
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Demand (FTE)"
                     Component="Demand" />
        <RadzenNumeric class="radzen-numeric"
                       TValue="double"
                       Min="@Convert.ToDecimal(0.001)"
                       Step="0.001" Placeholder="0.00"
                       @bind-Value="model.Demand"
                       Name="Demand"
                       Disabled="@ReadOnly"
                       Change="@(() => ValueChanged(nameof(model.Demand)))"/>
    </div>
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Start Date" />
        <RadzenDatePicker class="radzen-datepicker"
                          @bind-Value="model.StartDate"
                          ShowTime="false"
                          DateFormat="dd/MM/yyyy"
                          Disabled="@ReadOnly" />
    </div>
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="End Date" />
        <RadzenDatePicker class="radzen-datepicker"
                          @bind-Value="model.EndDate"
                          ShowTime="false"
                          DateFormat="dd/MM/yyyy"
                          Disabled="@ReadOnly" />
    </div>
    <div class="col-3">
        @if (ShowRates &&CostModel == CostModel.DayRate)
        {
            <RadzenLabel class="radzen-form-label"
                            Text="Day Rate"
                            Component="DayRate" />
            <RadzenNumeric class="radzen-numeric"
                            TValue="double"
                            Min="0"
                            Step="0.01"
                            Placeholder="0"
                            @bind-Value="model.DayRate"
                            Name="DayRate"
                            Format="C2"
                            Disabled="@(ReadOnly || CostModel != CostModel.DayRate)" />
        }
    </div>
</div>
<div class="row">
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Work (Hours)"
                     Component="WorkHours" />
        <RadzenNumeric class="radzen-numeric"
                       TValue="double"
                       Min="0"
                       Step="0.5"
                       Placeholder="0"
                       @bind-Value="model.PlannedWorkHours"
                       Name="WorkHours"
                       Disabled="@ReadOnly" />
    </div>
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Duration (Days)"
                     Component="Duration" />
        <RadzenNumeric class="radzen-numeric"
                       TValue="int"
                       Min="0"
                       @bind-Value="model.DurationDays"
                       Name="Duration"
                       Disabled="@ReadOnly" />
    </div>
    <div class="col-3">
        <RadzenLabel class="radzen-form-label"
                     Text="Duration (Billable Days)"
                     Component="DurationBillable" />
        <RadzenNumeric class="radzen-numeric"
                       TValue="int"
                       Min="0"
                       @bind-Value="model.DurationBillableDays"
                       Name="DurationBillable"
                       Disabled="@ReadOnly" />
    </div>
    <div class="col-3" style="justify-items: end">
        <RadzenLabel class="radzen-form-label"
                     Text="Cost" />
        <RadzenText Text="@model.PlannedCost.ToString("C2")"
                    Style="margin-bottom: 0; margin-top: 0.5rem; font-size: x-large;" />
    </div>
</div>

@code {
    [Parameter]
    public bool ReadOnly { get; set; } = false;

    [Parameter]
    public CostModel CostModel { get; set; }

    [Parameter]
    public bool ShowRates { get; set; } = true;

    [Parameter]
    public Action<string, TaskConfigModel> ConfigModelUpdated { get; set; }

    private TaskConfigModel model = new TaskConfigModel();

    /// <summary>
    /// Method invoked when any of the inputs are modified
    /// </summary>
    /// <param name="nameOfProperty"></param>
    private void ValueChanged(string nameOfProperty)
    {
        // Update the other properties on the model
        model.Update(nameOfProperty);

        // If there is a listener, trigger it
        ConfigModelUpdated?.Invoke(nameOfProperty, model);
    }

    /// <summary>
    /// Model which represents the configuration of the task component
    /// </summary>
    public class TaskConfigModel : BaseScheduledTask
    {
        public double DayRate { get; set; }
        public Rate ResourceRate { get; set; }

        /// <summary>
        /// Update the model parameters.
        /// Need to know which one triggered the update to avoid a circular.
        /// </summary>
        /// <param name="nameOfPropertyTrigger"></param>
        public void Update(string nameOfPropertyTrigger)
        {
            // TODO
        }
    }
}
}
