@using PPMTool.Data.Entities
@using PPMTool.Data.Enums

<RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="0.3rem" AlignItems="AlignItems.Center">
    @if (SkillsList == null || SkillsList.Count() == 0)
    {
        <RadzenText Text="@(string.IsNullOrWhiteSpace(EmptyMessage) ? "No skill tags associated with the tasks in this project" : EmptyMessage)" />
    }
    else
    {
        @foreach (var skill in SkillsList)
        {
            <RadzenBadge Style="@($"background-color: {skill.Rareness.GetTextColourCode()};")" title="@($"{skill.RarenessCount} RSE(s) with this tag")">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                    <div class="emblem-background" style="width: unset;"><SkillTagRarenessEmblemComponent SkillTag="skill" SizeInRem="1" /></div>
                    <RadzenText Text="@skill.Name" Style="color: white; margin-bottom: 0;" />
                    @if (RemoveSkill != null)
                    {
                        <RadzenButton Style="background-color: #ffffff00" Size="ButtonSize.ExtraSmall" Icon="delete" Click="@(() => RemoveSkill?.Invoke(skill))" />
                    }
                </RadzenStack>
            </RadzenBadge>
        }

    }
</RadzenStack>

@code {
    [Parameter]
    public IEnumerable<SkillTag> SkillsList { get; set; }

    [Parameter]
    public Action<SkillTag> RemoveSkill { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; }

}
