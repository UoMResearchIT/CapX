@using PPMTool.Data.Entities

<div class="card row align-items-center">
    <div class="col">
        <RadzenStack class="mt-1" Orientation="Radzen.Orientation.Vertical" AlignItems="AlignItems.Center" Gap="0.1rem">
            <RadzenText TextStyle="TextStyle.Subtitle2" Text="@Feature.Name" />
            <RadzenText TextStyle="TextStyle.Body2" Text="@Feature.Description" />
        </RadzenStack>
    </div>
    <div class="col-auto">
        <RadzenSwitch @bind-Value="Feature.Enabled" Change="@(args => OnFeatureToggle?.Invoke(Feature))" />
    </div>
</div>

@code {

    [Parameter]
    public Action<Feature> OnFeatureToggle { get; set; }

    [Parameter]
    public Feature Feature { get; set; }
}
