@using PPMTool.Data.Entities

<RadzenButton Click=@NavigateToRTPAsync Text="View on RTP" Icon="open_in_new" Disabled=Disabled/>

@code {

    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    [Parameter]
    public Project Project { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public BasePage Page {get; set;}

    private async void NavigateToRTPAsync()
    {
        Page?.LogInformation($"Navigating to Jira for RTP-{Project?.RTP}");
        try
        {
            await JSRuntime.InvokeAsync<object>("open", $"https://universityofmanchester.atlassian.net/jira/software/projects/RTP/boards/654?selectedIssue=RTP-{Project.RTP}", "_blank");
        }
        catch (Exception ex)
        {
            Page?.LogError("Failed to navigate to Jira", ex);
        }
    }
}
