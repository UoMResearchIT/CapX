@using PPMTool.Data.Entities
@using PPMTool.Enums
<RadzenBadge Text="@Entry.InnateCodeTask.TaskName"
             Style="@($"width: 100%; white-space:pre-wrap; background-color: {backgroundColour}; color: {textColour}")" />

@code {

    [Parameter]
    public TimesheetEntry Entry { get; set; }

    private string backgroundColour;
    private string textColour;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        backgroundColour = (Entry?.InnateCodeTask?.Duty.GetAttribute<ColourAttribute>().BackgroundColourCode ?? "#609");
        textColour = (Entry?.InnateCodeTask?.Duty.GetAttribute<ColourAttribute>().TextColourCode);
    }

}
