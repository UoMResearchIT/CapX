@using PPMTool.Enums

<RadzenBadge Style="margin-bottom: 0.3rem"
             BadgeStyle="@(
                ProjectStatus.IsFinishedOrCancelled() ? BadgeStyle.Light :
                ProjectStatus == ProjectStatus.Active ? BadgeStyle.Success :
                ProjectStatus == ProjectStatus.Funded ? BadgeStyle.Info :
                BadgeStyle.Light)"
             Text="@ProjectStatus.ToNiceString()" />

@code {
    [Parameter]
    public ProjectStatus ProjectStatus { get; set; }
}
