@using PPMTool.Data
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using System.Diagnostics
@using PPMTool.Services

<RadzenCard Style="margin-bottom: 1rem;">

    <!-- STATUS / UNMET DEMAND -->
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="2rem" Style="margin-bottom: 1rem;">

        <!-- Status & Unmet demand -->
        <div>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem" AlignItems="AlignItems.Center">
                <ProjectBadgeComponent ProjectStatus="@Project.ProjectStatus" />

                <div style="margin-left: 0.5rem;">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.2rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" >

                        <RadzenText TextStyle="TextStyle.Subtitle1" Text="Unmet Demand (FTE) :" Style="margin-right: 0.1rem;"/>
                        <RadzenBadge Style="font-size: medium;"
                                     BadgeStyle="BadgeStyle.Danger"
                                     Text="@(minDemand.ToString())" />
                        @if (minDemand != maxDemand)
                        {
                            <RadzenText Text="-" />
                            <RadzenBadge Style="font-size: medium;"
                                         BadgeStyle="BadgeStyle.Danger"
                                         Text="@(maxDemand.ToString())" />
                        }

                    </RadzenStack>
                </div>
            </RadzenStack>
        </div>

        <!-- Request doc & Project detail buttons -->
        <div>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.2rem" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenButton Text=@(Project.HasNoRequestDocLink() ? "No Request Doc Link" : "Request Doc")
                              Icon="description" Click="@(args => ViewRequestDocClickedAsync(Project))"
                              ButtonStyle=@(Project.HasNoRequestDocLink() ? ButtonStyle.Light : ButtonStyle.Primary)
                              Disabled=@Project.HasNoRequestDocLink() />
                @if (ShowDetailsButton)
                {
                    <RadzenButton Text="View Project Details"
                                  Icon="info" Click="@(args => ViewDetails(Project.ProjectId))"
                                  ButtonStyle=ButtonStyle.Primary />
                }
            </RadzenStack>
        </div>

    </RadzenStack>

    <!-- PM / DATES -->
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="2rem" Style="margin-bottom: 1rem;">

        <!-- Project Manager details -->
        <div style="padding: 5px 0px;">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle1" Text="Project Manager :" />
                <RadzenText TextStyle="TextStyle.Body1">
                    @(Project.ProjectManager?.Name ?? "Not Set")
                </RadzenText>
            </RadzenStack>
        </div>

        <!-- Dates -->
        <div style="padding: 5px 0px;">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Gap="0.5rem">
                <RadzenText TextStyle="TextStyle.Subtitle1" Text="Dates : " />
                <RadzenText TextStyle="TextStyle.Body1">@windowDatesFormatted</RadzenText>
            </RadzenStack>
        </div>

    </RadzenStack>

    <!-- PROJECT DETAILS -->
    <div style="border: 1px solid #ddd; padding: 15px 10px; border-radius: 5px; margin-bottom: 1rem;">
        <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="2rem">

            <div style="padding: 15px 10px 25px 10px; background-color: #eee; margin: -15px -10px -10px -10px;">
                <RadzenText TextStyle="TextStyle.H3" Style="font-size: 2rem; margin-bottom: -1rem;" Text="@Project.GetFullName()" />
            </div>

            <!-- Project details -->
            <RadzenText TextStyle="TextStyle.Body1">
                @((MarkupString)Project.Description)
            </RadzenText>

        </RadzenStack>
    </div>

    <!-- REQUIRED SKILLS -->
    <SkillsAsBadgesComponent SkillsList="@SkillsList" />

</RadzenCard>

@code {

    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; }

    [Parameter]
    public Project Project { get; set; }

    [Parameter]
    public bool ShowDetailsButton { get; set; }

    [Parameter]
    public DateTime? FilterStartDate { get; set; }

    [Parameter]
    public DateTime? FilterEndDate { get; set; }

    [Parameter]
    public IEnumerable<SkillTag> SkillsList { get; set; }

    private double maxDemand;
    private double minDemand;
    private DateTime startDate;
    private DateTime endDate;
    private string windowDatesFormatted;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        UpdateCardData();
    }

    public void UpdateCardData()
    {
        // Set the dates to show on the card
        Project.GetUnmetDemandWindowDates(out var windowStart, out var windowEnd);
        this.startDate = FilterStartDate == null ? windowStart : (FilterStartDate.Value < windowStart ? windowStart : FilterStartDate.Value);
        this.endDate = FilterEndDate == null ? windowEnd : (FilterEndDate.Value < windowEnd ? FilterEndDate.Value : windowEnd);
        FormatWindowDates();

        // Get max and min demand (rounded to 3 dp) -- ignoring tasks with no unmet demand
        var subtasks = Project.SubTasks.Where(x => x.GetUnmetDemandInWindow(FilterStartDate, FilterEndDate) != 0);
        if (subtasks.Count() == 0) return;
        maxDemand = Math.Round(1000 * subtasks.Max(x => x.GetUnmetDemandInWindow(FilterStartDate, FilterEndDate))) / 1000;
        minDemand = Math.Round(1000 * subtasks.Min(x => x.GetUnmetDemandInWindow(FilterStartDate, FilterEndDate))) / 1000;

        Debug.WriteLine($"** {Project.GetFullName()}: {windowDatesFormatted}: {minDemand} - {maxDemand}");
    }

    /// <summary>
    /// Navigate to the Request Doc Link in new window
    /// </summary>
    /// <param name="project"></param>
    /// <returns></returns>
    private async Task ViewRequestDocClickedAsync(Project project)
    {
        await JSRuntime.InvokeVoidAsync("open", $"{project.RequestDocLink}", "_blank");
    }

    private async void ViewDetails(int id)
    {
        string url = $"projects/projectdetails/{id}";
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    /// <summary>
    /// Method to format the demand window dates
    /// </summary>
    /// <returns></returns>
    private void FormatWindowDates()
    {
        windowDatesFormatted = $"{(startDate <= DateTime.Today ? "Now" : startDate.ToShortDateString())} - {(endDate == DateTime.Today ? "Today" : endDate.ToShortDateString())}";
    }
}
