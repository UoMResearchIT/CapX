@using PPMTool.Data
@using PPMTool.Enums
@using PPMTool.Data.Entities

<div class="card" style="min-height: 5rem">
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.2rem">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenText TextStyle="TextStyle.H5" Text="@project.GetFullName()" />
                <RadzenBadge Style="margin-bottom: 0.5rem"
                             BadgeStyle="@(
                                    project.ProjectStatus.IsFinishedOrCancelled() ? BadgeStyle.Light :
                                    project.ProjectStatus == ProjectStatus.Active ? BadgeStyle.Success :
                                    project.ProjectStatus == ProjectStatus.Funded ? BadgeStyle.Info :
                                    BadgeStyle.Light)"
                             Text="@project.ProjectStatus.ToNiceString()" />
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal">
                <RadzenText Style="min-width:8rem" TextStyle="TextStyle.Subtitle1" Text="Project Manager:" />
                <RadzenText TextStyle="TextStyle.Body1">
                    @(project.ProjectManager?.Name ?? "Not Set")
                </RadzenText>
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal">
                <RadzenText Style="min-width:8rem" TextStyle="TextStyle.Subtitle1" Text="Description:" />
                <RadzenText TextStyle="TextStyle.Body1">
                    @((MarkupString)project.Description)
                </RadzenText>
            </RadzenStack>
        </RadzenStack>
        <RadzenStack Style="min-width:15rem" Orientation="Radzen.Orientation.Vertical" Gap="0.2rem" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.Subtitle1" Text="Max. Unmet Demand (FTE)" />
            <RadzenBadge Style="margin-bottom: 0.5rem; font-size: medium"
                         BadgeStyle="BadgeStyle.Danger"
                         Text="@(project.SubTasks.Max(x => x.GetUnmetDemandNowAndInFuture()).ToString())" />
            <RadzenText TextStyle="TextStyle.Subtitle1" Text="Dates" />
            <RadzenText TextStyle="TextStyle.Body1">@(project.GetUnmetDemandWindowDatesAsFormattedString())</RadzenText>
            <RadzenButton Text=@(project.HasNoRequestDocLink() ? "No Request Doc Link" : "View Request Doc")
                          Icon="description" Click="@(args => ViewRequestDocClickedAsync(project))"
                          ButtonStyle=@(project.HasNoRequestDocLink() ? ButtonStyle.Light : ButtonStyle.Primary)
                          Disabled=@project.HasNoRequestDocLink()
                          Style="width: 100%" />
            @if (ShowDetailsButton)
            {
                <RadzenButton Text="View Project Details"
                              Icon="info" Click="@(args => ViewDetails(project.ProjectId))"
                              ButtonStyle=ButtonStyle.Primary
                              Style="width: 100%" />
            }
        </RadzenStack>
    </RadzenStack>
</div>

@code {

    [Parameter]
    public Project project { get; set; }

    [Parameter]
    public bool ShowDetailsButton { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; }

    /// <summary>
    /// Navigate to the Request Doc Link in new window
    /// </summary>
    /// <param name="project"></param>
    /// <returns></returns>
    private async Task ViewRequestDocClickedAsync(Project project)
    {
        await JSRuntime.InvokeAsync<object>("open", $"{project.RequestDocLink}", "_blank");
    }

    private void ViewDetails(int id)
    {
        Navigation.NavigateTo($"/projectdetails/{id}");
    }
}
