@using PPMTool.Data
@using PPMTool.Services
@using System.Diagnostics
@using static PPMTool.Data.StatusMessage
@inject FeatureService FeatureService

@if (FilteredMessages.Count() > 1)
{
    <RadzenBadge BadgeStyle="BadgeStyle.Light">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem" AlignItems="AlignItems.Center">
            <RadzenIcon Icon=@icon IconStyle=@iconStyle title="@(string.Join('\n', FilteredMessages.Select(x => x.Message)))" />
            <RadzenText Style="margin-bottom: 0rem" TextStyle="TextStyle.Body2" TextAlign="TextAlign.Center" Text=@(FilteredMessages.Count().ToString()) />
        </RadzenStack>
    </RadzenBadge>
}
else if (FilteredMessages.Count() > 0)
{
    <RadzenIcon Icon=@icon IconStyle=@iconStyle title="@(string.Join('\n', FilteredMessages.Select(x => x.Message)))" />
}

@code
{
    [Parameter]
    public IList<StatusMessage> Messages { get; set; }

    [Parameter]
    public MessageType? Type { get; set; }

    private IconStyle iconStyle;
    private string icon;
    private MessageType? type = null;

    // Holds only valid, feature specific messages to be displayed
    private IList<StatusMessage> FilteredMessages { get; set; } = new List<StatusMessage>();

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (type != Type)
        {
            type = Type;
            UpdateStyle();
        }

        // Populate the filtered list of messages
        FilteredMessages.Clear();
        foreach (StatusMessage item in Messages?.Where(x => x.Type == Type && x.Status))
        {
            if (item.RelevantFeature == Enums.FeatureType.None || FeatureService.IsFeatureEnabled(item.RelevantFeature))
            {
                FilteredMessages.Add(item);
            }
        }
        Debug.WriteLine($"** {Type} | Filtered Message Count = {FilteredMessages.Count}");
    }

    /// <summary>
    /// Update internal state when the Type changes
    /// </summary>
    private void UpdateStyle()
    {
        if (Type == MessageType.Info)
        {
            iconStyle = IconStyle.Info;
            icon = "info";
        }
        else if (Type == MessageType.Warning)
        {
            iconStyle = IconStyle.Warning;
            icon = "warning";
        }
        else if (Type == MessageType.Error)
        {
            iconStyle = IconStyle.Danger;
            icon = "error";
        }
        else
        {
            iconStyle = IconStyle.Success;
            icon = "check";
        }
        StateHasChanged();
    }
}
