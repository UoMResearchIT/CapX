
<RadzenCard class="rz-m-1" Style="min-height:8rem">
    <RadzenStack class="rz-p-0" Orientation="Radzen.Orientation.Vertical">
        <RadzenText TextStyle="TextStyle.Subtitle1" Text="@NoteAuthorText" />
        <RadzenText TextStyle="TextStyle.Body1">
            @((MarkupString)NoteContent)
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Body2" Text="@NoteEditorText" Style="font-weight:lighter; margin-top:1rem" />
    </RadzenStack>
</RadzenCard>

@code
{
    [Parameter]
    public string NoteEditorText { get; set; } = "Last edited by Adrian Harwood on 21/05/2024 16:32";

    [Parameter]
    public string NoteAuthorText { get; set; } = "Adrian Harwood posted on 21/05/2024 15:23";

    [Parameter]
    public string NoteContent { get; set; } = "This is the content of the note where we can add <b>multi-line rich text</b> stored in HTML and read out as a markup string.";
}
