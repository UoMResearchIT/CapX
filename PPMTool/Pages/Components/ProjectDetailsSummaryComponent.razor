@using PPMTool.Data
@using PPMTool.Data.Context
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using System.ComponentModel.DataAnnotations
@using PPMTool.Services

<h2>Project Summary</h2>
@if (FinanceSummaryItem == null)
{
    <p class="lead">No data to show</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Dates</th>
                    <th>PI</th>
                    <th>School (Faculty)</th>
                    <th>PM</th>
                    <th>Cost Model</th>
                    @if (FinanceSummaryItem.CostModel == CostModel.DayRate)
                    {
                        <th>Day Rate</th>
                    }
                    <th>Agreed Budget</th>
                    <th>Planned Cost</th>
                    <th>Actual Cost (Hours)</th>
                    <th>Funds Requested</th>
                    <th>Funds Received</th>
                    <th>Funding Sources</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@($"{FinanceSummaryItem.StartDate.ToShortDateString()} - {FinanceSummaryItem.EndDate.ToShortDateString()}")</td>
                    <td>@FinanceSummaryItem.ProjectPI</td>
                    <td>@($"{FinanceSummaryItem.School.ToNiceString()} ({FinanceSummaryItem.Faculty.ToNiceString()})")</td>
                    <td>@FinanceSummaryItem.ProjectPM</td>
                    <td>@(FinanceSummaryItem.CostModel.GetAttribute<DisplayAttribute>().Name)</td>
                    @if (FinanceSummaryItem.CostModel == CostModel.DayRate)
                    {
                        <td>@FinanceSummaryItem.DayRate.ToString("C0")</td>
                    }
                    <td>@FinanceSummaryItem.Budget.ToString("C0")</td>
                    <td>
                        @if (FinanceSummaryItem.CostModel == CostModel.TechAndLeadership)
                        {
                            @($"Total: ")
                        }
                        <span style="color:@FinanceSummaryItem.PlannedCostColour">
                            @FinanceSummaryItem.PlannedCost.ToString("C0")
                        </span>
                        @if (FinanceSummaryItem.CostModel == CostModel.TechAndLeadership)
                        {
                            <br />
                            @($"Technical: ")
                            <span>
                                @((FinanceSummaryItem.PlannedCost - FinanceSummaryItem.PlannedLeadershipCosts).ToString("C0"))
                            </span>
                            <br />
                            @($"Leadership: ")
                            <span>
                                @(FinanceSummaryItem.PlannedLeadershipCosts.ToString("C0"))
                            </span>
                        }
                    </td>
                    <td>
                        @if (FinanceSummaryItem.CostModel == CostModel.TechAndLeadership)
                        {
                            @($"Total: ")
                        }
                        <span style="color:@FinanceSummaryItem.ActualCostColour">
                            @FinanceSummaryItem.ActualCost.ToString("C0")
                        </span>
                        @if (FinanceSummaryItem.CostModel == CostModel.TechAndLeadership)
                        {
                            <br />
                            @($"Technical: ")
                            <span>
                                @((FinanceSummaryItem.ActualCost - FinanceSummaryItem.ActualLeadershipCosts).ToString("C0"))
                            </span>
                            <br />
                            @($"Leadership: ")
                            <span>
                                @(FinanceSummaryItem.ActualLeadershipCosts.ToString("C0"))
                            </span>
                        }
                        @($" ({FinanceSummaryItem.ActualHours.ToString("F2")})")
                    </td>
                    <td>
                        @($"Total: ")
                        <span style="color:@FinanceSummaryItem.FundsRequestedColour">
                            @FinanceSummaryItem.GetAllRequested().ToString("C0")
                        </span>
                        <br />
                        @($"DI: ")
                        <span style="color:@FinanceSummaryItem.FundsDIColour">
                            @FinanceSummaryItem.FundsDI.ToString("C0")
                        </span>
                        <br />
                        @($"DA: ")
                        <span>
                            @FinanceSummaryItem.FundsDA.ToString("C0")
                        </span>
                        <br />
                        @($"Other: ")
                        <span>
                            @FinanceSummaryItem.FundsRequestedOther.ToString("C0")
                        </span>
                    </td>
                    <td>
                        @($"Total: ")
                        <span style="color:@FinanceSummaryItem.FundsReceivedColour">
                            @FinanceSummaryItem.GetAllReceived().ToString("C0")
                        </span>
                        <br />
                        @($"DI: ")
                        <span style="color:@FinanceSummaryItem.FundsDIColour">
                            @FinanceSummaryItem.GetReceivedDI().ToString("C0")
                        </span>
                        <br />
                        @($"DA: ")
                        <span>
                            @FinanceSummaryItem.FundsDA.ToString("C0")
                        </span>
                        <br />
                        @($"Other: ")
                        <span>
                            @FinanceSummaryItem.FundsReceivedOther.ToString("C0")
                        </span>
                    </td>
                    <td>@FinanceSummaryItem.ListOfFundingSources</td>
                </tr>
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public FinanceSummaryItem FinanceSummaryItem { get; set; }

    [Parameter]
    public bool EditAuthorised { get; set; }
}
