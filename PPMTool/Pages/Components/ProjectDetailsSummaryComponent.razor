@using PPMTool.Data
@using PPMTool.Data.Context
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using System.ComponentModel.DataAnnotations
@using PPMTool.Services

<h2>Project Summary</h2>
@if (FinanceSummaryItem == null)
{
    <p class="lead">No data to show</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Dates</th>
                    <th>PI</th>
                    <th>School (Faculty)</th>
                    <th>PM</th>
                    <th>Cost Model</th>
                    @if (FinanceSummaryItem.CostModel == CostModel.DayRate)
                    {
                        <th>Day Rate</th>
                    }
                    <th>Agreed Budget</th>
                    <th>Planned Cost</th>
                    <th>Actual Cost (Hours)</th>
                    <th>Funds Requested</th>
                    <th>Funds Received</th>
                    <th>Funding Sources</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@($"{FinanceSummaryItem.StartDate.ToShortDateString()} - {FinanceSummaryItem.EndDate.ToShortDateString()}")</td>
                    <td>@FinanceSummaryItem.ProjectPI</td>
                    <td>@($"{FinanceSummaryItem.School.ToNiceString()} ({FinanceSummaryItem.Faculty.ToNiceString()})")</td>
                    <td>@FinanceSummaryItem.ProjectPM</td>
                    <td>@(FinanceSummaryItem.CostModel.GetAttribute<DisplayAttribute>().Name)</td>
                    @if (FinanceSummaryItem.CostModel == CostModel.DayRate)
                    {
                        <td>@FinanceSummaryItem.DayRate.ToString("C0")</td>
                    }
                    <td>
                        @if (FinanceSummaryItem.CostModel.HasIndirects())
                        {
                            @((MarkupString)$"<span>Total:</span>&nbsp;<span>{FinanceSummaryItem.Budget.ToString("C0")}</span>")
                            <br />
                            @((MarkupString)$"<span>Indirects:</span>&nbsp;<span>{FinanceSummaryItem.BudgetIndirectCosts.ToString("C0")}</span>")
                            <br />
                            @((MarkupString)$"<span>Directs:</span>&nbsp;<span>{(FinanceSummaryItem.Budget - FinanceSummaryItem.BudgetIndirectCosts).ToString("C0")}</span>")
                        }
                        else
                        {
                            @FinanceSummaryItem.Budget.ToString("C0")
                        }
                    </td>
                    <td>
                        @if (FinanceSummaryItem.CostModel.HasLeadership())
                        {
                            @((MarkupString)$"<span>Total:</span>&nbsp;<span style=\"color:{FinanceSummaryItem.PlannedCostColour}\">{FinanceSummaryItem.PlannedCost.ToString("C0")}</span>")
                            <br />
                            @((MarkupString)$"<span>Technical:</span>&nbsp;<span>{(FinanceSummaryItem.PlannedCost - FinanceSummaryItem.PlannedLeadershipCosts).ToString("C0")}</span>")
                            <br />
                            @((MarkupString)$"<span>Leadership:</span>&nbsp;<span>{FinanceSummaryItem.PlannedLeadershipCosts.ToString("C0")}</span>")
                            if (FinanceSummaryItem.CostModel.HasIndirects())
                            {
                                <br />
                                @((MarkupString)$"<span>Indirects:</span>&nbsp;<span>{FinanceSummaryItem.PlannedIndirectCosts.ToString("C0")}</span>")
                            }
                        }
                        else
                        {
                            if (FinanceSummaryItem.CostModel.HasIndirects())
                            {
                                @((MarkupString)$"<span>Total:</span>&nbsp;<span style=\"color:{FinanceSummaryItem.PlannedCostColour}\">{FinanceSummaryItem.PlannedCost.ToString("C0")}</span>")
                                <br />
                                @((MarkupString)$"<span>Indirects:</span>&nbsp;<span>{FinanceSummaryItem.PlannedIndirectCosts.ToString("C0")}</span>")
                                <br />
                                @((MarkupString)$"<span>Directs:</span>&nbsp;<span>{(FinanceSummaryItem.PlannedCost - FinanceSummaryItem.PlannedIndirectCosts).ToString("C0")}</span>")
                            }
                            else
                            {
                                <span style="color:@FinanceSummaryItem.PlannedCostColour">
                                    @FinanceSummaryItem.PlannedCost.ToString("C0")
                                </span>
                            }
                        }
                    </td>
                    <td>
                        @if (FinanceSummaryItem.CostModel.HasLeadership())
                        {
                            @((MarkupString)$"<span>Total:</span>&nbsp;<span style=\"color:{FinanceSummaryItem.ActualCostColour}\">{FinanceSummaryItem.ActualCost.ToString("C0")}</span>")
                            <br />
                            @((MarkupString)$"<span>Technical:</span>&nbsp;<span>{(FinanceSummaryItem.ActualCost - FinanceSummaryItem.ActualLeadershipCosts).ToString("C0")}</span>")
                            <br />
                            @((MarkupString)$"<span>Leadership:</span>&nbsp;<span>{FinanceSummaryItem.ActualLeadershipCosts.ToString("C0")}</span>")
                            if (FinanceSummaryItem.CostModel.HasIndirects())
                            {
                                <br />
                                @((MarkupString)$"<span>Indirects:</span>&nbsp;<span>{FinanceSummaryItem.ActualIndirectCosts.ToString("C0")}</span>")
                            }
                        }
                        else
                        {
                            if (FinanceSummaryItem.CostModel.HasIndirects())
                            {
                                @((MarkupString)$"<span>Total:</span>&nbsp;<span style=\"color:{FinanceSummaryItem.ActualCostColour}\">{FinanceSummaryItem.ActualCost.ToString("C0")}</span>")
                                <br />
                                @((MarkupString)$"<span>Indirects:</span>&nbsp;<span>{FinanceSummaryItem.ActualIndirectCosts.ToString("C0")}</span>")
                                <br />
                                @((MarkupString)$"<span>Directs:</span>&nbsp;<span>{(FinanceSummaryItem.ActualCost - FinanceSummaryItem.ActualIndirectCosts).ToString("C0")}</span>")
                            }
                            else
                            {
                                <span style="color:@FinanceSummaryItem.ActualCostColour">
                                    @FinanceSummaryItem.ActualCost.ToString("C0")
                                </span>
                            }
                        }
                        <br />
                        @($" ({FinanceSummaryItem.ActualHours.ToString("F2")} hrs)")                        
                    </td>
                    <td>
                        @((MarkupString)$"<span>Total:</span>&nbsp;<span style=\"color:{FinanceSummaryItem.FundsRequestedColour}\">{FinanceSummaryItem.GetAllRequested().ToString("C0")}</span>")
                        <br />
                        @((MarkupString)$"<span>DI:</span>&nbsp;<span style=\"color:{FinanceSummaryItem.FundsDIColour}\">{FinanceSummaryItem.FundsDI.ToString("C0")}</span>")
                        <br />
                        @((MarkupString)$"<span>DA:</span>&nbsp;<span>{FinanceSummaryItem.FundsDA.ToString("C0")}</span>")
                        <br />
                        @((MarkupString)$"<span>Other:</span>&nbsp;<span>{FinanceSummaryItem.FundsRequestedOther.ToString("C0")}</span>")
                    </td>
                    <td>
                        @((MarkupString)$"<span>Total:</span>&nbsp;<span style=\"color:{FinanceSummaryItem.FundsReceivedColour}\">{FinanceSummaryItem.GetAllReceived().ToString("C0")}</span>")
                        <br />
                        @((MarkupString)$"<span>DI:</span>&nbsp;<span style=\"color:{FinanceSummaryItem.FundsDIColour}\">{FinanceSummaryItem.GetReceivedDI().ToString("C0")}</span>")
                        <br />
                        @((MarkupString)$"<span>DA:</span>&nbsp;<span>{FinanceSummaryItem.FundsDA.ToString("C0")}</span>")
                        <br />
                        @((MarkupString)$"<span>Other:</span>&nbsp;<span>{FinanceSummaryItem.FundsReceivedOther.ToString("C0")}</span>")
                    </td>
                    <td>@FinanceSummaryItem.ListOfFundingSources</td>
                </tr>
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter]
    public FinanceSummaryItem FinanceSummaryItem { get; set; }

    [Parameter]
    public bool EditAuthorised { get; set; }
}
