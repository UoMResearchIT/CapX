@using PPMTool.Models
@using PPMTool.Helpers
@using System.Diagnostics
@using ApexCharts
@using static PPMTool.Pages.BaseCapacityPage

@if ((confirmedChartItems?.Count() ?? 0) == 0 && (provisionalChartItems?.Count() ?? 0) == 0)
{
    <RadzenStack Orientation="Radzen.Orientation.Vertical" class="mx-2">
        <RadzenText Text="@ChartModel?.ChartTitle" TextStyle="TextStyle.Subtitle1" />
        <RadzenText Text="No data to show" />
    </RadzenStack>
}
else
{
    <ApexChart Title="@title"
               TItem="ChartItem"
               Options=@chartOptions
               XAxisType="XAxisType.Datetime"
               OnDataPointSelection="@(args => OnDataPointSelection?.Invoke(args))"
               OnZoomed="@(args => OnChartZoomed?.Invoke(args))">
        <ChildContent>
            <ApexRangeSeries TItem="ChartItem"
                             Items="@confirmedChartItems"
                             XValue="@(e => e.Label)"
                             YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                             YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                             PointColor="@(e => e.Colour)" />

            <ApexRangeSeries TItem="ChartItem"
                             Items="@provisionalChartItems"
                             XValue="@(e => e.Label)"
                             YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                             YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                             PointColor="@(e => e.Colour)" />
        </ChildContent>
        <ApexPointTooltip>
            <div class="m-2">
                @{
                    var point = (ListPoint<ChartItem>)context.DataPoint;
                    <div class="m-0 p-3">
                        @if (point.Items.FirstOrDefault()?.TooltipMessages != null)
                        {
                            @((MarkupString)point.Items.FirstOrDefault().TooltipMessages)
                        }
                        @Value1TooltipFormatter(point.Items.FirstOrDefault())
                        @Value2TooltipFormatter(point.Items.FirstOrDefault())

                        <span class="me-1">
                            @ChartHelper.FormatTooltipRangeStart(point.Y?.Min())
                        </span>
                        <span class="me-1">
                            @ChartHelper.FormatTooltipRangeEnd(point.Y?.Max())
                        </span>

                    </div>
                }
            </div>
        </ApexPointTooltip>
    </ApexChart>
}

@code
{
    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    [Parameter]
    public ChartModel ChartModel { get; set; }

    [Parameter]
    public Action<SelectedData<ChartItem>> OnDataPointSelection { get; set; }   

    [Parameter]
    public Action<ZoomedData<ChartItem>> OnChartZoomed { get; set; }

    [Parameter]
    public Func<ChartItem, MarkupString> Value1TooltipFormatter { get; set; }

    [Parameter]
    public Func<ChartItem, MarkupString> Value2TooltipFormatter { get; set; }

    private string title;
    private ApexChartOptions<ChartItem> chartOptions;
    private IEnumerable<ChartItem> confirmedChartItems;
    private IEnumerable<ChartItem> provisionalChartItems;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (ChartModel == null)
        {
            Debug.WriteLine("** CHART MODEL IS NULL!");
        }
        else
        {
            title = ChartModel.ChartTitle;
            chartOptions = ChartModel.ChartOptions;
            confirmedChartItems = ChartModel.ConfirmedChartItems;
            provisionalChartItems = ChartModel.ProvisionalChartItems;
        }

        if (Value2TooltipFormatter == null)
        {
            Value2TooltipFormatter = DefaultValue2Formatter;
        };

        if (Value1TooltipFormatter == null)
        {
            Value1TooltipFormatter = DefaultValue1Formatter;
        };
    }

    /// <summary>
    /// If there is no formatter for value 1 in the tooltip provided then this will be used
    /// </summary>
    /// <param name="item"></param>
    /// <returns></returns>
    private MarkupString DefaultValue1Formatter(ChartItem item)
    {
        return (MarkupString)$"<h3>{item?.Value1} FTE</h3>";
    }

    /// <summary>
    /// If there is no formatter for value 2 in the tooltip provided then this will be used
    /// </summary>
    /// <param name="item"></param>
    /// <returns></returns>
    private MarkupString DefaultValue2Formatter(ChartItem item)
    {
        return (MarkupString)$"<h5>({item?.Value2} FTE Availability)</h5>";
    }
}