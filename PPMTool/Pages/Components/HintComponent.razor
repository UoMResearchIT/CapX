<RadzenCard class="timesheet-note my-3">
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
        <RadzenIcon Icon="info" IconStyle="IconStyle.Info" />
        @Message
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter]
    public string Message { get; set; }
}
