@inherits BaseFinanceItemFormComponent
@using Microsoft.Extensions.Logging
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Services
@using Radzen
@using PPMTool.Data.Entities

<RadzenTemplateForm TItem="FundingSource" Submit="@(() => HandleValidSubmit())" Data="@Source">
    <RadzenFieldset Text="Funding Source Details">
        <RadzenStack Orientation="Radzen.Orientation.Vertical">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal">
                <RadzenStack Orientation="Radzen.Orientation.Vertical">
                    <RadzenLabel Component="SourceType" Text="Source Type" class="font-weight-bold" />
                    <RadzenDropDown @bind-Value="Source.FundingSourceType" Name="SourceType" Data="@sourceTypes">
                        <Template Context="item">
                            @(((FundingSourceType)item).GetDescription())
                        </Template>
                    </RadzenDropDown>
                </RadzenStack>
                <RadzenStack Orientation="Radzen.Orientation.Vertical">
                    <RadzenLabel Component="Amount" Text="Amount Available" class="font-weight-bold" />
                    <RadzenNumeric @bind-Value="Source.AmountAvailable" Name="Amount" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.01" Placeholder="0.00" Style="width:100%;" Format="@("£0.00")" />
                </RadzenStack>
            </RadzenStack>
            <RadzenLabel Component="HasAccount" Text="Account Code Associated with Source?" class="font-weight-bold" />
            <RadzenSwitch @bind-Value="Source.HasAccountCode" Name="HasAccount" />
            @if (Source.HasAccountCode)
            {
                <RadzenLabel Component="AccountCode" Text="Account Code" class="font-weight-bold" />
                <RadzenTextBox @bind-Value="Source.AccountCode" Name="AccountCode" Placeholder="e.g. R123456" />
            }
            <RadzenLabel Component="Description" Text="Description" class="font-weight-bold" />
            <RadzenTextBox @bind-Value="Source.Description" Name="Description" Placeholder="Describe this funding source if you can..." />
        </RadzenStack>
    </RadzenFieldset>
    <br />
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <RadzenStack Orientation="Radzen.Orientation.Horizontal">
            <RadzenIcon IconStyle="IconStyle.Danger" Icon="warning" />
            <RadzenText Text="@errorMessage" Style="color: red" />
        </RadzenStack>
    }
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@(args => DeleteFundingSource())" Disabled="@(Source?.FundingSourceId < 1 || !EditAuthorised)" />
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Save" Icon="check" ButtonType="ButtonType.Submit" Disabled="@(!EditAuthorised)" />
            <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@(args => CloseForm(false))" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {

    [Parameter]
    public FundingSource Source { get; set; }

    [Inject]
    private FundingSourceService FundingSourceService { get; set; }

    [Inject]
    private ProjectService ProjectService { get; set; }

    private IEnumerable<FundingSourceType> sourceTypes;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // If no source model set then create a new one
        if (Source == null)
        {
            Source = new FundingSource
            {
                Project = Project
            };
        }
        sourceTypes = Enum.GetValues<FundingSourceType>();
        SetFinanceItemModel(Source);
    }

    protected override bool HandleValidSubmit()
    {
        var valid = base.HandleValidSubmit();
        if (!valid)
        {
            return false;
        }

        if (Source.FundingSourceType != FundingSourceType.Other && Source.HasAccountCode && string.IsNullOrWhiteSpace(Source.AccountCode))
        {
            errorMessage = "You must provide an account code for this funding source e.g. R123456";
            return false;
        }

        if (Source.FundingSourceType != FundingSourceType.Other && Source.AmountAvailable <= 0)
        {
            errorMessage = "There must be a non-zero amount of funds available to pay for the service in a DA/DI funding source!";
            return false;
        }

        if (Source.FundingSourceId > 0)
        {
            FundingSourceService.Update(Context, Source);
            PostNoteToProject(FinanceItemChangeType.Update, Source);
        }
        else
        {
            FundingSourceService.Add(Context, Source);
            PostNoteToProject(FinanceItemChangeType.Add, Source);
        }

        UpdateProjectBudget();
        CloseForm(true);
        return true;
    }

    /// <summary>
    /// Separate method to update the project budget after funding source changes
    /// </summary>
    private void UpdateProjectBudget()
    {
        // Update the project budget and save the project
        var sources = FundingSourceService.GetFundingSources(Context, Project.ProjectId);
        Project.Budget = sources.Sum(x => x.AmountAvailable);
        ProjectService.Update(Context, Project);
    }

    /// <summary>
    /// Method to delete a funding source after a prompt
    /// </summary>
    private async void DeleteFundingSource()
    {
        bool confirmed = await DialogService.Confirm($"You are about to delete funding source with ID {Source.FundingSourceId}. This cannot be undone!",
                    "Delete Funding Source") ?? false;
        if (confirmed)
        {
            Logger?.LogInformation($"Deleting funding source ID {Source.FundingSourceId}");

            FundingSourceService.Delete(Context, Source);
            PostNoteToProject(FinanceItemChangeType.Delete, Source);
            UpdateProjectBudget();
            CloseForm(true);
        }
    }

    /// <summary>
    /// Return the funding source ID
    /// </summary>
    /// <returns></returns>
    protected override int GetItemId()
    {
        return Source?.FundingSourceId ?? 0;
    }
}