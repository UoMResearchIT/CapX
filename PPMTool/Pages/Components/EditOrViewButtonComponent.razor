@using PPMTool.Data.Entities

<RadzenButton Icon=@(CanViewOnly ? "visibility" : "edit")
              ButtonStyle="@(CanViewOnly ? ButtonStyle.Light : ButtonStyle.Primary)"
              class="m-1"
              Click="@(() => OnButtonClick?.Invoke(CanViewOnly))"
              @onclick:stopPropagation="true"
              Disabled=@IsDisabled
              MouseEnter="@(args => ShowTooltip(args, CanViewOnly ? "View" : "Edit"))" />

@code {
    [Parameter]
    public bool CanViewOnly { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public Action<bool> OnButtonClick { get; set; }

    [Parameter]
    public Action<ElementReference, string> ShowTooltip { get; set; }
}
