@inherits BaseFinanceItemFormComponent
@using Microsoft.Extensions.Logging
@using PPMTool.Data.Context
@using PPMTool.Services
@using Radzen
@using PPMTool.Data.Entities

<RadzenTemplateForm TItem="Payment" Submit="@HandleValidSubmit" Data="@Payment">
    <RadzenFieldset Text="Payment Details">
        <RadzenStack Orientation="Radzen.Orientation.Vertical">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal">
                <RadzenDatePicker @bind-Value="Payment.KeyDate" Name="Date" DateFormat="dd/MM/yyyy" ShowTime="false" Style="width:50%;" />
                <RadzenNumeric @bind-Value="Payment.Value" Name="Amount" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.01" Placeholder="0.00" Style="width:50%;" Format="@("£0.00")"/>
            </RadzenStack>
            <RadzenTextArea @bind-Value="Payment.Description" Name="Notes" Placeholder="Optional notes to describe the nature of the payment" Style="width: 100%; height: 10rem;" />
        </RadzenStack>
    </RadzenFieldset>
    <RadzenFieldset Text="Associated Invoice">
        <RadzenDropDown Data="@invoices"
        @bind-Value="Payment.Invoice"
        Name="InvoiceId"
        AllowClear="true"
        Style="width: 100%;">
            <Template Context="item">
                @($"{(item as Invoice)?.InvoiceId}: {(item as Invoice)?.InvoiceReference ?? "No Ref"} ({(item as Invoice)?.Value.ToString("C2")})")
            </Template>
        </RadzenDropDown>
    </RadzenFieldset>
    <br />
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.End">
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <RadzenIcon IconStyle="IconStyle.Danger" Icon="warning" />
            <RadzenText Text="@errorMessage" Style="color: red" />
        }
        <RadzenButton Text="Save" Type="Submit" />
        <RadzenButton Text="Cancel" Click="@(args => CloseForm(false))" />
    </RadzenStack>
</RadzenTemplateForm>

@code {

    [Parameter]
    public Payment Payment { get; set; }

    private IEnumerable<Invoice> invoices;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // If no payment set then create a new payment model
        if (Payment == null)
        {
            Payment = new Payment
                {
                    Project = Project
                };
        }

        // Load invoices for the dropdown
        invoices = InvoiceService.GetAll(Context).Where(x => x.Project?.ProjectId == Project?.ProjectId);
    }

    protected override void HandleValidSubmit()
    {
        base.HandleValidSubmit();

        if (Payment.PaymentId > 0)
        {
            InvoiceService.UpdatePayment(Context, Payment);
        }
        else
        {
            InvoiceService.AddPayment(Context, Payment);
        }
        
        CloseForm(true);
    }
}