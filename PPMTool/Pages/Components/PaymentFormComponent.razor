@inherits BaseFinanceItemFormComponent
@using Microsoft.Extensions.Logging
@using PPMTool.Data.Context
@using PPMTool.Services
@using Radzen
@using PPMTool.Data.Entities
@inject DialogService DialogService

<RadzenTemplateForm TItem="Payment" Submit="@HandleValidSubmit" Data="@Payment">
    <RadzenFieldset Text="Payment Details">
        <RadzenDatePicker @bind-Value="Payment.KeyDate" Name="Date" />
        <RadzenNumeric @bind-Value="Payment.Value" Name="Amount" />
        <RadzenDropDown Data="@invoices"
        @bind-Value="Payment.Invoice"
        Name="InvoiceId">
            <Template Context="item">
                @($"{(item as Invoice)?.InvoiceId}: {(item as Invoice)?.InvoiceReference ?? "-"} ({(item as Invoice)?.Value.ToString("{0:C0}")})")
            </Template>
        </RadzenDropDown>
    </RadzenFieldset>
    <RadzenButton Text="Save" Type="Submit" />
    <RadzenButton Text="Cancel" Click="@(args => DialogService.Close(false))" />
</RadzenTemplateForm>

@code {

    [Parameter]
    public Payment Payment { get; set; }

    private IEnumerable<Invoice> invoices;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // If no payment set then create a new payment model
        if (Payment == null)
        {
            Payment = new Payment
                {
                    Project = Project
                };
        }

        // Load invoices for the dropdown
        invoices = InvoiceService.GetAll(Context).Where(x => x.Project?.ProjectId == Project?.ProjectId);
    }

    protected override void HandleValidSubmit()
    {
        base.HandleValidSubmit();

        DialogService.Close(true);
    }
}