@inherits BaseFinanceItemFormComponent
@using Radzen
@using PPMTool.Data.Entities
@inject DialogService DialogService

<RadzenTemplateForm TItem="Invoice" Submit="HandleValidSubmit" Data="@Invoice">
    <RadzenFieldset Text="Invoice Details">
        <RadzenDatePicker @bind-Value="Invoice.KeyDate" Name="Date" DateFormat="dd/MM/yyyy" ShowTime="false" />
        <RadzenNumeric @bind-Value="Invoice.Value" Name="Amount" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.01" Placeholder="0.00" />
    </RadzenFieldset>
    <RadzenButton Text="Save" Type="Submit" />
    <RadzenButton Text="Cancel" Click="@(args => DialogService.Close(false))" />
</RadzenTemplateForm>

@code {

    [Parameter]
    public Invoice Invoice { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // If no invoice set then create a new invoice model
        if (Invoice == null)
        {
            Invoice = new Invoice
                {
                    Project = Project
                };
        }
    }

    protected override void HandleValidSubmit()
    {
        base.HandleValidSubmit();

        DialogService.Close(true);
    }
}