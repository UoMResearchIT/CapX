@inherits BaseFinanceItemFormComponent
@using Microsoft.Extensions.Logging
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Data.Helpers
@using PPMTool.Enums
@using Radzen

<RadzenTemplateForm TItem="Invoice" Submit="@(() => HandleValidSubmit())" Data="@Invoice">
    <RadzenFieldset Text="Invoice Details">
        <RadzenStack Orientation="Radzen.Orientation.Vertical">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Stretch">
                <RadzenStack Orientation="Radzen.Orientation.Vertical">
                    <RadzenLabel Component="Date" Text="Invoice Date" class="font-weight-bold" />
                    <RadzenDatePicker @bind-Value="Invoice.KeyDate" Name="Date" DateFormat="dd/MM/yyyy" ShowTime="false" Style="width:100%;" />
                </RadzenStack>
                <RadzenStack Orientation="Radzen.Orientation.Vertical">
                    <RadzenLabel Component="Amount" Text="Amount" class="font-weight-bold" />
                    <RadzenNumeric @bind-Value="Invoice.Value" Name="Amount" TValue="double" Step="0.01" Placeholder="0.00" Style="width:100%;" Format="@("£0.00")" />
                </RadzenStack>
            </RadzenStack>
            <RadzenLabel Component="Notes" Text="Notes" class="font-weight-bold" />
            <RadzenTextArea @bind-Value="Invoice.Description" Name="Notes" Placeholder="Mandatory notes to describe the nature of the invoice" Style="width: 100%; height: 10rem;" />
            <RadzenLabel Component="InvoieReference" Text="Invoice Reference" class="font-weight-bold" />
            <RadzenTextBox @bind-Value="Invoice.InvoiceReference" Name="InvoiceReference" Style="width:100%; margin-left: 0;" Placeholder="Invoice Reference e.g. RTP-123-2425-1"/>
            <RadzenLabel Component="Status" Text="Status" class="font-weight-bold" />
            <HintComponent Message="The status of an invoice is determined from the linked payments or whether it has been marked as cancelled. Add and link a payment to update the invoice status or cancel it using the switch provided to update the status." />
            <RadzenBadge Text="@Invoice.Status.GetDescription()" BadgeStyle="@Invoice.Status.GetBadgeStyle()" />
            <RadzenLabel class="font-weight-bold" Text="Cancel Invoice?" Component="Cancel" />
            <RadzenSwitch Name="Cancel" Change="@CancelToggled" @bind-Value="isCancelled" />
            <RadzenLabel Component="InvoiceURL" Text="Link to Invoice" class="font-weight-bold" />
            <RadzenTextBox @bind-Value="Invoice.InvoiceUrl" Name="InvoiceURL" Placeholder="Link to Invoice e.g. https://" Style="width:100%; margin-left: 0;" />
        </RadzenStack>
    </RadzenFieldset>
    <br />
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <RadzenStack Orientation="Radzen.Orientation.Horizontal">
            <RadzenIcon IconStyle="IconStyle.Danger" Icon="warning" />
            <RadzenText Text="@errorMessage" Style="color: red" />
        </RadzenStack>
    }
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@(args => DeleteInvoice())" Disabled="@(Invoice?.InvoiceId < 1 || !EditAuthorised)" />
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Save" Icon="check" ButtonType="ButtonType.Submit" Disabled="@(!EditAuthorised)" />
            <RadzenButton Text="Cancel" Icon="close" ButtonStyle="ButtonStyle.Light" Click="@(args => CloseForm(false))" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {

    [Parameter]
    public Invoice Invoice { get; set; }

    private IEnumerable<InvoiceStatus> statuses;
    private bool isCancelled;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // If no invoice set then create a new invoice model
        if (Invoice == null)
        {
            Invoice = new Invoice
            {
                Project = Project
            };
        }

        // Statuses for the dropdown
        statuses = Enum.GetValues(typeof(InvoiceStatus)).Cast<InvoiceStatus>();

        // Set value of the switch
        isCancelled = Invoice.Status == InvoiceStatus.Cancelled;

        // Set the internal reference on the base class
        SetFinanceItemModel(Invoice);
    }

    /// <summary>
    /// Method to handle the change of invoice status when the cancel switch is toggled
    /// </summary>
    /// <param name="isCancelled"></param>
    private void CancelToggled(bool isCancelled)
    {
        if (isCancelled)
        {
            Invoice.Status = InvoiceStatus.Cancelled;
        }
        else
        {
            Invoice.Status = PaymentService.GetInvoiceStatusFromPayments(Context, Invoice);
        }
    }

    protected override bool HandleValidSubmit()
    {
        var valid = base.HandleValidSubmit();
        if (!valid)
        {
            return false;
        };

        // Validate
        if (string.IsNullOrWhiteSpace(Invoice.InvoiceReference))
        {
            Invoice.InvoiceReference = "None";
        }
        if (string.IsNullOrWhiteSpace(Invoice.Description))
        {
            errorMessage = "You must give this item a description!";
            return false;
        }
        if (!HtmlHelper.IsValidLink(Invoice.InvoiceUrl))
        {
            errorMessage = "Invoice URL is required which links to an invoice or email as a SharePoint document so there is a physical record of the payment request!";
            return false;
        }

        if (Invoice.InvoiceId > 0)
        {
            InvoiceService.Update(Context, Invoice);
            PostNoteToProject(FinanceItemChangeType.Update, Invoice);
        }
        else
        {
            InvoiceService.Add(Context, Invoice);
            PostNoteToProject(FinanceItemChangeType.Add, Invoice);
        }

        CloseForm(true);
        return true;
    }

    /// <summary>
    /// Method to delete an invoice after a prompt
    /// </summary>
    private async void DeleteInvoice()
    {
        bool confirmed = await DialogService.Confirm($"You are about to delete invoice with ID {Invoice.InvoiceId} and value {Invoice.Value.ToString("C2")}. This cannot be undone!",
                    "Delete Invoice") ?? false;
        if (confirmed)
        {
            Logger?.LogInformation($"Deleting invoice ID {Invoice.InvoiceId}");

            InvoiceService.Delete(Context, Invoice);
            PostNoteToProject(FinanceItemChangeType.Delete, Invoice);
            CloseForm(true);
        }
    }

    /// <summary>
    /// Return the invoice ID
    /// </summary>
    /// <returns></returns>
    protected override int GetItemId()
    {
        return Invoice?.InvoiceId ?? 0;
    }
}