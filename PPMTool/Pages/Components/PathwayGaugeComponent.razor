@using PPMTool.Data.Entities
@using PPMTool.Enums

@if (dataItems != null)
{
    <ApexChart TItem="DataItem"
               Title="@Title">

        <ApexPointSeries TItem="DataItem"
                         Items="dataItems"
                         Name="Assessments"
                         XValue="@(e => e.Status)"
                         YValue="@(e => e.Value)"
                         SeriesType="SeriesType.Donut" />
    </ApexChart>
}

