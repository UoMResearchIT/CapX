@using PPMTool.Data.Entities
<RadzenCard Style="min-height:1rem">
    <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenText Text="@Competency.GetHierarchyId()" TextStyle="TextStyle.H5" />
            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" />
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.H5">
            @((MarkupString)Competency.Description)
        </RadzenText>
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Wrap="FlexWrap.Wrap">
                <RadzenText Text="Objective" TextStyle="TextStyle.Subtitle1" />
                <RadzenText TextStyle="TextStyle.Body1">
                    @((MarkupString)Competency.Objective)
                </RadzenText>
            </RadzenStack>
            <RadzenButton class="align-self-end" Text="Add Assessment" Icon="add" />
        </RadzenStack>
    </RadzenStack>
</RadzenCard>

@code {
    [Parameter]
    public Competency Competency { get; set; }
}
