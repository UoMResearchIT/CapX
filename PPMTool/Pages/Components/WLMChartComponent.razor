@using System.Diagnostics
@using PPMTool.Data.Enums
@using PPMTool.Models

<RadzenColumn Style="min-width: 50rem">
    <RadzenCard>
        <ApexChart TItem="WLMWeeklyDataChartItem"
                   Title="@Title"
                   Options="@ChartOptions"
                   XAxisType="XAxisType.Datetime"
                   OnDataPointSelection="@(args => OnDataPointSelected?.Invoke(args, Title))"
                   @ref="chart">

            @if (CompareToWorkloadModel)
            {
                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.ProjectWork.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WLMNetByDuty[Duty.ProjectWork])))"
                                 Color="@Duty.ProjectWork.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.BAU.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WLMNetByDuty[Duty.BAU])))"
                                 Color="@Duty.BAU.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.PersonalDevelopment.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WLMNetByDuty[Duty.PersonalDevelopment])))"
                                 Color="@Duty.PersonalDevelopment.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.StaffMgmt.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WLMNetByDuty[Duty.StaffMgmt])))"
                                 Color="@Duty.StaffMgmt.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.ProjectAndServiceMgmt.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WLMNetByDuty[Duty.ProjectAndServiceMgmt])))"
                                 Color="@Duty.ProjectAndServiceMgmt.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.RSA.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WLMNetByDuty[Duty.RSA])))"
                                 Color="@Duty.RSA.GetBackgroundColourCode()" />
            }
            else
            {
                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.Other.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WeeklyValuesByDuty[Duty.Other])))"
                                 Color="@Duty.Other.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.ProjectWork.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WeeklyValuesByDuty[Duty.ProjectWork])))"
                                 Color="@Duty.ProjectWork.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.BAU.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WeeklyValuesByDuty[Duty.BAU])))"
                                 Color="@Duty.BAU.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.PersonalDevelopment.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WeeklyValuesByDuty[Duty.PersonalDevelopment])))"
                                 Color="@Duty.PersonalDevelopment.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.StaffMgmt.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WeeklyValuesByDuty[Duty.StaffMgmt])))"
                                 Color="@Duty.StaffMgmt.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.ProjectAndServiceMgmt.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WeeklyValuesByDuty[Duty.ProjectAndServiceMgmt])))"
                                 Color="@Duty.ProjectAndServiceMgmt.GetBackgroundColourCode()" />

                <ApexPointSeries TItem="WLMWeeklyDataChartItem"
                                 Items="ChartItems"
                                 SeriesType="@SeriesType.Bar"
                                 Name="@Duty.RSA.GetDescription()"
                                 XValue="@(e => e.WeekStart.ToUnixTimeMilliseconds())"
                                 YAggregate="@(e => Convert.ToDecimal(e.Sum(e => e.WeeklyValuesByDuty[Duty.RSA])))"
                                 Color="@Duty.RSA.GetBackgroundColourCode()" />
            }
        </ApexChart>
        <hr />
        <RadzenText Text="@($"Average for the Weeks Beginning ({ChartItems.Min(x => x.WeekStart).ToString("dd/MM/yyyy")} - {ChartItems.Max(x => x.WeekStart).ToString("dd/MM/yyyy")})")" TextAlign="TextAlign.Center" TextStyle="TextStyle.H5" />
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        @foreach (var duty in Enum.GetValues<Duty>().Where(x => x != Duty.Other))
                        {
                            <th><RadzenText Text="@duty.GetDescription()" TextAlign="TextAlign.Center" TextStyle="TextStyle.Subtitle2" Style="@($"color: {duty.GetBackgroundColourCode()}")" /></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        @foreach (var duty in Enum.GetValues<Duty>().Where(x => x != Duty.Other))
                        {
                            <td>
                                <RadzenText Text="@GetTableValue(duty).ToString()" TextAlign="TextAlign.Center" Style="@($"color: {(Math.Abs(GetTableValue(duty)) > 0.1 ? "var(--rz-danger)" : "var(--rz-success)")};")" TextStyle="TextStyle.Subtitle1" />
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </RadzenCard>
</RadzenColumn>

@code
{
    [Parameter]
    public Action<SelectedData<WLMWeeklyDataChartItem>, string> OnDataPointSelected { get; set; }

    [Parameter]
    public ApexChartOptions<WLMWeeklyDataChartItem> ChartOptions { get; set; }

    [Parameter]
    public IEnumerable<WLMWeeklyDataChartItem> ChartItems { get; set; }

    [Parameter]
    public string Title { get; set; }

    [Parameter]
    public bool CompareToWorkloadModel { get; set; }

    [Parameter]
    public bool NormalisedByTotalHours { get; set; }

    [Parameter]
    public bool UseStackedBars { get; set; }

    public float? Min { get; private set; }
    public float? Max { get; private set; }

    private ApexChart<WLMWeeklyDataChartItem> chart;
    private bool normalisedByTotalHours;
    private bool compareToWorkloadModel;
    private bool useStackedBars;

    /// <summary>
    /// In response to changes in the parameters to the component update local values and execute methods
    /// </summary>
    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        var updateMinMax = false;
        if (NormalisedByTotalHours != normalisedByTotalHours)
        {
            normalisedByTotalHours = NormalisedByTotalHours;

            foreach (var item in ChartItems)
            {
                // Change the normalisation on the data
                item.SwitchNormalisation(normalisedByTotalHours);

                // Recompute the net values
                item.UpdateWLMNetValues(normalisedByTotalHours);
            }
            updateMinMax = true;            
        }

        if (CompareToWorkloadModel != compareToWorkloadModel)
        {
            compareToWorkloadModel = CompareToWorkloadModel;
            updateMinMax = true;
        }

        if (UseStackedBars != useStackedBars)
        {
            useStackedBars = UseStackedBars;
            updateMinMax = true;
        }

        // Recompute min-max
        if (updateMinMax)
        {
            UpdateMinMax();
        }

        // Update the chart options with the new object
        chart?.UpdateOptionsAsync(true, false, false);
    }

    /// <summary>
    /// Updates the vertical axis limits based on the limits of the individual chart items
    /// </summary>
    private void UpdateMinMax()
    {
        if (!compareToWorkloadModel)
        {
            if (normalisedByTotalHours)
            {
                Min = 0;
                Max = 1;
            }
            else
            {
                Min = 0;
                Max = (float)Math.Round(Convert.ToDecimal(ChartItems.Max(x => x.WeeklyValuesByDuty.Where(x => x.Key != Duty.Other).Sum(x => x.Value))), 1);
            }
        }
        else
        {
            Min = (float)Math.Floor(Convert.ToDecimal(ChartItems.Min(x => x.MinNet) * 100)) / 100f;
            Max = (float)Math.Ceiling(Convert.ToDecimal(ChartItems.Max(x => x.MaxNet) * 100)) / 100f;
        }

        Debug.WriteLine($"** Setting Max = {Max}; Min = {Min}");

        ChartOptions.Yaxis.First().Min = Min;
        ChartOptions.Yaxis.First().Max = Max;
    }

    /// <summary>
    /// Method to get the values in the averages table based on the switch settings
    /// </summary>
    /// <param name="duty"></param>
    /// <returns></returns>
    private double GetTableValue(Duty duty)
    {
        var subset = ChartItems.Where(x => x.TotalHoursBookedForWeek > 0);
        if (subset.Count() == 0) return 0;
        if (compareToWorkloadModel)
        {
            return Math.Round(subset.Average(x => x.WLMNetByDuty[duty]), 2);
        }
        return Math.Round(subset.Average(x => x.WeeklyValuesByDuty[duty]), 2);
    }
}