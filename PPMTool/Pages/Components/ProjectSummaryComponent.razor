@using Microsoft.EntityFrameworkCore
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Services
@using System.Diagnostics

<div class="card my-1">
    <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.3rem">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Gap="0.3rem">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenText TextStyle="TextStyle.H5" Text="@Project.GetFullName()" />
                <RadzenBadge Style="margin-bottom: 0.5rem"
                                BadgeStyle="@(
                                        Project.ProjectStatus.IsFinishedOrCancelled() ? BadgeStyle.Light :
                                        Project.ProjectStatus == ProjectStatus.Active ? BadgeStyle.Success :
                                        Project.ProjectStatus == ProjectStatus.Funded ? BadgeStyle.Info :
                                        BadgeStyle.Light)"
                                Text="@Project.ProjectStatus.ToNiceString()" />
            </RadzenStack>
            @if (OverDueNoteCount > 0)
            {
            
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-border-danger p-1" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenIcon IconStyle="IconStyle.Danger" Icon="flag"/>
                        <RadzenText TextStyle="TextStyle.Subtitle1" Text="@($"You have {OverDueNoteCount} note(s) overdue")" Style="margin-bottom: -0.1rem" />
                    </RadzenStack>
                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Text="View" Click="@(args => DueButtonClicked?.Invoke(Project))" />
                </RadzenStack>
            
            }
            @if (DueNoteCount > 0)
            {

                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" class="rz-border-warning p-1" JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenIcon IconStyle="IconStyle.Warning" Icon="flag" />
                        <RadzenText TextStyle="TextStyle.Subtitle1" Text="@($"You have {DueNoteCount} note(s) due")" Style="margin-bottom: -0.1rem" />
                    </RadzenStack>
                    <RadzenButton ButtonStyle="ButtonStyle.Warning" Text="View" Click="@(args => DueButtonClicked?.Invoke(Project))" />
                </RadzenStack>

            }
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End" Gap="0.3rem">
                <RadzenButton Click=@(args => EditProject(Project)) Text="Edit" Icon="edit" Disabled=!EditAuthorised />
                <RadzenSplitButton ButtonStyle="ButtonStyle.Primary" Text="Details" Icon="info" Click="@(item => DetailsButtonClicked(item, Project))">
                    <ChildContent>
                        <RadzenSplitButtonItem Text="Details in New Tab" Value="NewWindow" />
                    </ChildContent>
                </RadzenSplitButton>
                <RequestAndScrumButtonsComponent Project="@Project" ShowTooltip="ShowTooltip" />
            </RadzenStack>
        </RadzenStack>
        <MessageSummaryComponent Messages="Project.GetLatestStatusMessages()" />
    </RadzenStack>
</div>

@code {

    [Parameter]
    public Project Project { get; set; }

    [Parameter]
    public bool EditAuthorised { get; set; }

    [Parameter]
    public Action<RadzenSplitButtonItem, Project> DetailsButtonClicked { get; set; }

    [Parameter]
    public Action<Project> DueButtonClicked { get; set; }

    [Parameter]
    public Action<ElementReference, string> ShowTooltip { get; set; }

    [Parameter]
    public int DueNoteCount { get; set; }

    [Parameter]
    public int OverDueNoteCount { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; }

    override protected void OnInitialized()
    {
        base.OnInitialized();
    }

    private void EditProject(Project project)
    {
        Navigation.NavigateTo($"/addproject/{project.ProjectId}");
    }
}
