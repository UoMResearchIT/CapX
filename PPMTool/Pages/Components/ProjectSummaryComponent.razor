@using PPMTool.Enums

<div class="card m-1" style="width:200px; height:200px; display:flex; flex-direction:column">
    <b>@Data.Portfolio.ToNiceString()</b>
    <RadzenChart ColorScheme="ColorScheme.Palette">
        <RadzenDonutSeries Data="@data" CategoryProperty="DataItemCategory" ValueProperty="DataItemValue">
            <ChildContent>
                <RadzenLegend Visible="false" Position="Radzen.Blazor.LegendPosition.Bottom" />
            </ChildContent>
            <TooltipTemplate Context="data">
                <div>
                    <span>@data.DataItemCategory</span> : <strong>@data.DataItemValue</strong>
                </div>
            </TooltipTemplate>
            <TitleTemplate>
                <div class="rz-donut-content">
                    <h2>@Data.GetTotal()</h2>
                </div>
            </TitleTemplate>
        </RadzenDonutSeries>
    </RadzenChart>
</div>

@code {

    public class ProjectSummaryData
    {
        public int Incoming { get; set; }

        public int Active { get; set; }

        public int Complete { get; set; }

        public Portfolio Portfolio { get; set; }

        public int GetTotal()
        {
            return Incoming + Active + Complete;
        }
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        UpdateChartData();
    }

    [Parameter]
    public ProjectSummaryData Data { get; set; }

    private List<DataItem> data = new List<DataItem>();

    private void UpdateChartData()
    {
        data.Add(new DataItem
            {
                DataItemCategory = DataItemCategory.Incoming.ToString(),
                DataItemValue = Data.Incoming
            });
        data.Add(new DataItem
            {
                DataItemCategory = DataItemCategory.Active.ToString(),
                DataItemValue = Data.Active
            });
        data.Add(new DataItem
            {
                DataItemCategory = DataItemCategory.Complete.ToString(),
                DataItemValue = Data.Complete
            });
    }

    private class DataItem
    {
        public string DataItemCategory { get; set; }
        public int DataItemValue { get; set; }
    }

    private enum DataItemCategory
    {
        Incoming,
        Active,
        Complete
    }

}
