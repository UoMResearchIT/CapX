@using Microsoft.EntityFrameworkCore
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Services
@using System.Diagnostics

<div class="card my-1">
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.SpaceBetween" Gap="0rem" Wrap="FlexWrap.Wrap">
        <RadzenStack class="col-5 p-1" Orientation="Radzen.Orientation.Vertical" AlignItems="AlignItems.Start" Gap="0.3rem">
            <RadzenStack Orientation="Radzen.Orientation.Vertical" AlignItems="AlignItems.Start" Gap="0rem">
                <RadzenText TextStyle="TextStyle.H5" Text="@Project.GetFullName()" />
                <RadzenBadge Style="margin-bottom: 0.3rem"
                             BadgeStyle="@(
                                    Project.ProjectStatus.IsFinishedOrCancelled() ? BadgeStyle.Light :
                                    Project.ProjectStatus == ProjectStatus.Active ? BadgeStyle.Success :
                                    Project.ProjectStatus == ProjectStatus.Funded ? BadgeStyle.Info :
                                    BadgeStyle.Light)"
                             Text="@Project.ProjectStatus.ToNiceString()" />
            </RadzenStack>
            <MessageSummaryComponent Messages="Project.GetLatestStatusMessages()" />
        </RadzenStack>
            @if (DueNoteCount > 0 || OverDueNoteCount > 0)
            {
            <RadzenStack class="@($"col-3 p-1 {(OverDueNoteCount > 0 ? "rz-border-danger" : "rz-border-warning")}")" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.2rem">
                <RadzenText Text="Actions Due" TextStyle="TextStyle.Subtitle1" TextAlign="TextAlign.Center" Style="margin-bottom: -0.1rem;" />
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Gap="0.2rem" Wrap="FlexWrap.Wrap">
                    <RadzenIcon IconStyle="IconStyle.Danger" Icon="flag"/>
                    <RadzenText class="rz-border-radius-10 rz-background-color-danger p-2" TextStyle="TextStyle.Subtitle1" Text="@($"{OverDueNoteCount}")" Style="margin-bottom: -0.1rem; color: white" />
                    <RadzenIcon IconStyle="IconStyle.Warning" Icon="flag" />
                    <RadzenText class="rz-border-radius-10 rz-background-color-warning p-2" TextStyle="TextStyle.Subtitle1" Text="@($"{DueNoteCount}")" Style="margin-bottom: -0.1rem" />
                </RadzenStack>
                <RadzenButton ButtonStyle="@(OverDueNoteCount > 0 ? ButtonStyle.Danger : ButtonStyle.Warning)" Text="View" Click="@(args => DueButtonClicked?.Invoke(Project))" class="align-self-center" />
            </RadzenStack>
            }
        <RadzenStack class="col-4 p-1" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.End" JustifyContent="JustifyContent.End" Gap="0.3rem" Wrap="FlexWrap.Wrap">
            <RadzenButton Click=@(args => EditProject(Project)) Text="Edit" Icon="edit" Disabled=!EditAuthorised />
            <RadzenSplitButton ButtonStyle="ButtonStyle.Primary" Text="Details" Icon="info" Click="@(item => DetailsButtonClicked(item, Project))">
                <ChildContent>
                    <RadzenSplitButtonItem Text="Details in New Tab" Value="NewWindow" />
                </ChildContent>
            </RadzenSplitButton>
            <RequestAndScrumButtonsComponent Project="@Project" ShowTooltip="ShowTooltip" />
        </RadzenStack>
    </RadzenStack>
</div>

@code {

    [Parameter]
    public Project Project { get; set; }

    [Parameter]
    public bool EditAuthorised { get; set; }

    [Parameter]
    public Action<RadzenSplitButtonItem, Project> DetailsButtonClicked { get; set; }

    [Parameter]
    public Action<Project> DueButtonClicked { get; set; }

    [Parameter]
    public Action<ElementReference, string> ShowTooltip { get; set; }

    [Parameter]
    public int DueNoteCount { get; set; }

    [Parameter]
    public int OverDueNoteCount { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; }

    override protected void OnInitialized()
    {
        base.OnInitialized();
    }

    private void EditProject(Project project)
    {
        Navigation.NavigateTo($"projects/addproject/{project.ProjectId}");
    }
}
