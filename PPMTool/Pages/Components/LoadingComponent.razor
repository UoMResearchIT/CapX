<RadzenStack AlignItems="AlignItems.Center" Class="rz-m-12" Gap="2rem">
    <RadzenProgressBarCircular Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    <RadzenText TagName="TagName.Span" Text="@SpinnerText" TextStyle="TextStyle.Subtitle2" aria-label="@defaultText" />
</RadzenStack>

@code {
    [Parameter]
    public string SpinnerText { get; set; } = defaultText;

    [Parameter]
    public EventCallback<string> SpinnerTextChanged { get; set; }

    private string spinnerText = defaultText;

    private static readonly string defaultText = "Loading...";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (spinnerText != SpinnerText)
        {
            spinnerText = SpinnerText;
            SpinnerTextChanged.InvokeAsync(spinnerText);
        }
    }
}
