@using PPMTool.Data.Entities

<RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.3rem" AlignItems="AlignItems.End">
    @if (!Project.HasNoRequestDocLink())
    {
        <RadzenButton Click=@(args => ViewRequestDocClickedAsync(Project)) Text=@(ShowTooltip == null ? "View Request Doc": null) Icon="description" ButtonStyle="ButtonStyle.Dark" MouseEnter="@(args => ShowTooltip?.Invoke(args, "View Request Doc"))" />
    }
    @if (!string.IsNullOrWhiteSpace(Project.ScrumProjectLink))
    {
        <RadzenButton Click=@(args => ViewScrumBoardClickedAsync(Project)) Text=@(ShowTooltip == null ? "View Scrum Project": null) Icon="view_kanban" ButtonStyle="ButtonStyle.Dark" MouseEnter="@(args => ShowTooltip?.Invoke(args, "View Scrum Project"))" />
    }
</RadzenStack>

@code {

    [Parameter]
    public Project Project { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    [Parameter]
    public Action<ElementReference, string> ShowTooltip { get; set; }

    private async Task ViewRequestDocClickedAsync(Project project)
    {
        await JSRuntime.InvokeAsync<object>("open", $"{project.RequestDocLink}", "_blank");
    }

    private async Task ViewScrumBoardClickedAsync(Project project)
    {
        await JSRuntime.InvokeAsync<object>("open", $"{project.ScrumProjectLink}", "_blank");
    }
}
