@using System.Diagnostics
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Data.Helpers

<RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.3rem" AlignItems="AlignItems.End">
    <RadzenButton Click=@(args => ViewRequestDocClickedAsync(Project)) Text=@(ShowTooltip == null ? requestText : null) Icon="description" MouseEnter="@(args => ShowTooltip?.Invoke(args, requestText))" Disabled="@(!hasRequestDoc)" Size="@ButtonSize" />
    <RadzenButton Click=@(args => ViewScrumBoardClickedAsync(Project)) Text=@(ShowTooltip == null ? scrumText : null) Icon="view_kanban" MouseEnter="@(args => ShowTooltip?.Invoke(args, scrumText))" Disabled="@(!hasScrumLink)" Size="@ButtonSize" />
</RadzenStack>

@code {

    [Parameter]
    public Project Project { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    [Parameter]
    public Action<ElementReference, string> ShowTooltip { get; set; }

    [Parameter]
    public ButtonSize ButtonSize { get; set; } = ButtonSize.Medium;

    private bool hasScrumLink;
    private bool hasRequestDoc;
    private string scrumText;
    private string requestText;

    private async Task ViewRequestDocClickedAsync(Project project)
    {
        await JSRuntime.InvokeVoidAsync("open", $"{project?.RequestDocLink}", "_blank");
    }

    private async Task ViewScrumBoardClickedAsync(Project project)
    {
        await JSRuntime.InvokeVoidAsync("open", $"{project?.ScrumProjectLink}", "_blank");
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        hasScrumLink = HtmlHelper.IsValidLink(Project?.ScrumProjectLink);
        hasRequestDoc = !Project?.HasNoRequestDocLink() ?? false;
        scrumText = hasScrumLink ? "Scrum Project" : "No Scrum Project";
        requestText = hasRequestDoc ? "Request Doc" : "No Request Doc";
    }
}
