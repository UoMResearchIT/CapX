@using PPMTool.Data.Context
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Services

<RadzenStack class="mt-1" Orientation="Radzen.Orientation.Vertical" AlignItems="AlignItems.Center" Gap="0.1rem">
    <RadzenImage Path="@($"images/emb_{SkillTag.Rareness.GetAttribute<IconAttribute>()?.Name}.png")" Style="width: 3rem; height: 3rem;" title="@($"{count} RSE(s) with this tag")" />
    <RadzenText TextStyle="TextStyle.Body2" Text="@SkillTag.Rareness.ToString()" Style="@($"color: {SkillTag.Rareness.GetTextColourCode()}; margin-bottom: 0;")" />
</RadzenStack>

@code {

    [Inject]
    private SkillTagService TagService { get; set; }

    [Parameter]
    public SkillTag SkillTag { get; set; }

    [Parameter]
    public PPMToolContext Context { get; set; }

    private int count;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Initialise the rareness for the tag
        var rareness = TagService.GetRareness(Context, SkillTag.SkillTagId);
        SkillTag.Rareness = rareness.Rareness;
        count = rareness.Count;
    }
}
