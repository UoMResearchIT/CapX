@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@using PPMTool.Data
@using System.Diagnostics
@using PPMTool.Data.Context
@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Services

<div class="row">
    <div class="col">
        <h2>Suggested Resources</h2>
    </div>
    <div class="col-auto" style="align-content: center">
        <RadzenButton Text="Refresh" Icon="refresh" Click="@Refresh" />
    </div>
</div>
<div class="card">
    <CapacityQueryTableComponent Results="queryResults" />
</div>
<hr />

@code {
    private IEnumerable<CapacityQueryItem> queryResults;

    [Parameter]
    public SubTask TaskModel { get; set; }

    [Inject]
    private ILogger Logger { get; set; }

    [Inject]
    SkillTagService SkillTagService { get; set; }

    [Inject]
    IDbContextFactory<PPMToolContext> DbContextFactory { get; set; }

    [Inject]
    ProjectService ProjectService { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        RunQuery();
    }

    /// <summary>
    /// Refresh the suggestions
    /// </summary>
    private void Refresh()
    {
        RunQuery();
    }

    /// <summary>
    /// Runs the capacity query and updates the query result property
    /// </summary>
    private void RunQuery()
    {
        Debug.WriteLine($"** Running query {TaskModel.StartDate.ToShortDateString()} - {TaskModel.EndDate.ToShortDateString()} @ {TaskModel.UnmetDemand} with skills {string.Join('|', TaskModel.SkillsRequired ?? new List<SkillTag>())}...");

        // Re-initialise the results
        queryResults = new List<CapacityQueryItem>();

        // Return early if the query doesn't make sense
        if (TaskModel.UnmetDemand <= 0)
        {
            Debug.WriteLine("** Unmet demand is zero!");
            return;
        }

        // Start query state
        Logger.LogInformation("Looking for resource suggestions...");

        // Find people with at least one matching skill tag
        var context = DbContextFactory.CreateDbContext();
        var matchingPeople = SkillTagService.GetPeopleWithAtLeastOneMatch(context, TaskModel.SkillsRequired);
        Debug.WriteLine($"** Found {matchingPeople.Count()} people with at least one matching skill");

        // Get projects
        var validProjects = ProjectService
            .GetAll(context)
            .Where(x => !x.ProjectStatus.IsCancelled())
            .Where(x => x.StartDate.Year > 2000);
        if (validProjects.Count() == 0)
        {
            Debug.WriteLine("** No valid projects found!");
            return;
        }
        var startDate = validProjects.Min(x => x.StartDate);
        var endDate = validProjects.Max(x => x.EndDate);

        // Go through the people
        foreach (var person in matchingPeople)
        {
            // Create list of assignments for this person
            var assignments = new List<Assignment>();
            foreach (var project in validProjects)
            {
                foreach (var subTask in project.SubTasks)
                {
                    if (subTask.AssignedResources.Any(z => z.Person == person))
                    {
                        assignments.Add(new Assignment(subTask, project.ProjectStatus));
                    }
                }
            }

            // Generate availability profiles over the period
            // Value 1 function produces the availability of the individual taking into account their current assignments and WLM
            var blocksAsChartItems = ChartHelper.ConvertAssignmentsToChartItemsForPerson(
                person,
                assignments,
                assignments =>
                {
                    // TODO: This needs to compute the difference between the requirement of the task 
                    // and the person's availability based on their project work allowance

                    return assignments.RoundedSum(assignment =>
                    {
                        var resource = (assignment as Assignment)?.SubTask.AssignedResources.First(x => x.Person.Name == person.Name);
                        return resource?.AssignmentFTE ?? 0;
                    });
                },
                (value1, value2) =>
                {
                    return ChartItem.GetColourStringFTE(value1, value2);
                },
                person.Name,
                startDate,
                endDate,
                assignments =>
                {
                    return assignments.Any(assignment =>
                    {
                        // If any resources are marked as provisional or the project owning the task
                        // is not funded, active or in maintenance
                        return
                            assignment.ProjectStatus.IsUnconfirmed() ||
                            ((assignment as Assignment)?.SubTask.AssignedResources.First(x => x.Person == person).IsProvisional ?? true);
                    });
                },
                gapFillingFunction: (assignments, gapStart, gapEnd) =>
                {
                    return ChartHelper.FillGapsBetweenChartItemsFromWorkloadModels(person, gapStart, gapEnd, wlm => wlm?.ProjectWorkFTE ?? person.FTE);
                }
            );


            // Convert these profiles to chart query items including the relevant meta data of each block

            // Order by descending match quality (i.e. to develop skill, most skills by number, most FTE, most duration)

            // Take into account whether availability is provisional or not

            // The plotting will essentially be an assembly of divs up to 100 percent of the query duration
        }

    }
}
