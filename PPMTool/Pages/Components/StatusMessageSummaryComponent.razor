@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Data
@using static PPMTool.Data.StatusMessage

@if (ShowMessages && Messages != null)
{
    var activeMessages = IgnoreStatus ? Messages : Messages.Where(x => x.Status).ToList();
    <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.1rem" class="align-self-start">
        @foreach (var message in activeMessages)
        {
            // Show the message if it has no feature dependencies (default) or the relevant feature is enabled
            if (message.RelevantFeature == FeatureType.None || RelevantFeatures.Contains(message.RelevantFeature))
            {
                <StatusMessageComponent Message=message />
            }
        }
    </RadzenStack>
}
else
{
    <div class="row">
        <div class="col-auto">
            <StatusMessageIconComponent Messages=@Messages Type="MessageType.Success" />
            <StatusMessageIconComponent Messages=@Messages Type="MessageType.Info" />
            <StatusMessageIconComponent Messages=@Messages Type="MessageType.Warning" />
            <StatusMessageIconComponent Messages=@Messages Type="MessageType.Error" />
        </div>
    </div>
}

@code {
    [Parameter]
    public IList<StatusMessage> Messages { get; set; }

    [Parameter]
    public bool ShowMessages { get; set; } = true;

    [Parameter]
    public bool IgnoreStatus { get; set; } = false;

    [Parameter]
    public List<FeatureType> RelevantFeatures { get; set; } = new List<FeatureType>();
}
