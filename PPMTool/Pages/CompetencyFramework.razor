@page "/competencies"
@using DotNetExtensions
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using PPMTool.Enums
@inherits BasePage

<div class="container">
    <div class="row">
        <div class="col">
            <h2>Development Pathway</h2>
        </div>
    </div>
    <hr />
    <RadzenCard>
        Dropdown to select person and wheels showing progress at each grade
    </RadzenCard>
    <br />
    <div class="row">
        <div class="col">
            <h2>Framework Contents</h2>
        </div>
        <div class="col-auto">
            <RadzenButton Icon="add" Text="Add Competency" Click="AddCompetency" Disabled="!EditAuthorised" />
        </div>
    </div>
    <hr />
    <RadzenAccordion Multiple="true">
        <Items>
            <RadzenAccordionItem Text="Grade 5" Icon="counter_1" CollapseTitle="Collapse"
                                 ExpandTitle="Expand" CollapseAriaLabel="Collapse the Grade 5 Competencies"
                                 ExpandAriaLabel="Expand the Grade 5 Competencies" Selected="true">
                <Template>
                    <h3>Foundation Level (Grade 5)</h3>
                </Template>
                <ChildContent>
                    <RadzenAccordion Multiple="true">
                        <Items>
                            @foreach (var group in competencies.Where(x => x.Grade == 5).GroupBy(x => x.Category))
                            {
                                <RadzenAccordionItem Text="@($"Grade 5 {group.Key.GetDescription()} Competencies")" Icon="@(group.Key.GetAttribute<IconAttribute>().Name)" CollapseTitle="Collapse"
                                                    ExpandTitle="Expand" CollapseAriaLabel="@($"Collapse the Grade 5 {group.Key.GetDescription()} Competencies")"
                                                    ExpandAriaLabel="@($"Expand the Grade 5 {group.Key.GetDescription()} Competencies")">
                                    <Template>
                                        <h4>@group.Key.GetDescription()</h4>
                                    </Template>
                                    <ChildContent>
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                                            @foreach (var competency in group)
                                            {
                                                <CompetencyCard Competency="competency"
                                                                EditAuthorised="userIsSuperuser"
                                                                EditCompetencyAction="@(competency => EditCompetency(competency))"
                                                                ShowTooltip="@((arg, message) => ShowTooltip(arg, message))"
                                                                SelectedPerson="selectedPerson" />
                                            }
                                        </RadzenStack>
                                    </ChildContent>
                                </RadzenAccordionItem>
                            }
                        </Items>
                    </RadzenAccordion>
                </ChildContent>
            </RadzenAccordionItem>
            <RadzenAccordionItem Text="Grade 6" Icon="counter_2" CollapseTitle="Collapse"
                                 ExpandTitle="Expand" CollapseAriaLabel="Collapse the Grade 6 Competencies"
                                 ExpandAriaLabel="Expand the Grade 6 Competencies" Selected="true">
                <Template>
                    <h3>Advanced Level (Grade 6)</h3>
                </Template>
                <ChildContent>
                    <RadzenAccordion Multiple="true">
                        <Items>
                            @foreach (var group in competencies.Where(x => x.Grade == 6).GroupBy(x => x.Category))
                            {
                                <RadzenAccordionItem Text="@($"Grade 6 {group.Key.GetDescription()} Competencies")" Icon="@(group.Key.GetAttribute<IconAttribute>().Name)" CollapseTitle="Collapse"
                                                     ExpandTitle="Expand" CollapseAriaLabel="@($"Collapse the Grade 6 {group.Key.GetDescription()} Competencies")"
                                                     ExpandAriaLabel="@($"Expand the Grade 6 {group.Key.GetDescription()} Competencies")">
                                    <Template>
                                        <h4>@group.Key.GetDescription()</h4>
                                    </Template>
                                    <ChildContent>
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                                            @foreach (var competency in group)
                                            {
                                                <CompetencyCard Competency="competency"
                                                                EditAuthorised="userIsSuperuser"
                                                                EditCompetencyAction="@(competency => EditCompetency(competency))"
                                                                ShowTooltip="@((arg, message) => ShowTooltip(arg, message))" />
                                            }
                                        </RadzenStack>
                                    </ChildContent>
                                </RadzenAccordionItem>
                            }
                        </Items>
                    </RadzenAccordion>
                </ChildContent>
            </RadzenAccordionItem>
            <RadzenAccordionItem Text="Grade 7" Icon="counter_3" CollapseTitle="Collapse"
                                 ExpandTitle="Expand" CollapseAriaLabel="Collapse the Grade 7 Competencies"
                                 ExpandAriaLabel="Expand the Grade 7 Competencies" Selected="true">
                <Template>
                    <h3>Leadership Level (Grade 7)</h3>
                </Template>
                <ChildContent>
                    <RadzenAccordion Multiple="true">
                        <Items>
                            @foreach (var group in competencies.Where(x => x.Grade == 7).GroupBy(x => x.Category))
                            {
                                <RadzenAccordionItem Text="@($"Grade 7 {group.Key.GetDescription()} Competencies")" Icon="@(group.Key.GetAttribute<IconAttribute>().Name)" CollapseTitle="Collapse"
                                                     ExpandTitle="Expand" CollapseAriaLabel="@($"Collapse the Grade 7 {group.Key.GetDescription()} Competencies")"
                                                     ExpandAriaLabel="@($"Expand the Grade 7 {group.Key.GetDescription()} Competencies")">
                                    <Template>
                                        <h4>@group.Key.GetDescription()</h4>
                                    </Template>
                                    <ChildContent>
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                                            @foreach (var competency in group)
                                            {
                                                <CompetencyCard Competency="competency"
                                                                EditAuthorised="userIsSuperuser"
                                                                EditCompetencyAction="@(competency => EditCompetency(competency))"
                                                                ShowTooltip="@((arg, message) => ShowTooltip(arg, message))" />
                                            }
                                        </RadzenStack>
                                    </ChildContent>
                                </RadzenAccordionItem>
                            }
                        </Items>
                    </RadzenAccordion>
                </ChildContent>
            </RadzenAccordionItem>
        </Items>
    </RadzenAccordion>
    <br />
</div>