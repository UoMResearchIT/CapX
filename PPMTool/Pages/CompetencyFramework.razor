@page "/competencies"
@using DotNetExtensions
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using PPMTool.Enums
@inherits BasePage
<PageTitle>Development Journey - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col">
            <h2>Development Journey Summary</h2>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <RadzenText Text="Your development journey and competency framework assessments are only visible to you, your line manager and system super-users. It is designed as a tool for personal reflection and a mechanism to monitor your own development journey as an RSE. You may wish to share this with your line manager to assist with the setting of Role-Based Objectives as part of your Personal Development Review (PDR)." TextStyle="TextStyle.Body2" />
        </div>
    </div>
    <hr />
    <RadzenCard>
        <RadzenStack Orientation="Radzen.Orientation.Vertical">
            <RadzenStack class="radzen-shaded" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Wrap="FlexWrap.Wrap">
                <RadzenText Text="Show Journey For:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0rem"/>
                <RadzenDropDown @bind-Value="@selectedPerson" TValue="Person" TextProperty="Name" Change="PersonSelected" Data="@availablePeople" Style="width:100%" Disabled="!EditAuthorised" />
            </RadzenStack>
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceEvenly" Wrap="FlexWrap.Wrap">
                <PathwayGaugeComponent AssessmentsForGradeAndPerson="@(competencies.Where(x => x.Grade == 5).SelectMany(x => x.Assessments).Where(x => x.Person.PersonId == selectedPerson.PersonId))"
                                       TotalNumberOfCompetenciesInGrade="@(competencies.Where(x => x.Grade == 5).Count())"
                                       Title="Foundation Level (Grade 5)" />
                <PathwayGaugeComponent AssessmentsForGradeAndPerson="@(competencies.Where(x => x.Grade == 6).SelectMany(x => x.Assessments).Where(x => x.Person.PersonId == selectedPerson.PersonId))"
                                       TotalNumberOfCompetenciesInGrade="@(competencies.Where(x => x.Grade == 6).Count())"
                                       Title="Advanced Level (Grade 6)" />
                <PathwayGaugeComponent AssessmentsForGradeAndPerson="@(competencies.Where(x => x.Grade == 7).SelectMany(x => x.Assessments).Where(x => x.Person.PersonId == selectedPerson.PersonId))"
                                       TotalNumberOfCompetenciesInGrade="@(competencies.Where(x => x.Grade == 7).Count())"
                                       Title="Leadership Level (Grade 7)" />
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
    <br />
    <RadzenCard>
        <RadzenStack Orientation="Radzen.Orientation.Vertical">
            <RadzenStack class="radzen-shaded" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Wrap="FlexWrap.Wrap">
                <RadzenText Text="Upload Legacy Excel Spreadsheet For:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0rem" />
                <RadzenDropDown @bind-Value="@selectedPerson" TValue="Person" TextProperty="Name" Change="PersonSelected" Data="@availablePeople" Style="width:100%" Disabled="!userIsSuperuser" />
                @if (userIsSuperuser || activeUserId == selectedPerson.PersonId)
                {
                    <RadzenStack Orientation="Radzen.Orientation.Vertical" AlignItems="AlignItems.Start" JustifyContent="JustifyContent.Start" Wrap="FlexWrap.Wrap">
                        <RadzenText Text="Upload Legacy Assessment Grid:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0rem" />
                        <RadzenText Text="This feature is deprecated and will be removed in the next release. This could be your last chance to import your competency grid from the legacy Excel spreadsheet!" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0rem; color: red" />
                        <RadzenFileInput @bind-Value=@file @bind-FileName=@fileName @bind-FileSize=@fileSize TValue="byte[]" Style="width: 100%" Disabled="Loading"
                                         Accept="text/plain" Change=@(args => OnFileChanged(args, "FileInput")) Error=@(args => OnError(args, "FileInput"))
                                         InputAttributes="@(new Dictionary<string,object>(){ { "aria-label", "select file" }})" />
                    </RadzenStack>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>
    <br />
    <div class="row">
        <div class="col">
            <h2>Competencies Framework Assessment</h2>
        </div>
        <div class="col-auto">
            <RadzenButton Icon="add" Text="Add Competency" Click="AddCompetency" Disabled="!userIsSuperuser" />
        </div>
    </div>
    <div class="row">
        <div class="col">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" Style="margin-top: -0.3rem; width: 100%">
                <RadzenIcon Icon="search" IconStyle="IconStyle.Dark" />
                <RadzenTextBox @bind-Value=@competencySearchTerms
                                Placeholder="Search Competencies"
                                Change=@FilterCompetencies
                                Style="width:100%" />
                <RadzenButton Icon="clear" ButtonStyle="ButtonStyle.Light" Click="@ClearSearch" MouseEnter="@(args => ShowTooltip(args, "Clear"))" />
            </RadzenStack>
        </div>
    </div>
    <hr />
    <RadzenAccordion Multiple="true">
        <Items>
            @for (int g = 5; g < 8; ++g)
            {
                var grade = g;
                <RadzenAccordionItem Text="@($"Grade {grade}")" Icon="counter_1" CollapseTitle="Collapse"
                                     ExpandTitle="Expand" CollapseAriaLabel="@($"Collapse the Grade {grade} Competencies")"
                                     ExpandAriaLabel="Expand the Grade 5 Competencies" Selected="@gradeAccordionSelected[5]">
                    <Template>
                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                            <h3 style="margin-bottom:0.2rem; color: #609">Foundation Level (Grade 5)</h3>
                            <RadzenProgressBar Value="competencies.Where(x => x.Grade == 5).SelectMany(x => x.Assessments).Where(x => x.Status == AssessmentStatus.FullyMet && x.Person.PersonId == selectedPerson.PersonId).DistinctBy(x => x.AssociatedCompetency.CompetencyId).Count()"
                                               Max="@(competencies.Where(x => x.Grade == 5).Count())"
                                               Unit="@($" out of {competencies.Where(x => x.Grade == 5).Count()} complete")"
                                               ProgressBarStyle="ProgressBarStyle.Success"
                                               Style="width: 50%"
                                               class="mx-5" />
                        </RadzenStack>
                    </Template>
                    <ChildContent>
                        <RadzenAccordion Multiple="true">
                            <Items>
                                @for (int i = 0; i < groupedGrade5Competencies.Count(); ++i)
                                {
                                    var group = groupedGrade5Competencies.ElementAt(i);
                                    var key = group.Key;
                                    <RadzenAccordionItem Text="@($"Grade 5 {group.Key.GetDescription()} Competencies")" Icon="@(group.Key.GetAttribute<IconAttribute>().Name)" CollapseTitle="Collapse"
                                                         ExpandTitle="Expand" CollapseAriaLabel="@($"Collapse the Grade 5 {group.Key.GetDescription()} Competencies")"
                                                         ExpandAriaLabel="@($"Expand the Grade 5 {group.Key.GetDescription()} Competencies")" Selected="@grade5CategoriesSelected[key]">
                                        <Template>
                                            <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                                <h4 style="margin-bottom:0.2rem">@group.Key.GetDescription()</h4>
                                                <RadzenProgressBar Value="group.SelectMany(x => x.Assessments).Where(x => x.Status == AssessmentStatus.FullyMet && x.Person.PersonId == selectedPerson.PersonId).DistinctBy(x => x.AssociatedCompetency.CompetencyId).Count()"
                                                                   Max="@(group.Count())"
                                                                   Unit="@($" out of {group.Count()} complete")"
                                                                   ProgressBarStyle="ProgressBarStyle.Primary"
                                                                   Style="width: 50%"
                                                                   class="mx-5" />
                                            </RadzenStack>
                                        </Template>
                                        <ChildContent>
                                            <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                                                @foreach (var competency in group)
                                                {
                                                    <CompetencyCardComponent Competency="competency"
                                                                             EditAuthorised="userIsSuperuser"
                                                                             EditCompetencyAction="@(competency => EditCompetency(competency))"
                                                                             AddAssessmentAction="@(assessment => AddAssessment(assessment))"
                                                                             UpdateAssessmentAction="@(assessment => UpdateAssessment(assessment))"
                                                                             ShowTooltip="@((arg, message) => ShowTooltip(arg, message))"
                                                                             SelectedPerson="selectedPerson"
                                                                             ActiveUserId="activeUserId" />
                                                }
                                            </RadzenStack>
                                        </ChildContent>
                                    </RadzenAccordionItem>
                                }
                            </Items>
                        </RadzenAccordion>
                    </ChildContent>
                </RadzenAccordionItem>
            }
            <RadzenAccordionItem Text="Grade 6" Icon="counter_2" CollapseTitle="Collapse"
                                 ExpandTitle="Expand" CollapseAriaLabel="Collapse the Grade 6 Competencies"
                                 ExpandAriaLabel="Expand the Grade 6 Competencies" Selected="@gradeAccordionSelected[6]">
                <Template>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                        <h3 style="margin-bottom:0.2rem; color: #609">Advanced Level (Grade 6)</h3>
                        <RadzenProgressBar Value="competencies.Where(x => x.Grade == 6).SelectMany(x => x.Assessments).Where(x => x.Status == AssessmentStatus.FullyMet && x.Person.PersonId == selectedPerson.PersonId).DistinctBy(x => x.AssociatedCompetency.CompetencyId).Count()"
                                           Max="@(competencies.Where(x => x.Grade == 6).Count())"
                                           Unit="@($" out of {competencies.Where(x => x.Grade == 6).Count()} complete")"
                                           ProgressBarStyle="ProgressBarStyle.Success"
                                           Style="width: 50%"
                                           class="mx-5" />
                    </RadzenStack>
                </Template>
                <ChildContent>
                    <RadzenAccordion Multiple="true">
                        <Items>
                            @for (int i = 0; i < groupedGrade6Competencies.Count(); ++i)
                            {
                                var group = groupedGrade6Competencies.ElementAt(i);
                                var key = group.Key;
                                <RadzenAccordionItem Text="@($"Grade 6 {group.Key.GetDescription()} Competencies")" Icon="@(group.Key.GetAttribute<IconAttribute>().Name)" CollapseTitle="Collapse"
                                                     ExpandTitle="Expand" CollapseAriaLabel="@($"Collapse the Grade 6 {group.Key.GetDescription()} Competencies")"
                                                     ExpandAriaLabel="@($"Expand the Grade 6 {group.Key.GetDescription()} Competencies")" Selected="@grade6CategoriesSelected[key]">
                                    <Template>
                                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                            <h4 style="margin-bottom:0.2rem">@group.Key.GetDescription()</h4>
                                            <RadzenProgressBar Value="group.SelectMany(x => x.Assessments).Where(x => x.Status == AssessmentStatus.FullyMet && x.Person.PersonId == selectedPerson.PersonId).DistinctBy(x => x.AssociatedCompetency.CompetencyId).Count()"
                                                               Max="@(group.Count())"
                                                               Unit="@($" out of {group.Count()} complete")"
                                                               ProgressBarStyle="ProgressBarStyle.Primary"
                                                               Style="width: 50%"
                                                               class="mx-5" />
                                        </RadzenStack>
                                    </Template>
                                    <ChildContent>
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                                            @foreach (var competency in group)
                                            {
                                                <CompetencyCardComponent Competency="competency"
                                                                         EditAuthorised="userIsSuperuser"
                                                                         EditCompetencyAction="@(competency => EditCompetency(competency))"
                                                                         AddAssessmentAction="@(assessment => AddAssessment(assessment))"
                                                                         UpdateAssessmentAction="@(assessment => UpdateAssessment(assessment))"
                                                                         ShowTooltip="@((arg, message) => ShowTooltip(arg, message))"
                                                                         SelectedPerson="selectedPerson"
                                                                         ActiveUserId="activeUserId" />
                                            }
                                        </RadzenStack>
                                    </ChildContent>
                                </RadzenAccordionItem>
                            }
                        </Items>
                    </RadzenAccordion>
                </ChildContent>
            </RadzenAccordionItem>
            <RadzenAccordionItem Text="Grade 7" Icon="counter_3" CollapseTitle="Collapse"
                                 ExpandTitle="Expand" CollapseAriaLabel="Collapse the Grade 7 Competencies"
                                 ExpandAriaLabel="Expand the Grade 7" Selected="@gradeAccordionSelected[7]">
                <Template>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                        <h3 style="margin-bottom:0.2rem; color: #609">Leadership Level (Grade 7)</h3>
                        <RadzenProgressBar Value="competencies.Where(x => x.Grade == 7).SelectMany(x => x.Assessments).Where(x => x.Status == AssessmentStatus.FullyMet && x.Person.PersonId == selectedPerson.PersonId).DistinctBy(x => x.AssociatedCompetency.CompetencyId).Count()"
                                           Max="@(competencies.Where(x => x.Grade == 7).Count())"
                                           Unit="@($" out of {competencies.Where(x => x.Grade == 7).Count()} complete")"
                                           ProgressBarStyle="ProgressBarStyle.Success"
                                           Style="width: 50%"
                                           class="mx-5" />
                    </RadzenStack>
                </Template>
                <ChildContent>
                    <RadzenAccordion Multiple="true">
                        <Items>
                            @for (int i = 0; i < groupedGrade7Competencies.Count(); ++i)
                            {
                                var group = groupedGrade7Competencies.ElementAt(i);
                                var key = group.Key;
                                <RadzenAccordionItem Text="@($"Grade 7 {group.Key.GetDescription()} Competencies")" Icon="@(group.Key.GetAttribute<IconAttribute>().Name)" CollapseTitle="Collapse"
                                                     ExpandTitle="Expand" CollapseAriaLabel="@($"Collapse the Grade 7 {group.Key.GetDescription()} Competencies")"
                                                     ExpandAriaLabel="@($"Expand the Grade 7 {group.Key.GetDescription()} Competencies")" Selected="@grade7CategoriesSelected[key]">
                                    <Template>
                                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                            <h4 style="margin-bottom:0.2rem">@group.Key.GetDescription()</h4>
                                            <RadzenProgressBar Value="group.SelectMany(x => x.Assessments).Where(x => x.Status == AssessmentStatus.FullyMet && x.Person.PersonId == selectedPerson.PersonId).DistinctBy(x => x.AssociatedCompetency.CompetencyId).Count()"
                                                               Max="@(group.Count())"
                                                               Unit="@($" out of {group.Count()} complete")"
                                                               ProgressBarStyle="ProgressBarStyle.Primary"
                                                               Style="width: 50%"
                                                               class="mx-5" />
                                        </RadzenStack>
                                    </Template>
                                    <ChildContent>
                                        <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                                            @foreach (var competency in group)
                                            {
                                                <CompetencyCardComponent Competency="competency"
                                                                         EditAuthorised="userIsSuperuser"
                                                                         EditCompetencyAction="@(competency => EditCompetency(competency))"
                                                                         AddAssessmentAction="@(assessment => AddAssessment(assessment))"
                                                                         UpdateAssessmentAction="@(assessment => UpdateAssessment(assessment))"
                                                                         ShowTooltip="@((arg, message) => ShowTooltip(arg, message))"
                                                                         SelectedPerson="selectedPerson"
                                                                         ActiveUserId="activeUserId" />
                                            }
                                        </RadzenStack>
                                    </ChildContent>
                                </RadzenAccordionItem>
                            }
                        </Items>
                    </RadzenAccordion>
                </ChildContent>
            </RadzenAccordionItem>
        </Items>
    </RadzenAccordion>
    <br />
</div>