@page "/competencies"
@using DotNetExtensions
@using PPMTool.Data
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using PPMTool.Enums
@inherits BasePage
<PageTitle>Development Journey - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col">
            <h2>Development Journey Summary</h2>
        </div>
        <div class="col-auto">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem" AlignItems="AlignItems.Center">
                <RadzenText Text="Show All Staff:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: -0.2rem" />
                <RadzenSwitch @bind-Value="@showAllStaff" Disabled="@Loading" Change="@(() => EnqueueLoadData(GetTask))" />
            </RadzenStack>
        </div>
        <div class="col-auto">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.1rem" AlignItems="AlignItems.Center">
                <RadzenText Text="Load Only Unmet Competencies:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: -0.2rem" />
                <RadzenSwitch @bind-Value="@showUnMetOnly" Disabled="@Loading" Change="@(() => EnqueueLoadData(GetTask))" />
            </RadzenStack>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <RadzenText Text="Your development journey and competency framework assessments are only visible to you, your line manager and system super-users. It is designed as a tool for personal reflection and a mechanism to monitor your own development journey as an RSE. You may wish to share this with your line manager to assist with the setting of Role-Based Objectives as part of your Personal Development Review (PDR)." TextStyle="TextStyle.Body2" />
        </div>
    </div>
    <hr />
    <RadzenCard>
        <RadzenStack Orientation="Radzen.Orientation.Vertical">
            <RadzenStack class="radzen-shaded" Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start" Wrap="FlexWrap.Wrap">
                <RadzenText Text="Show Journey For:" TextStyle="TextStyle.Subtitle1" Style="margin-bottom: 0rem"/>
                <RadzenButton Icon="@(exportRunning ? "hourglass_empty" : "download")"
                              Click="@ExportData"
                              Disabled="@(Loading || exportRunning)" />
            </RadzenStack>
            <RadzenDropDown @bind-Value="@selectedPerson" TValue="Person" TextProperty="Name" Change="PersonSelected" Data="@availablePeople" Style="width:100%" Disabled="!EditAuthorised" />
            
            @if (Loading)
            {
                <LoadingComponent />
            }
            else
            {
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceEvenly" Wrap="FlexWrap.Wrap">
                    @foreach (var comp in competencyGroups)
                    {
                        <PathwayGaugeComponent AssessmentsForGradeAndPerson="@comp.CompetencyAssessments"
                                               TotalNumberOfCompetenciesInGrade="@comp.Total"
                                               Title="@comp.Description" />
                    }
                </RadzenStack>
            }
        </RadzenStack>
    </RadzenCard>
    <br />
    <div class="row">
        <div class="col">
            <h2>Competencies Framework Assessment</h2>
        </div>
        <div class="col-auto">
            <RadzenButton Icon="add" Text="Add Competency" Click="AddCompetency" Disabled="!userIsSuperuser" />
        </div>
    </div>
    <div class="row">
        <div class="col">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" Style="margin-top: -0.3rem; width: 100%">
                <RadzenIcon Icon="search" IconStyle="IconStyle.Dark" />
                <RadzenTextBox @bind-Value=@competencySearchTerms
                               Placeholder="Search Competencies"
                               Change=@FilterCompetencies
                               Disabled="@Loading" />
                <RadzenButton Icon="clear"
                              ButtonStyle="ButtonStyle.Light"
                              Click="@ClearSearch"
                              MouseEnter="@(args => ShowTooltip(args, "Clear"))"
                              Disabled="@Loading" />
            </RadzenStack>
        </div>
    </div>
    <hr />
    @if (Loading)
    {
        <LoadingComponent />
    }
    else
    {
        <RadzenAccordion Multiple="true">
            <Items>
                @foreach (var comp in competencyGroups)
                {
                    <RadzenAccordionItem Text="@($"Grade {comp.Grade}")"
                                         Icon="@comp.Icon"
                                         CollapseTitle="Collapse"
                                         ExpandTitle="Expand"
                                         CollapseAriaLabel="@($"Collapse the Grade {comp.Grade} Competencies")"
                                         ExpandAriaLabel="@($"Expand the Grade {comp.Grade} Competencies")"
                                         Selected="@comp.Selected"
                                         @onclick="@(() => comp.ToggleAccordion())">
                        <Template>
                            <RadzenStack Orientation="Radzen.Orientation.Horizontal"
                                         JustifyContent="JustifyContent.SpaceBetween"
                                         AlignItems="AlignItems.Center"
                                         Style="width:100%">
                                <h3 style="margin-bottom:0.2rem; color: #609">@comp.Description</h3>
                                <RadzenProgressBar Value="@comp.Met"
                                                   Max="@comp.Total"
                                                   Unit="@($" out of {comp.Total} complete")"
                                                   ProgressBarStyle="ProgressBarStyle.Success"
                                                   Style="width: 50%"
                                                   class="mx-5" />
                            </RadzenStack>
                        </Template>
                        <ChildContent>
                            <RadzenAccordion Multiple="true">
                                <Items>
                                    @foreach (var group in comp.CompetenciesGroupedByCategory)
                                    {
                                        var key = group.Key;
                                        <RadzenAccordionItem Text="@($"Grade {comp.Grade} {group.Key.GetDescription()} Competencies")"
                                                             Icon="@(group.Key.GetAttribute<IconAttribute>().Name)"
                                                             CollapseTitle="Collapse"
                                                             ExpandTitle="Expand"
                                                             CollapseAriaLabel="@($"Collapse the Grade 5 {group.Key.GetDescription()} Competencies")"
                                                             ExpandAriaLabel="@($"Expand the Grade 5 {group.Key.GetDescription()} Competencies")"
                                                             Selected="@(comp.CompetencySelectionState[key])"
                                                             @onclick="@(() => comp.ToggleAccordion(key))"
                                                             Style="background-color: var(--rz-base-50);">
                                            <Template>
                                                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center" Style="width:100%">
                                                    <h4 style="margin-bottom:0.2rem; width:50%">@($"{group.FirstOrDefault()?.GetCategoryId()} {group.Key.GetDescription()}")</h4>
                                                    <RadzenProgressBar Value="@(comp.CompetencyMetValues[key])"
                                                                       Max="@(group.Count())"
                                                                       Unit="@($" out of {group.Count()} complete")"
                                                                       ProgressBarStyle="ProgressBarStyle.Primary"
                                                                       Style="width: 50%"
                                                                       class="mx-5" />
                                                </RadzenStack>
                                            </Template>
                                            <ChildContent>
                                                <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                                                    @foreach (var competency in group)
                                                    {
                                                        <CompetencyCardComponent Competency="competency"
                                                                                 EditAuthorised="userIsSuperuser"
                                                                                 EditCompetencyAction="@(competency => EditCompetency(competency))"
                                                                                 AddAssessmentAction="@(assessment => AddAssessment(assessment))"
                                                                                 UpdateAssessmentAction="@(assessment => UpdateAssessment(assessment))"
                                                                                 ShowTooltip="@((arg, message) => ShowTooltip(arg, message))"
                                                                                 SelectedPerson="selectedPerson"
                                                                                 ActiveUserId="activeUserId" />
                                                    }
                                                </RadzenStack>
                                            </ChildContent>
                                        </RadzenAccordionItem>
                                    }
                                </Items>
                            </RadzenAccordion>
                        </ChildContent>
                    </RadzenAccordionItem>
                }
            </Items>
        </RadzenAccordion>
    }
    <br />
</div>