@page "/projectdetails/{ProjectId:int}"
@page "/projectdetails"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Data;
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            @if (project == null)
            {
                <h1>Unkown Project</h1>
            }
            else
            {
                <h1>@project.GetFullName()</h1>
            }
        </div>
        <div class="col-auto">
            <RadzenButton Click=@EditProject Text="Edit" Icon="edit" Disabled=!EditAuthorised />
        </div>
        <div class="col-auto">
            <RTPButtonComponent Page=@this Project=project Disabled=!EditAuthorised />
        </div>
    </div>
    <hr />
    @if (project != null)
    {
        <MessageSummaryComponent Messages="project.GetLatestStatusMessages()" />
        <hr />
    }
    <div class="card">
        @if (project == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>PI</th>
                            <th>School (Faculty)</th>
                            <th>PM</th>
                            <th>Day Rate</th>
                            <th>Budget</th>
                            <th>Planned Cost</th>
                            <th>Actual Cost</th>
                            <th>Funds Received</th>
                            <th>Actual Hours</th>
                            <th>Project Status</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@project.PI</td>
                            <td>@($"{project.School.ToNiceString()} ({project.Faculty.ToNiceString()})")</td>
                            <td>@(project.ProjectManager?.Name ?? "Not Set")</td>
                            <td>@project.DayRate.ToString("C0")</td>
                            <td>@project.Budget.ToString("C0")</td>
                            <td><span style="color:@plannedCostColour">@project.PlannedCost.ToString("C0")</span></td>
                            <td><span style="color:@actualCostColour">@project.ActualCost.ToString("C0")</span></td>
                            <td><span style="color:@fundsReceivedColour">@project.FundsReceived.ToString("C0")</span></td>
                            <td>@project.SubTasks.RoundedSum(x => x.ActualWorkHours)</td>
                            <td>@project.ProjectStatus.ToNiceString()</td>
                            <td>@project.StartDate.ToShortDateString()</td>
                            <td>@project.EndDate.ToShortDateString()</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
    <hr />

    <div class="row">
        @* Graphs *@
        <div class="col">
            <h2>Burn-Up Chart</h2>
            <RadzenCard>
                <ApexChart TItem="ChartItem"
                            XAxisType="XAxisType.Datetime"
                            Options="burnUpChartOptions">

                    <ApexPointSeries TItem="ChartItem"
                                        Items="burnUpChartSource"
                                        SeriesType="@SeriesType.Area"
                                        Name="Planned Work"
                                        XValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                        YValue="@(e => Convert.ToDecimal(e.Value1))" />

                    <ApexPointSeries TItem="ChartItem"
                                        Items="burnUpChartSource"
                                        SeriesType="@SeriesType.Area"
                                        Name="Planned Work (Adjusted for Unmet Demand)"
                                        XValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                        YValue="@(e => Convert.ToDecimal(e.Value2))" />

                </ApexChart>
            </RadzenCard>
        </div>

        <div class="col">
            <h2>Schedule</h2>
            <RadzenCard>
                <ApexChart TItem="SubTask"
                            XAxisType="XAxisType.Datetime"
                            Options=ganttChartOptions
                            OnDataPointSelection="TaskSelected">
                    <ChildContent>
                        <ApexRangeSeries TItem="SubTask"
                                            Items="confirmedTasks"
                                            Name="Resources Confirmed"
                                            XValue="@(e => e.Name)"
                                            YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                            YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                                            PointColor="@(e => ChartItem.GetColourStringPercentage(100 + (int)e.GetPercentageUnmetDemand()))" />

                        <ApexRangeSeries TItem="SubTask"
                                            Items="provisionalTasks"
                                            Name="Resources Provisional"
                                            XValue="@(e => e.Name)"
                                            YMinValue="@(e => e.StartDate.ToUnixTimeMilliseconds())"
                                            YMaxValue="@(e => e.EndDate.ToUnixTimeMilliseconds())"
                                            PointColor="@(e => ChartItem.GetColourStringPercentage(100 + (int)e.GetPercentageUnmetDemand()))" />
                    </ChildContent>
                    <ApexPointTooltip>
                        <div class="m-2">
                            @{
                                var point = (ListPoint<SubTask>)context.DataPoint;
                                <div class="m-0 p-3">
                                    @if (point.Items.FirstOrDefault()?.HasProvisionalResources() ?? false)
                                    {
                                        <h3 class="me-1 text-warning"> &#x26A0; [PROVISIONAL ASSIGNMENT]</h3>
                                    }
                                    @if (point.Items.FirstOrDefault()?.HasUnmetDemand() ?? false)
                                    {
                                        <h3 class="me-1 text-danger"> &#x26A0; [UNDER RESOURCED (@point.Items.FirstOrDefault().UnmetDemand FTE)]</h3>
                                    }
                                    <h3>@string.Join(" | ", point.Items.FirstOrDefault()?.AssignedResources.Select(x => $"{x.Person.Name} [{x.AssignmentFTE}]"))</h3>
                                    <span class="me-1">@DateTimeOffset.FromUnixTimeMilliseconds(Convert.ToInt64(point.Y?.Min())).ToString("dd MMM yyy") - </span>
                                    <span class="me-1">@DateTimeOffset.FromUnixTimeMilliseconds(Convert.ToInt64(point.Y?.Max())).ToString("dd MMM yyy")</span>
                                </div>
                            }
                        </div>
                    </ApexPointTooltip>

                </ApexChart>
            </RadzenCard>
            <RadzenCard class="rz-p-2">
                <RadzenStack class="rz-m-0 rz-p-0" Orientation="Radzen.Orientation.Horizontal" Gap="0" Wrap="FlexWrap.Wrap" JustifyContent="JustifyContent.SpaceBetween">
                    <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(100)" /></svg> Demand Met</div>
                    <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(124)" /></svg> &lt;25% Unmet</div>
                    <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(149)" /></svg> &lt;50% Unmet</div>
                    <div class="col-auto"><svg width=20 height=20 xmlns="http://www.w3.org/2000/svg"> <circle r="10" cx="10" cy="10" fill="@ChartItem.GetColourStringPercentage(150)" /></svg> &gt;50% Unmet</div>
                </RadzenStack>
            </RadzenCard>
        </div>
    </div>
    <hr />

    <div class="row">
        <div class="col">
            <h2>Tasks</h2>
        </div>
        <div class="col-auto">
            <RadzenButton Click=@AddTask Text="Add" Icon="add" Disabled=!EditAuthorised />
        </div>
    </div>

    @if (project?.SubTasks == null)
    {
        <div class="card">
            <p class="lead">No data to show</p>
        </div>
    }
    else
    {
        <div class="card">
            <RadzenDataGrid AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.Simple"
                            AllowSorting="true"
                            PageSize="10"
                            AllowPaging="true"
                            PagerHorizontalAlign="HorizontalAlign.Left"
                            ShowPagingSummary="true"
                            Data="@allTasks"
                            TItem="SubTask"
                            ColumnWidth="100px"
                            SelectionMode="DataGridSelectionMode.Single"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            Count="@count"
                            LoadData="@LoadData">
                <Columns>
                    <RadzenDataGridColumn TItem="SubTask" Title="Status" Frozen="true" Sortable=false Filterable=false Width="120px" MinWidth="10px">
                        <Template Context="t">
                            <MessageSummaryComponent Messages="t.GetLatestStatusMessages()" ShowMessages="false" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubTask" Property="Name" Title="Name" Frozen="true" Width="150px" MinWidth="10px">
                        <Template Context="t">
                            <RadzenText Text=@t.Name />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubTask" Property="UnmetDemand" Title="Unmet Demand" FormatString="{0:F1}" MinWidth="10px">
                        <Template Context="t">
                            @if (t.HasUnmetDemand())
                            {
                                <RadzenText Style="color: var(--rz-danger)" Text=@t.UnmetDemand.ToString() />
                            }
                            else
                            {
                                @t.UnmetDemand.ToString()
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubTask" Property="DurationDays" Title="Duration (days)" FormatString="{0:F0}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Property="PlannedWorkHours" Title="Work (hrs)" FormatString="{0:F1}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Property="ActualWorkHours" Title="Actual Work (hrs)" FormatString="{0:F1}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Property="PlannedCost" Title="Budget" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Property="ActualCost" Title="Actual Cost" FormatString="{0:C0}" Filterable="false" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Property="StartDate" Title="Start Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Property="EndDate" Title="End Date" FormatString="{0:d}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Property="TaskType" Title="Type" MinWidth="10px">
                        <Template Context="t">
                            @t.TaskType.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubTask" Property="Demand" Title="Demand" FormatString="{0:F3}" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Property="Resources" Title="Resources" Sortable="false" MinWidth="10px">
                        <Template Context="t">
                            @string.Join(',', t.AssignedResources?.Select(x => $"{x.Person.ShortName}[{x.AssignmentFTE}]"))
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubTask" Property="Predecessor.Name" Title="Predecessor" MinWidth="10px" />
                    <RadzenDataGridColumn TItem="SubTask" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="60px" FrozenPosition="FrozenColumnPosition.Right" Title="Edit">
                        <Template Context="task">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => EditTask(task))" @onclick:stopPropagation="true" Disabled=!EditAuthorised>
                            </RadzenButton>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    }
    <hr />

    @* Notes *@
    <div class="row">
        <div class="col-auto">
            <h2>Notes</h2>
        </div>
        <div class="col">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" Style="margin-top: -0.3rem">
                <RadzenIcon Icon="search" IconStyle="IconStyle.Dark" />
                <RadzenTextBox @bind-Value=@noteSearchTerms
                                Placeholder="Search Notes"
                                Change=@FilterNotes
                                Style="width:100%" />
                <RadzenButton Icon="clear" ButtonStyle="ButtonStyle.Light" Click="@ClearSearch" />
            </RadzenStack>
        </div>
        <div class="col-auto">
            <RadzenButton Icon="check" Text="Save" ButtonStyle="ButtonStyle.Primary" Click="@(editNote ? UpdateNote : SaveNote)" Visible="@addNote" />
        </div>
        <div class="col-auto">
            <RadzenButton Icon="@(addNote ? "clear" : "add")" Text="@(addNote ? "Discard" : "Add")" ButtonStyle="@(addNote ? ButtonStyle.Danger : ButtonStyle.Primary)" Disabled=!EditAuthorised Click="@(args => SetShowNoteEditor(!addNote))" />
        </div>
    </div>
    <div id="note-editor">
        <RadzenHtmlEditor @bind-Value=@noteModel.HtmlContent style="height:10rem; margin-bottom:1rem" Visible=@addNote />
    </div>
    <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem" Style="max-height: 40rem; overflow-y: auto; overflow-x: clip;">
        @if (filteredNotes.Count == 0)
        {
            <RadzenText Text="There are no notes to show for this project" />
        }
        else
        {
            @foreach (var note in filteredNotes)
            {
                <NoteComponent Note="note" DeleteNote="DeleteNote" EditNote="EditNote" />
            }
        }
    </RadzenStack>
    <hr/>
</div>