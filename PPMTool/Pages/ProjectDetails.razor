@page "/projectdetails/{ProjectId:int}"
@using PPMTool.Enums
@using PPMTool.Data.Entities

<div class="container" style="max-width: none; width: 80%">

    @if (project == null)
    {
        <h1>Unkown Project</h1>
    }
    else
    {
        <h1>@project.Name</h1>
    }
    <div class="card">
        @if (project == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>PI</th>
                            <th>Portfolio</th>
                            <th>Budget</th>
                            <th>Actual Cost</th>
                            <th>Funds Received</th>
                            <th>Funding Status</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@project.PI</td>
                            <td>@project.Portfolio.ToNiceString()</td>
                            <td>@project.Budget.ToString("C0")</td>
                            <td>@project.ActualCost.ToString("C0")</td>
                            <td>@project.FundsReceived.ToString("C0")</td>
                            <td>@project.FundingStatus.ToNiceString()</td>
                            <td>@project.StartDate.ToShortDateString()</td>
                            <td>@project.EndDate.ToShortDateString()</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
    <br />
    <div class="row">
        <div class="col-auto mr-auto">
            <h2>Tasks</h2>
        </div>
        <div class="col-auto">
            <a class="btn btn-primary" href="/addtask/@ProjectID"><i class="oi oi-plus" /></a>
        </div>
    </div>
    <div class="card">
        @if (project?.SubTasks == null)
        {
            <p class="lead">No data to show</p>
        }
        else
        {
            <RadzenDataGrid AllowFiltering="true"
                            AllowColumnResize="true"
                            FilterMode="FilterMode.Advanced"
                            AllowSorting="true"
                            PageSize="10"
                            AllowPaging="true"
                            PagerHorizontalAlign="HorizontalAlign.Left"
                            ShowPagingSummary="true"
                            Data="@project.SubTasks"
                            TItem="SubTask"
                            ColumnWidth="100px"
                            SelectionMode="DataGridSelectionMode.Single"
                            LogicalFilterOperator="LogicalFilterOperator.Or">
                <Columns>
                    <RadzenDataGridColumn TItem="SubTask" Property="IsDone" Title="Done" />
                    <RadzenDataGridColumn TItem="SubTask" Property="Name" Title="Name" Frozen="true" />
                    <RadzenDataGridColumn TItem="SubTask" Property="HasFixedStart" Title="Fixed Start" />
                    <RadzenDataGridColumn TItem="SubTask" Property="DurationHours" Title="Duration (hrs)" FormatString="{0:F1}" />
                    <RadzenDataGridColumn TItem="SubTask" Property="PlannedWorkHours" Title="Work (hrs)" FormatString="{0:F1}" />
                    <RadzenDataGridColumn TItem="SubTask" Property="ActualWorkHours" Title="Actual Work (hrs)" FormatString="{0:F1}" />
                    <RadzenDataGridColumn TItem="SubTask" Property="PlannedCost" Title="Budget" FormatString="{0:C0}" />
                    <RadzenDataGridColumn TItem="SubTask" Property="ActualCost" Title="Actual Cost" FormatString="{0:C0}" />
                    <RadzenDataGridColumn TItem="SubTask" Property="StartDate" Title="Start Date" FormatString="{0:d}" />
                    <RadzenDataGridColumn TItem="SubTask" Property="EndDate" Title="End Date" FormatString="{0:d}" />
                    <RadzenDataGridColumn TItem="SubTask" Property="TaskType" Title="Type">
                        <Template Context="t">
                            @t.TaskType.ToNiceString()
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubTask" Property="Resources" Title="Resources">
                        <Template Context="t">
                            @string.Join(',', t.AssignedResources?.Select(x => $"{x.Person.ShortName}[{(int)x.Percentage}%]"))
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SubTask" Property="Predecessor.Name" Title="Predecessor" />
                </Columns>
            </RadzenDataGrid>
            <div class="card">
                <ApexChart TItem="SubTask"
                           Title="Schedule"
                           XAxisType="XAxisType.Datetime"
                           Options=options>

                    <ApexRangeSeries TItem="SubTask"
                                     Items="Data"
                                     XValue="@(e => e.Name)"
                                     YMinValue="@(e =>e.StartDate.ToUnixTimeMilliseconds())"
                                     YMaxValue="@(e =>e.EndDate.ToUnixTimeMilliseconds())" />

                </ApexChart>
            </div>
        }
    </div>
</div>