@page "/projects/estimatecost"
@inherits BasePage
@using PPMTool.Data
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using System.Diagnostics
@using System.ComponentModel.DataAnnotations
@using static PPMTool.Data.Entities.Project
<PageTitle>Estimate Cost - CapX</PageTitle>


<div class="container">
    <div class="row">
        <div class="col-auto">
            <h1>Estimate Project Cost</h1>
        </div>
    </div>
    <div class="row">
        <div class="col">
            <p>Tool for estimating the cost of a project based on the established costing approach.</p>
        </div>
    </div>
    <hr />
    @if (Loading)
    {
        <LoadingComponent />
    }
    else
    {
        <div class="card">
            <h2>Project Details</h2>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label"
                                 Text="Cost Model"
                                 Component="CostModel" /><br />
                    <RadzenDropDown class="radzen-dropdown"
                                    @bind-Value="costModel"
                                    Data="@(Enum.GetValues(typeof(CostModel)))"
                                    Name="CostModel">
                        <Template Context="cost">
                            @($"{((CostModel)cost).GetAttribute<DisplayAttribute>().Name} : {((CostModel)cost).GetDescription()}")
                        </Template>
                    </RadzenDropDown>
                </div>
            </div>
            <HintComponent Message="This section represents the summary for the project. The values are read-only as they are driven by the individual resource details below." />
            <TaskConfigurationComponent ReadOnly="true"
                                        ShowRates="@(costModel == CostModel.DayRate)" />
            <hr />
            <h2>Resources</h2>
            <HintComponent Message="If your chosen cost model includes leadership then a leadership resource is displayed. Currently this tool only supports two different types of technical resource based on the two approved rates for costing. If you have multiple RSEs at the same rate, consider combining them into one aggregated resource." />
            @if (costModel == CostModel.TechAndLeadership)
            {
                <h3>Leadership</h3>
                <TaskConfigurationComponent CostModel="@costModel" />
                <hr />
            }
            <h3>Tech Effort 1</h3>
            <TaskConfigurationComponent CostModel="@costModel" />
            <hr />
            <h3>Tech Effort 2</h3>
            <TaskConfigurationComponent CostModel="@costModel" />
        </div>
    }
</div>
