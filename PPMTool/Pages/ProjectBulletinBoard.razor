@page "/projectbulletinboard"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Pages.Components
@using static PPMTool.Data.Enums.Extensions
<PageTitle>Our Projects - CapX</PageTitle>

<div class="container">
    <RadzenStack Orientation="Radzen.Orientation.Vertical">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <h1>Our Projects</h1>
            @if (projectsToShow != null)
            {
                <RadzenText TextStyle="TextStyle.Subtitle1" Text="@($"({projectsToShow.Count()} project(s) listed)")" Style="margin-bottom: -0.2rem" />
            }
        </RadzenStack>
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
            <RadzenLabel Text="Date Range" Component="StartDate" class="rz-ms-2" />
            <RadzenDatePicker @bind-Value="startDate" ShowTime="false" DateFormat="dd/MM/yyyy" Name="StartDate" AllowClear="true" Change="FilterProjects" Disabled="@Loading" />
            <RadzenLabel Text="to" Component="EndDate" class="rz-ms-2" />
            <RadzenDatePicker @bind-Value="endDate" ShowTime="false" DateFormat="dd/MM/yyyy" Name="EndDate" AllowClear="true" Change="FilterProjects" Disabled="@Loading" />
            <RadzenLabel Text="Group By Status" Component="CheckBox1" class="rz-ms-2" />
            <RadzenCheckBox TValue="bool" Value=@groupByStatus Change=@(args => { groupByStatus = args; FilterProjects(); }) Name="CheckBox1" Disabled="@Loading" />
        </RadzenStack>
    </RadzenStack>
    <hr />
    @if (Loading || projectsToShow == null)
    {
        <LoadingComponent />            
    }
    else if (projectsToShow.Count() == 0)
    {
        <RadzenText Text="There are no projects requiring RSE resource matching the chosen date range." />
    }
    else
    {
        @if (groupByStatus)
        {
            foreach (var group in projectsToShowGrouped)
            {
                <h3>@(group.Key.ToNiceString())</h3>
                <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                    @foreach (var project in group)
                    {
                        <ProjectBulletinCardComponent Project="@project.Project"
                                                      ShowDetailsButton="EditAuthorised"
                                                      FilterStartDate="@startDate"
                                                      FilterEndDate="@endDate"
                                                      SkillsList="@project.Skills" />
                    }
                </RadzenStack>
                <hr />
            }
        }
        else
        {
            <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.5rem">
                @foreach (var project in projectsToShow)
                {
                    <ProjectBulletinCardComponent Project="@project.Project"
                                                  ShowDetailsButton="EditAuthorised"
                                                  FilterStartDate="@startDate"
                                                  FilterEndDate="@endDate"
                                                  SkillsList="@project.Skills" />
                }
            </RadzenStack>
            <hr />
        }
    }
</div>