@page "/myprojects"
@page "/"
@inherits PPMTool.Pages.BaseProjectPage
@using PPMTool.Data.Enums
@using PPMTool.Pages.Components
<PageTitle>My Projects - CapX</PageTitle>

<FeatureCheckComponent Feature="FeatureType.ProjectsAndCapacity">

    <div class="container">
        <div class="row">
            <div class="col">
                <h1>My Projects</h1>
            </div>
            <div class="col-auto">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                    @if (ActiveUserRoleType == RoleType.Superuser)
                    {
                        <RadzenLabel Text="Show Request Summary" Style="margin-bottom: 0.1rem" Component="ShowRequestSummary" />
                        <RadzenSwitch Name="ShowRequestSummary" @bind-Value="@ShowRequestSummary" />
                    }
                    <RadzenLabel Text="Include Finished" Style="margin-bottom: 0.1rem" Component="IncludeFinished" />
                    <RadzenSwitch Name="IncludeFinished" @bind-Value="@IncludeFinished" />
                </RadzenStack>
            </div>
        </div>
        <div class="row">
            <div class="col py-2">
                <RadzenText Text="The status of all the projects you manage." />
            </div>
        </div>
        <hr />
        @if (Loading)
        {
            <LoadingComponent />            
        }
        else if (ownedProjectsAndDueNotes == null || ownedProjectsAndDueNotes.Count() == 0)
        {
            <RadzenText Text="You don't have any projects to manage!" />
        }
        else
        {
            if (showRequestSummary)
            {
                <RadzenCard>
                    <h2>Request Summary</h2>
                    <RadzenChart Animate="true"
                                 Style="height: 18rem">
                        <RadzenStackedBarSeries FillMode="FillMode.Solid"
                                                Data="@summaries"
                                                CategoryProperty="RequestOwner"
                                                Title="Breached"
                                                ValueProperty="RedCount"
                                                Fill="var(--rz-danger)">
                            <RadzenSeriesDataLabels Appearance="DataLabelAppearance.Outline"
                                                    Formatter="@FormatSummaryDataLabels" />
                        </RadzenStackedBarSeries>
                        <RadzenStackedBarSeries FillMode="FillMode.Solid"
                                                Data="@summaries"
                                                CategoryProperty="RequestOwner"
                                                Title="Approaching"
                                                ValueProperty="AmberCount"
                                                Fill="var(--rz-warning)">
                            <RadzenSeriesDataLabels Appearance="DataLabelAppearance.Outline"
                                                    Formatter="@FormatSummaryDataLabels" />
                        </RadzenStackedBarSeries>
                        <RadzenStackedBarSeries FillMode="FillMode.Solid"
                                                Data="@summaries"
                                                CategoryProperty="RequestOwner"
                                                Title="On Track"
                                                ValueProperty="GreenCount"
                                                Fill="var(--rz-success)">
                            <RadzenSeriesDataLabels Appearance="DataLabelAppearance.Outline"
                                                    Formatter="@FormatSummaryDataLabels" />
                        </RadzenStackedBarSeries>
                        <RadzenValueAxis Min="0">
                            <RadzenGridLines Visible="true" />
                            <RadzenAxisTitle Text="Request Count" />
                        </RadzenValueAxis>
                        <RadzenBarOptions Radius="5" />
                    </RadzenChart>
                </RadzenCard>
                <hr />
            }

            <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.3rem">
                @foreach (var projectAndNotes in ownedProjectsAndDueNotes.OrderBy(x => x.Key.ProjectStatus))
                {
                    <MyProjectSummaryComponent Project="projectAndNotes.Key"
                                               EditAuthorised="EditAuthorised"
                                               DetailsButtonClicked="DetailsButtonClicked"
                                               OverDueNoteCount="@(projectAndNotes.Value.Where(x => x.IsOverDue()).Count())"
                                               DueNoteCount="@(projectAndNotes.Value.Where(x => x.IsDue()).Count())"
                                               NextDueDate="@(projectAndNotes.Value.Where(x => x.DueDate != null && !x.IsCompleted()).OrderBy(x => x.DueDate).FirstOrDefault()?.DueDate)"
                                               DueButtonClicked="DueButtonClicked"
                                               ShowTooltip="@((elem, text) => ShowTooltip(elem, text))"
                                               ViewerPersonId="@personIdToMatch" />
                }
            </RadzenStack>
        }
    </div>
    <br/>

</FeatureCheckComponent>
