@page "/people/addskills/{PersonId:int}"
@inherits DataGridPage<SkillTag>
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
<PageTitle>Add Skills - CapX</PageTitle>

<div class="container">
    @if (personModel != null)
    {
        <h1>Edit Skills</h1>
        <RadzenText Text="@personModel?.Name" TextStyle="TextStyle.DisplayH5" />
        <hr />
        <div class="card">
            <EditForm Model="@personModel" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <div class="col mb-2 align-items-center float-right">
                        <RadzenButton Text="Add" Icon="add" Click="@InsertRow" Disabled=@(entityToInsert != null || entityToUpdate != null || !IsSuperuserOrLineManagerOrPerson(personModel)) />
                    </div>
                </div>
                <RadzenDataGrid @ref="dataGrid"
                                AllowFiltering="@(dataGridEntities != null && dataGridEntities.Count > 0)"
                                AllowPaging="true"
                                PageSize="15"
                                AllowSorting="true"
                                ShowPagingSummary="true"
                                EditMode="DataGridEditMode.Single"
                                FilterMode="FilterMode.Simple"
                                Data="@dataGridEntities"
                                TItem="SkillTag"
                                RowUpdate="@OnUpdateRow"
                                RowCreate="@OnCreateRow"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
                    <Columns>
                        <RadzenDataGridColumn Filterable="false" Property="Name" Title="Skill" MinWidth="10px">
                        </RadzenDataGridColumn>

                        <RadzenDataGridColumn Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="8rem" MinWidth="10px" Title="Actions">
                            <Template Context="c">
                                <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(c))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" Disabled="@(!IsSuperuserOrLineManagerOrPerson(personModel))" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(c))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" Disabled="@(!IsSuperuserOrLineManagerOrPerson(personModel))" />
                            </Template>
                            <EditTemplate Context="c">
                                <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(c))" MouseEnter="@(args => ShowTooltip(args, "Save"))"/>
                                <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(c))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))"/>
                            </EditTemplate>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                <hr />
                <div class="row">
                    <div class="col">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="check" Disabled="@(!IsSuperuserOrLineManagerOrPerson(personModel))" />
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Button" Click="DiscardChanges" Text="Discard" Icon="close" />
                    </div>
                </div>
                @if (ErrorMessage != null)
                {
                    <br />
                    <StatusMessageComponent Message=@ErrorMessage />
                }
            </EditForm>
        </div>
    }
</div>