@page "/people/addskills/{PersonId:int}"
@inherits BasePage
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
<PageTitle>Add Skills - CapX</PageTitle>

<div class="container">
    @if (personModel != null)
    {
        <h1>Edit Skills</h1>
        <RadzenText Text="@personModel?.Name" TextStyle="TextStyle.DisplayH5" />
        <hr />
        <div class="card">
            <EditForm Model="@personModel" OnValidSubmit="@HandleValidSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="row">
                    <div class="col-auto mr-auto py-2">
                        <h3>Skill Tags</h3>
                    </div>
                </div>
                <HintComponent Message="If the skill tag you want to add is not in the available list then propose to your manager that it be added to the database!" />
                <hr />
                <div class="row my-2">
                    <div class="col mx-1">
                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" Gap="0.5rem" JustifyContent="JustifyContent.Stretch" AlignItems="AlignItems.Center">
                            <RadzenIcon Icon="search" />
                            <RadzenAutoComplete @bind-Value=@autoCompleteText
                                                Placeholder="Search for Skill Tags to Add"
                                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                                Data=@availableTags
                                                TextProperty="Name"
                                                Change=@OnChange
                                                Style="width:100%"
                                                Disabled="@(!EditAuthorised)"  />
                            <RadzenButton ButtonStyle="ButtonStyle.Light" Icon="clear" Click="@(args => ClearSearch())" MouseEnter="@(args => ShowTooltip(args, "Clear"))" />
                        </RadzenStack>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <RadzenDataList AllowVirtualization=true
                                        class="half-height-list"
                                        WrapItems="false"
                                        AllowPaging="false"
                                        Style="width:100%;"
                                        Data="@chosenTags"
                                        TItem="SkillTag">
                            <Template Context="tag">
                                <div class="row align-items-center">
                                    <div class="col">
                                        @tag.Name
                                    </div>
                                    <div class="col">
                                        @($"{tag.People?.Where(x => x.PersonId != personModel.PersonId)?.Count() ?? 0} other(s) with this tag")
                                    </div>
                                    <div class="col-auto">
                                        <RadzenButton ButtonStyle="ButtonStyle.Danger" Icon="clear" Click="@(args => OnDelete(tag))" MouseEnter="@(args => ShowTooltip(args, "Remove"))" Disabled=!EditAuthorised />
                                    </div>
                                </div>
                            </Template>
                        </RadzenDataList>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="check" Disabled="@(!EditAuthorised)" />
                        <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Button" Click="DiscardChanges" Text="Discard" Icon="close" />
                    </div>
                </div>
                @if (ErrorMessage != null)
                {
                    <br />
                    <StatusMessageComponent Message=@ErrorMessage />
                }
            </EditForm>
        </div>
    }
</div>