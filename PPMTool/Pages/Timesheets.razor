@page "/timesheets"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using System.ComponentModel.DataAnnotations
@using DotNetExtensions
@using System.Diagnostics
<PageTitle>Timesheets - CapX</PageTitle>

<div class="container">
    @if (Loading)
    {
        <LoadingComponent />
    }
    else
    {
        <div class="row">
            <div class="col-auto mr-auto">
                <h1>My Timesheets</h1>
                <RadzenText Text="@($"Next timesheet: {dateNextTimesheet.ToLongDateString()} to {dateNextTimesheet.AddDays(6).ToLongDateString()}")" TextStyle="TextStyle.Subtitle1" />
            </div>
            <div class="col-auto align-content-center">
                <RadzenButton class="float-right" Text="Add" Icon="add" Click="@AddTimesheet" />
            </div>
        </div>
        <hr />
        <div class="card">
            <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                <div>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenText Text="Show All Timesheets" Style="margin-bottom: 0.2rem;" />
                        <RadzenSwitch @bind-Value="@ShowAllMyTimesheets" />
                    </RadzenStack>
                </div>
                <div>
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Style="padding: 0.4rem;" Text="ACTION REQUIRED" Visible="@TimesheetService.HasOwnTimesheetActions()" />
                </div>
            </RadzenRow>
        </div>
        <div class="card">
            <RadzenDataGrid AllowAlternatingRows="true" 
                            AllowPaging="true" 
                            AllowFiltering=@ShowAllMyTimesheets
                            FilterMode="FilterMode.Simple"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            PageSize="5" 
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            AllowSorting="true" 
                            Data="@myTimesheets" 
                            TItem="Timesheet"
                            GridLines="DataGridGridLines.Horizontal">

                <Columns>
                    <RadzenDataGridColumn Property="StartDate" Title="Week Commencing" FormatString="{0:d}" Width="10rem" />
                    <RadzenDataGridColumn Property="Status" Title="Status" Width="10rem">
                        <Template Context="timesheet">
                            <RadzenBadge BadgeStyle="@timesheet.Status.GetBadgeStyle()" class="timesheet-status-style" Text="@timesheet.Status.ToNiceString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="Info" Title="Notes" />
                    <RadzenDataGridColumn TItem="Timesheet" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="100px" FrozenPosition="FrozenColumnPosition.Right" Title="Action">
                        <Template Context="timesheet">
                            <EditOrViewButtonComponent CanViewOnly="@(timesheet.IsPermittedToViewOnly(ActiveUser))"
                                                       IsDisabled="@(!timesheet.IsOwner(ActiveUser) && !timesheet.IsLineManager(ActiveUser))"
                                                       OnButtonClick="@(canView => EditTimesheet(timesheet))"
                                                       ShowTooltip="@((args, message) => ShowTooltip(args, message))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            <div class="timesheet-note">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                    <RadzenIcon Icon="info" IconStyle="IconStyle.Dark" />
                    Shows your 'New/Unsubmitted' and 'Rejected' timesheets by default, and all statuses if the 'Show All Timesheets' option is selected.
                </RadzenStack>
            </div>
        </div>

        <div style="padding-top: 3rem" hidden="@hideStaffResults">
            <div class="row">
                <div class="col-auto mr-auto">
                    <h1>My Staff Timesheets</h1>
                </div>
            </div>
            <hr />
            <div class="card">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                    <RadzenText Text="Staff Synopsis" Style="margin-bottom: 0.2rem" />
                    <RadzenSwitch @bind-Value="@ShowSynopsis" />
                </RadzenStack>
            </div>
            <div class="card" hidden="@(!ShowSynopsis)">
                <table class="table table-striped table-bordered" style="border: 1px solid #ccc; margin-bottom: 0;">
                    <tr style="background-color: #eee;">
                        <th class="timesheet-synopsis-table">
                            Week Commencing
                        </th>
                        @foreach (DateTime d in synopsisDates ?? new List<DateTime>())
                        {
                            double width = 85 / @synopsisDates.Count;
                            int adjustedWidth = (int)Math.Floor(width);

                            string extraStyleDetails = "";
                            if (d == dateMondayThisWeek)
                            {
                                extraStyleDetails = "background-color : #FDFBD4;";
                            }

                            <th class="timesheet-synopsis-table" style="width: @adjustedWidth%; text-align: center; @extraStyleDetails">@d.ToString("dd/MM")</th>
                        }
                    </tr>
                    @foreach (KeyValuePair<Person, List<Timesheet>> kvp in @myStaffTimesheetsInPeriod ?? new Dictionary<Person, List<Timesheet>>())
                    {
                        Debug.WriteLine($"** SYNOPSIS : {kvp.Key.Name} [{kvp.Value.Count}] entries");
                        <tr>
                            <td class="timesheet-synopsis-table">@kvp.Key.Name <span class="badge badge-warning" style="padding: 0.3rem; float: right;">@kvp.Key.ShortName</span></td>
                            
                            @for (int i = 0; i < kvp.Value.Count; i++)
                            {
                                if (@kvp.Value[i] != null)
                                {
                                    Timesheet t = kvp.Value[i];
                                    string badgeStyle = @t.Status.GetBadgeStyle().ToString();
                                    string rzClass = "rz-background-color-" + badgeStyle.Substring(badgeStyle.IndexOf('.') + 1).ToLower();

                                    <td class="@rzClass" style="text-align: center;">
                                        <div title="@t.Status.ToNiceString()" style="font-size: 0.8rem;" onclick="@(() => EditTimesheet(t))">&nbsp;</div>
                                    </td>
                                }
                                else
                                {
                                    Debug.WriteLine("** SYNOPSIS : No timesheet");
                                    if (dateMondayThisWeek <= synopsisDates[i] && synopsisDates[i] < dateMondayThisWeek.AddDays(7))
                                    {
                                        <td style="background-color : #FDFBD4;">&nbsp;</td>
                                    }
                                    else
                                    {
                                        <td>&nbsp;</td>
                                    }
                                }
                            }
                        </tr>
                    }
                </table>
                <div class="timesheet-note">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="info" IconStyle="IconStyle.Dark" />
                        Staff are ordered by their initials. A timesheet can be accessed by clicking the appropriate cell and its current status can be seen by hovering the mouse there. Current calendar week is shaded in cream.
                    </RadzenStack>
                </div>
            </div>

            <div class="card" style="margin-top: 1rem;">
                <RadzenRow JustifyContent="JustifyContent.SpaceBetween">
                    <div>
                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                            <RadzenText Text="Show All Timesheets" Style="margin-bottom: 0.2rem" />
                            <RadzenSwitch @bind-Value="@ShowAllMyStaffTimesheets" />
                        </RadzenStack>
                    </div>
                    <div>
                        <RadzenBadge BadgeStyle="BadgeStyle.Danger" Style="padding: 0.4rem;" Text="ACTION REQUIRED" Visible="@TimesheetService.HasStaffTimesheetActions()" />
                    </div>
                </RadzenRow>
            </div>
            <div class="card">
                <RadzenDataGrid AllowAlternatingRows="true"
                                AllowPaging="true"
                                AllowFiltering="true"
                                FilterMode="FilterMode.Simple"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                PageSize="10"
                                PagerHorizontalAlign="HorizontalAlign.Right"
                                AllowSorting="true"
                                Data="@myStaffTimesheets"
                                TItem="Timesheet"
                                GridLines="DataGridGridLines.Horizontal">

                    <Columns>
                        <RadzenDataGridColumn Property="Owner.Name" Title="Staff Member" Width="20rem"/>
                        <RadzenDataGridColumn Property="StartDate" Title="Week Commencing" FormatString="{0:d}" Width="10rem" />
                        <RadzenDataGridColumn Property="Status" Title="Status" Width="10rem">
                            <Template Context="timesheet">
                                <RadzenBadge BadgeStyle="@timesheet.Status.GetBadgeStyle()" class="timesheet-status-style" Text="@timesheet.Status.ToString()" />
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn Property="Info" Title="Notes" />
                        <RadzenDataGridColumn TItem="Timesheet" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="100px" FrozenPosition="FrozenColumnPosition.Right" Title="Action">
                            <Template Context="timesheet">
                                <EditOrViewButtonComponent CanViewOnly="@(timesheet.IsPermittedToViewOnly(ActiveUser))"
                                                           IsDisabled="@(!timesheet.IsOwner(ActiveUser) && !timesheet.IsLineManager(ActiveUser))"
                                                           OnButtonClick="@(canView => EditTimesheet(timesheet))"
                                                           ShowTooltip="@((args, message) => ShowTooltip(args, message))" />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
                <div class ="timesheet-note">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenIcon Icon="info" IconStyle="IconStyle.Dark" />
                        Timesheets are ordered by date (desc) and only ones marked as 'Submitted' are shown by default. All but 'New/Unsubmitted' are shown if the 'Show All Timesheets' option is selected.
                    </RadzenStack>
                </div>
            </div>
        </div>
    }
</div>
