@page "/timesheets"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using System.ComponentModel.DataAnnotations
@using DotNetExtensions
<PageTitle>Timesheets - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>My Timesheets</h1>
        </div>
        <div class="col-auto">
            <RadzenButton class="float-right" Text="Add" Icon="add" Click="@AddTimesheet" />
        </div>
    </div>
    <hr />
    <div class="card" style="margin-bottom: 0.5rem;">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenText Text="Show All Timesheets" Style="margin-bottom: 0.2rem" />
            <RadzenSwitch @bind-Value="@ShowAll" />
        </RadzenStack>
    </div>
    <RadzenDataGrid AllowAlternatingRows="true" 
                    AllowPaging="true" 
                    AllowFiltering=@ShowAll
                    FilterMode="FilterMode.Simple"
                    PageSize="5" 
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    AllowSorting="true" 
                    Data="@timesheets" 
                    TItem="Timesheet" 
                    GridLines="DataGridGridLines.Horizontal">

        <Columns>
            <RadzenDataGridColumn Property="StartDate" Title="Week Commencing" FormatString="{0:d}" />
            <RadzenDataGridColumn Property="Status" Title="Status" TextAlign="TextAlign.Right">
                <Template Context="data">
                    <RadzenBadge BadgeStyle="@data.Status.GetBadgeStyle()" class="timesheet-status-style" Text="@data.Status.GetDescription()" />
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>
