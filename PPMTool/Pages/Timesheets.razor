@page "/timesheets"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using System.ComponentModel.DataAnnotations
@using DotNetExtensions
<PageTitle>Timesheets - CapX</PageTitle>

<style>
    .rz-text-body2 {
        background-color: yellow;
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>My Timesheets</h1>
        </div>
        <div class="col-auto">
            <RadzenButton class="float-right" Text="Add" Icon="add" Click="@AddTimesheet" />
        </div>
    </div>
    <hr />
    <div class="card">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenText Text="Show All Timesheets" Style="margin-bottom: 0.2rem" />
            <RadzenSwitch @bind-Value="@ShowAllMyTimesheets" />
        </RadzenStack>
    </div>
    <div class="card">
        <RadzenDataGrid AllowAlternatingRows="true" 
                        AllowPaging="true" 
                        AllowFiltering=@ShowAllMyTimesheets
                        FilterMode="FilterMode.Simple"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        PageSize="5" 
                        PagerHorizontalAlign="HorizontalAlign.Right"
                        AllowSorting="true" 
                        Data="@myTimesheets" 
                        TItem="Timesheet"
                        GridLines="DataGridGridLines.Horizontal">

            <Columns>
                <RadzenDataGridColumn Property="StartDate" Title="Week Starting" FormatString="{0:d}" Width="10rem" />
                <RadzenDataGridColumn Property="Status" Title="Status" Width="10rem">
                    <Template Context="data">
                        <RadzenBadge BadgeStyle="@data.Status.GetBadgeStyle()" class="timesheet-status-style" Text="@data.Status.ToNiceString()" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="Info" Title="Notes" />
                <RadzenDataGridColumn TItem="Timesheet" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="100px" FrozenPosition="FrozenColumnPosition.Right" Title="Edit">
                    <Template Context="data">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => EditTimesheet(data))" @onclick:stopPropagation="true" Disabled="@(data.Status == TimesheetStatus.Approved || data.Status == TimesheetStatus.Submitted)" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>

    <div style="padding-top: 3rem" hidden="@hideStaffResults">
        <div class="row">
            <div class="col-auto mr-auto">
                <h1>My Staff Timesheets</h1>
            </div>
        </div>
        <hr />
        <div class="card">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                <RadzenText Text="Show All Timesheets" Style="margin-bottom: 0.2rem" />
                <RadzenSwitch @bind-Value="@ShowAllMyStaffTimesheets" />
            </RadzenStack>
        </div>
        <div class="card">
            <RadzenDataGrid AllowAlternatingRows="true"
                            AllowPaging="true"
                            AllowFiltering="true"
                            FilterMode="FilterMode.Simple"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                            PageSize="10"
                            PagerHorizontalAlign="HorizontalAlign.Right"
                            AllowSorting="true"
                            Data="@myStaffTimesheets"
                            TItem="Timesheet"
                            GridLines="DataGridGridLines.Horizontal">

                <Columns>
                    <RadzenDataGridColumn Property="Owner.Name" Title="Staff member" Width="20rem"/>
                    <RadzenDataGridColumn Property="StartDate" Title="Week Starting" FormatString="{0:d}" Width="10rem"/>
                    <RadzenDataGridColumn Property="Status" Title="Status" Width="10rem">
                        <Template Context="data">
                            <RadzenBadge BadgeStyle="@data.Status.GetBadgeStyle()" class="timesheet-status-style" Text="@data.Status.ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Property="Info" Title="Notes" />
                    <RadzenDataGridColumn TItem="Timesheet" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="100px" FrozenPosition="FrozenColumnPosition.Right" Title="Edit">
                        <Template Context="data">
                            <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => EditTimesheet(data))" @onclick:stopPropagation="true" Disabled="@(data.Status == TimesheetStatus.Rejected || data.Status == TimesheetStatus.Approved)" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </div>
</div>
