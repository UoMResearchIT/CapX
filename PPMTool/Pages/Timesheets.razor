@page "/timesheets"
@inherits PPMTool.Pages.BaseProjectPage
@using PPMTool.Data.Context
@using PPMTool.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using System.ComponentModel.DataAnnotations
<PageTitle>Timesheets - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>My timesheets</h1>
        </div>
        <div class="col-auto">
            <RadzenButton class="float-right" Text="Add" Icon="add" Click="@AddTimesheet" />
        </div>
    </div>
    <hr />
    <div class="card" style="margin-bottom: 0.5rem;">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
            <RadzenText Text="Show All Timesheets" Style="margin-bottom: 0.2rem" />
            <RadzenSwitch @bind-Value="@ShowAll" />
        </RadzenStack>
    </div>
    <RadzenDataGrid @ref="timesheetsGrid" 
                    AllowAlternatingRows="true" 
                    AllowPaging="true" 
                    AllowFiltering=@ShowAll
                    FilterMode="FilterMode.Simple"
                    PageSize="5" 
                    PagerHorizontalAlign="HorizontalAlign.Right"
                    AllowSorting="true" 
                    Data="@timesheets" 
                    TItem="Timesheet" 
                    GridLines="DataGridGridLines.Horizontal">

        <Columns>
            <RadzenDataGridColumn Property="StartDate" Title="Week commencing" FormatString="{0:d}" />
            <RadzenDataGridColumn Property="Status" Title="Status" TextAlign="TextAlign.Right">
                <Template Context="data">
                    <!-- PHB ** Duplicated code : need to implement with a variable for the styling being set -->
                    @if(data.Status == TimesheetStatus.New)
                    {
                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Info" Style="border-radius: 5px; width: 8rem; padding: 0.5rem;" Text="@data.Status.ToString()" />
                    }

                    @if(data.Status == TimesheetStatus.Submitted)
                    {
                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Primary" Style="border-radius: 5px; width: 8rem; padding: 0.5rem;" Text="@data.Status.ToString()" />
                    }

                    @if (data.Status == TimesheetStatus.Rejected)
                    {
                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Danger" Style="border-radius: 5px; width: 8rem; padding: 0.5rem;" Text="@data.Status.ToString()" />
                    }

                    @if (data.Status == TimesheetStatus.Approved)
                    {
                        <RadzenBadge IsPill="true" BadgeStyle="BadgeStyle.Success" Style="border-radius: 5px; width: 8rem; padding: 0.5rem;" Text="@data.Status.ToString()" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</div>
