@page "/timesheets"
@inherits PPMTool.Pages.BasePage
@using PPMTool.Data
@using PPMTool.Data.Context
@using PPMTool.Data.Enums
@using PPMTool.Data.Entities
@using PPMTool.Pages.Components
@using System.ComponentModel.DataAnnotations
@using System.Diagnostics
<PageTitle>Timesheets - CapX</PageTitle>

<FeatureCheckComponent Feature="FeatureType.Timesheets">

    <div class="container">
        @if (ActiveUser?.Person != null)
        {
            <div class="row">
                <div class="col-auto mr-auto">
                    <h1>My Timesheets</h1>
                    <RadzenText Text="@($"Next timesheet: {dateNextTimesheet.ToLongDateString()} to {dateNextTimesheet.AddDays(6).ToLongDateString()}")" TextStyle="TextStyle.Subtitle1" />
                    <StatusMessageSummaryComponent Messages="@(new List<StatusMessage> { new StatusMessage("You have rejected timesheets to re-submit", StatusMessage.MessageType.Error, () => TimesheetService.HasOwnTimesheetActions) })" />
                </div>
                <div class="col-auto align-content-center">
                    <RadzenButton class="float-right" Text="Add" Icon="add" Click="@AddTimesheet" Disabled="@Loading" />
                </div>
            </div>
            @if (timesheetIdToFix > 0)
            {
              <FixMeComponent Message="You have a rejected timesheet that needs fixing!" OnClick="@(() => Navigation.NavigateTo($"timesheets/addtimesheet/{timesheetIdToFix}"))" />
            }
            <hr />
            <div class="row align-items-center justify-content-end">
                <div class="col">
                    <HintComponent Message="Shows your 'New/Unsubmitted' and 'Rejected' timesheets by default, and all statuses if the 'Show All Timesheets' option is selected." />
                </div>
                <div class="col-auto">
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle=TextStyle.Subtitle1 Text="Show All Timesheets" Style="margin-bottom: -0.2rem;" />
                        <RadzenSwitch @bind-Value="@ShowAllMyTimesheets" Disabled="@Loading" />
                    </RadzenStack>
                </div>
            </div>
            <RadzenCard>
                @if (Loading)
                {
                    <LoadingComponent />
                }
                else
                {
                    <RadzenDataGrid AllowAlternatingRows="true" 
                                    AllowPaging="true" 
                                    AllowFiltering=@ShowAllMyTimesheets
                                    FilterMode="FilterMode.Simple"
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                    PageSize="5" 
                                    PagerHorizontalAlign="HorizontalAlign.Right"
                                    AllowSorting="true" 
                                    Data="@myTimesheets" 
                                    TItem="Timesheet"
                                    GridLines="DataGridGridLines.Horizontal">

                        <Columns>
                            <RadzenDataGridColumn Property="StartDate" Title="Week Commencing" FormatString="{0:d}" Width="10rem" />
                            <RadzenDataGridColumn Property="Status" Title="Status" Width="10rem">
                                <Template Context="timesheet">
                                    <RadzenBadge BadgeStyle="@timesheet.Status.GetBadgeStyle()" class="timesheet-status-style" Text="@timesheet.Status.ToNiceString()" />
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn Property="Info" Title="Notes" />
                            <RadzenDataGridColumn TItem="Timesheet" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="100px" FrozenPosition="FrozenColumnPosition.Right" Title="Action">
                                <Template Context="timesheet">
                                    <EditOrViewButtonComponent CanViewOnly="@(timesheet.IsPermittedToViewOnly(ActiveUser))"
                                                               IsDisabled="@(!timesheet.IsOwner(ActiveUser) && !timesheet.IsLineManager(ActiveUser))"
                                                               OnButtonClick="@(canView => EditTimesheet(timesheet))"
                                                               ShowTooltip="@((args, message) => ShowTooltip(args, message))" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </RadzenCard>
            <br />
        }
        @if (ActiveUserRoleType == RoleType.Manager || ActiveUserRoleType == RoleType.Superuser)
        {
            <div>
                <div class="row align-items-center">
                    <div class="col">
                        <h1>My Staff Timesheets</h1>
                    </div>
                    <div class="col-auto">
                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Visible="@(ActiveUserRoleType == RoleType.Superuser)">
                            <RadzenText TextStyle="TextStyle.Subtitle1"  Text="Show Synopsis for ALL Staff" Style="margin-bottom: -0.2rem" />
                            <RadzenSwitch @bind-Value="@SuperuserShowSynopsisForAllStaff" Disabled="@Loading" />
                        </RadzenStack>
                    </div>
                </div>
                <StatusMessageSummaryComponent Messages="@(new List<StatusMessage> {new StatusMessage("You have timesheets awaiting your review", StatusMessage.MessageType.Error, () => TimesheetService.HasStaffTimesheetActions)})" />
                <hr />
                <div class="row align-items-center justify-content-end">
                    <div class="col">
                        <HintComponent Message="Staff are ordered by their initials. A timesheet can be accessed by clicking the appropriate cell. Current calendar week is shaded." />
                    </div>
                    <div class="col-auto">
                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" >
                            <RadzenText TextStyle="TextStyle.Subtitle1" Text="Show Staff Synopsis" Style="margin-bottom: -0.2rem" />
                            <RadzenSwitch @bind-Value="@ShowSynopsis" Disabled="@Loading" />
                        </RadzenStack>
                    </div>
                </div>
                <RadzenCard hidden="@(!ShowSynopsis)">
                    @if (Loading)
                    {
                        <LoadingComponent />
                    }
                    else
                    {
                        <table class="table table-striped table-bordered"
                               style="border: 1px solid #ccc; margin-bottom: 0;">
                            <tr style="background-color: var(--rz-info-lighter);">
                                <th class="timesheet-synopsis-table">
                                    Week Commencing
                                </th>

                                @foreach (DateTime d in synopsisDates ?? new List<DateTime>())
                                {
                                    double width = 85 / synopsisDates.Count;
                                    int adjustedWidth = (int)Math.Floor(width);

                                    string extraStyleDetails = "";
                                    if (d.Date == dateMondayThisWeek.Date)
                                    {
                                        extraStyleDetails = "background-color: var(--rz-warning-lighter);";
                                    }

                                    <th class="timesheet-synopsis-table"
                                        title="@d.ToString("dddd, dd MMMM yyyy")"
                                        style="width: @adjustedWidth%; text-align: center; @extraStyleDetails">
                                        <div style="display: flex; flex-direction: column; line-height: 1.1;">
                                            <strong>@d.ToString("dd/MM")</strong>
                                            <small style="opacity: 0.7; margin-top: 2px;">
                                                @d.ToString("ddd")
                                            </small>
                                        </div>
                                    </th>
                                }
                            </tr>

                            @foreach (KeyValuePair<Person, List<Timesheet>> kvp in
                                myStaffTimesheetsInPeriod ?? new Dictionary<Person, List<Timesheet>>())
                            {
                                Debug.WriteLine($"** SYNOPSIS : {kvp.Key.Name} [{kvp.Value.Count}] entries");

                                <tr>
                                    <td class="timesheet-synopsis-table">
                                        @kvp.Key.Name

                                        @if (SuperuserShowSynopsisForAllStaff)
                                        {
                                            <RadzenBadge Text="@kvp.Key.LineManager?.ShortName"
                                                         BadgeStyle="BadgeStyle.Info"
                                                         Style="margin-left: 0.25rem;"
                                                         title="@($"Line Manager: {kvp.Key.LineManager?.Name}")" />
                                        }

                                        <RadzenBadge Text="@kvp.Key.ShortName"
                                                     BadgeStyle="BadgeStyle.Warning"
                                                     Style="float: right;" />
                                    </td>

                                    @for (int i = 0; i < kvp.Value.Count; i++)
                                    {
                                        if (kvp.Value[i] != null)
                                        {
                                            Timesheet t = kvp.Value[i];

                                            string badgeStyle = t.Status.GetBadgeStyle().ToString();
                                            string statusName = badgeStyle.Substring(badgeStyle.IndexOf('.') + 1).ToLower();

                                            bool isCurrentWeek = synopsisDates[i].Date == dateMondayThisWeek.Date;

                                            string cellBackground = isCurrentWeek
                                                ? "background-color: var(--rz-warning-lighter);"
                                                : $"background-color: var(--rz-{statusName}-lighter);";

                                            <td class="timesheet-status-cell"
                                                style="@cellBackground"
                                                @onclick="@(() => EditTimesheet(t))"
                                                title="@($"Click to view/edit this {t.Status.ToNiceString()} timesheet")">

                                                <RadzenBadge Text="@t.Status.ToNiceString()"
                                                             BadgeStyle="@t.Status.GetBadgeStyle()"
                                                             Style="pointer-events: none;" />
                                            </td>
                                        }
                                        else
                                        {
                                            Debug.WriteLine("** SYNOPSIS : No timesheet");

                                            if (synopsisDates[i].Date == dateMondayThisWeek.Date)
                                            {
                                                <td class="timesheet-empty-cell"
                                                    style="background-color: var(--rz-warning-lighter);"
                                                    title="No timesheet">
                                                    &mdash;
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="timesheet-empty-cell"
                                                    title="No timesheet">
                                                    &mdash;
                                                </td>
                                            }
                                        }
                                    }
                                </tr>
                            }
                        </table>
                    }
                </RadzenCard>
                <hr />
                <div class="row align-items-center justify-content-end">
                    <div class="col">
                        <HintComponent Message="Timesheets are ordered by date (desc) and only ones marked as 'Submitted' are shown by default. All are shown if the 'Show All Timesheets' switch is enabled." />
                    </div>
                    <div class="col-auto">
                        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center">
                            <RadzenText TextStyle=TextStyle.Subtitle1 Text="Show All Timesheets" Style="margin-bottom: -0.2rem;" />
                            <RadzenSwitch @bind-Value="@ShowAllMyStaffTimesheets" Disabled="@Loading" />
                        </RadzenStack>
                    </div>
                </div>
                <RadzenCard>
                    @if (Loading)
                    {
                        <LoadingComponent />
                    }
                    else
                    {
                        <RadzenDataGrid AllowAlternatingRows="true"
                                        AllowPaging="true"
                                        AllowFiltering="true"
                                        FilterMode="FilterMode.Simple"
                                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                        PageSize="10"
                                        PagerHorizontalAlign="HorizontalAlign.Right"
                                        AllowSorting="true"
                                        Data="@myStaffTimesheets"
                                        TItem="Timesheet"
                                        GridLines="DataGridGridLines.Horizontal">

                            <Columns>
                                <RadzenDataGridColumn Property="Owner.Name" Title="Staff Member" Width="20rem"/>
                                <RadzenDataGridColumn Property="StartDate" Title="Week Commencing" FormatString="{0:d}" Width="10rem" />
                                <RadzenDataGridColumn Property="Status" Title="Status" Width="10rem">
                                    <Template Context="timesheet">
                                        <RadzenBadge BadgeStyle="@timesheet.Status.GetBadgeStyle()" class="timesheet-status-style" Text="@timesheet.Status.ToString()" />
                                    </Template>
                                </RadzenDataGridColumn>
                                <RadzenDataGridColumn Property="Info" Title="Notes" />
                                <RadzenDataGridColumn TItem="Timesheet" Frozen="true" Resizable="false" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="100px" FrozenPosition="FrozenColumnPosition.Right" Title="Action">
                                    <Template Context="timesheet">
                                        <EditOrViewButtonComponent CanViewOnly="@(timesheet.IsPermittedToViewOnly(ActiveUser))"
                                                                   IsDisabled="@(!timesheet.IsOwner(ActiveUser) && !timesheet.IsLineManager(ActiveUser) && ActiveUserRoleType != RoleType.Superuser)"
                                                                   OnButtonClick="@(canView => EditTimesheet(timesheet))"
                                                                   ShowTooltip="@((args, message) => ShowTooltip(args, message))" />
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenCard>
            </div>
        }
    </div>

</FeatureCheckComponent>
