@page "/manageaccess"
@inherits DataGridPage<User>
@using PPMTool.Pages.Components
@using PPMTool.Data.Entities
<PageTitle>Manage Access - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>Manage Access</h1>
        </div>
        <div class="col-auto">
            <RadzenButton class="float-right" Text="Add" Icon="add" Click="@InsertRow" Disabled=@(entityToInsert != null) />
        </div>
    </div>
    <div class="row">
        <div class="col py-2">
            <RadzenText Text="Manage what users can access the app, what role they have when doing so and whether they are linked to a team member." />
        </div>
    </div>
    @if (ErrorMessage != null)
    {
        <StatusMessageComponent Message="ErrorMessage" />
    }
    <hr />
    <RadzenDataGrid @ref="dataGrid"
                    AllowFiltering="@(dataGridEntities != null && dataGridEntities.Count > 0)"
                    AllowPaging="true"
                    PageSize="15"
                    AllowSorting="true"
                    ShowPagingSummary="true"
                    EditMode="DataGridEditMode.Single"
                    FilterMode="FilterMode.Simple"
                    Data="@dataGridEntities"
                    TItem="User"
                    RowUpdate="@OnUpdateRow"
                    RowCreate="@OnCreateRow"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    ColumnWidth="12rem">
        <Columns>
            <RadzenDataGridColumn TItem="User" Property="Person.Name" Title="Person (RSE)" MinWidth="10px">
                <EditTemplate Context="user">
                    <RadzenDropDown @bind-Value="user.Person" Data="@people" Style="width:100%; display: block;">
                        <Template Context="person">
                            @person.Name
                        </Template>
                    </RadzenDropDown>
                </EditTemplate>
                <Template Context="user">
                    @if (user.Person != null)
                    {
                        @($"{user.Person?.Name} ({user.Person?.ShortName})")
                    }
                    else
                    {
                        @("[External]")
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="Name" Title="Display Name" MinWidth="10px">
                <EditTemplate Context="user">
                    @if (user.Person == null)
                    {
                        <RadzenTextBox class="no-margin" @bind-Value="user.Name" />
                    }
                    else
                    {
                        @user.Person.Name
                    }
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="CASUserName" Title="User Name" MinWidth="10px">
                <EditTemplate Context="user">
                    <RadzenTextBox class="no-margin" @bind-Value="user.CASUserName" ValueProperty="CASUserName" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="EmailAddress" Title="Email" MinWidth="10px">
                <EditTemplate Context="user">
                    <RadzenTextBox class="no-margin" @bind-Value="user.EmailAddress" ValueProperty="EmailAddress" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="RoleType" Title="Access Level" MinWidth="10px">
                <EditTemplate Context="user">
                    <RadzenDropDown @bind-Value="user.RoleType" Data="@roles" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Property="LastLoggedIn" Title="Last Logged In" MinWidth="10px">
                <Template Context="user">
                    @user.LastLoggedIn
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="User" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="8rem" MinWidth="10px" Title="Actions">
                <Template Context="user">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(user))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(user))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" />
                </Template>
                <EditTemplate Context="user">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(user))" MouseEnter="@(args => ShowTooltip(args, "Save"))" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(user))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <br />
</div>