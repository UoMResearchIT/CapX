@page "/manageaccess"
@inherits DataGridPage<Role>
@using PPMTool.Pages.Components
@using PPMTool.Data.Entities

<div class="container">
    <div class="row">
        <div class="col-auto mr-auto">
            <h1>Manage Access</h1>
        </div>
        <div class="col-auto">
            <RadzenButton class="float-right" Text="Add" Icon="add" Click="@InsertRow" Disabled=@(entityToInsert != null) />
        </div>
    </div>
    @if (errorMessage != null)
    {
        <StatusMessageComponent Message="errorMessage" />
    }
    <hr />
    <RadzenDataGrid @ref="dataGrid"
                    AllowFiltering="@(dataGridEntities != null && dataGridEntities.Count > 0)"
                    AllowPaging="true"
                    PageSize="15"
                    AllowSorting="true"
                    ShowPagingSummary="true"
                    EditMode="DataGridEditMode.Single"
                    FilterMode="FilterMode.Simple"
                    Data="@dataGridEntities"
                    TItem="Role"
                    RowUpdate="@OnUpdateRow"
                    RowCreate="@OnCreateRow"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                    ColumnWidth="12rem">
        <Columns>
            <RadzenDataGridColumn TItem="Role" Property="Person.Name" Title="Person (RSE)" MinWidth="10px">
                <EditTemplate Context="role">
                    <RadzenDropDown @bind-Value="role.Person" Data="@people" Style="width:100%; display: block;">
                        <Template Context="person">
                            @person.Name
                        </Template>
                    </RadzenDropDown>
                </EditTemplate>
                <Template Context="role">
                    @if (role.Person != null)
                    {
                        @($"{role.Person?.Name} ({role.Person?.ShortName})")
                    }
                    else
                    {
                        @("[External]")
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Role" Property="Name" Title="Display Name" MinWidth="10px">
                <EditTemplate Context="role">
                    @if (role.Person == null)
                    {
                        <RadzenTextBox class="no-margin" @bind-Value="role.Name" />
                    }
                    else
                    {
                        @role.Person.Name
                    }
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Role" Property="CASUserName" Title="User Name" MinWidth="10px">
                <EditTemplate Context="role">
                    <RadzenTextBox class="no-margin" @bind-Value="role.CASUserName" ValueProperty="CASUserName" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Role" Property="EmailAddress" Title="Email" MinWidth="10px">
                <EditTemplate Context="role">
                    <RadzenTextBox class="no-margin" @bind-Value="role.EmailAddress" ValueProperty="EmailAddress" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Role" Property="RoleType" Title="Access Level" MinWidth="10px">
                <EditTemplate Context="role">
                    <RadzenDropDown @bind-Value="role.RoleType" Data="@roles" />
                </EditTemplate>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Role" Property="LastLoggedIn" Title="Last Logged In" MinWidth="10px">
                <Template Context="role">
                    @role.LastLoggedIn
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Role" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="12rem" MinWidth="10px" Title="Actions">
                <Template Context="role">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(role))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(role))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" />
                </Template>
                <EditTemplate Context="role">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(role))" MouseEnter="@(args => ShowTooltip(args, "Save"))" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(role))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(role))" MouseEnter="@(args => ShowTooltip(args, "Delete"))" Visible="@(entityToInsert == null)" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    <br />
</div>