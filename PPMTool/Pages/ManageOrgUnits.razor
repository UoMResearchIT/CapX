@*
@page "/manageorgunits"
@inherits DataGridPage<Faculty>

@using PPMTool.Data.Entities
@using PPMTool.Enums
@using PPMTool.Pages.Components
<PageTitle>Manage Org Units - CapX</PageTitle>

<div class="container">
    <div class="row">
        <div class="col py-2">
            <h1>Manage Organisational Units</h1>
        </div>
        <!--
        <div class="col-auto py-2 align-items-center">
            <RadzenButton Text="Add" Icon="add" Click="@InsertRow" Disabled="@(entityToInsert != null || Loading || !EditAuthorised)" />
        </div>
        -->
    </div>
    @if (ErrorMessage != null)
    {
        <StatusMessageComponent Message="ErrorMessage" />
    }
    <hr />
    @if (Loading)
    {
        <LoadingComponent />
    }
    else
    {
        <RadzenDataGrid @ref="dataGrid"
                        AllowFiltering="true"
                        AllowPaging="false"
                        Count="@count"
                        AllowSorting="true"
                        EditMode="DataGridEditMode.Single"
                        Data="@dataGridEntities"
                        TItem="Faculty"
                        RowUpdate="@OnUpdateRow"
                        RowCreate="@OnCreateRow"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                        FilterMode="FilterMode.Simple"
                        LoadData="LoadDataGrid">
            <Columns>
                <RadzenDataGridColumn TItem="Faculty" Property="Name" Title="Name" Width="80%" MinWidth="10px" FilterOperator="FilterOperator.Contains">
                    <EditTemplate Context="Faculty">
                        <RadzenTextBox class="no-margin" @bind-Value="Faculty.Name" />
                    </EditTemplate>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn TItem="Faculty" Filterable="false" Sortable="false" TextAlign="TextAlign.End" Width="10%" MinWidth="10px" Title="Actions">
                    <Template Context="f">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditRow(f))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" Disabled="@(Loading || !EditAuthorised)" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteRow(f))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" Disabled="@(Loading || !EditAuthorised)" />
                    </Template>
                    <EditTemplate Context="f">
                        <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Class="m-1" Click="@(args => SaveRow(f))" MouseEnter="@(args => ShowTooltip(args, "Save"))" />
                        <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => CancelEdit(f))" MouseEnter="@(args => ShowTooltip(args, "Cancel"))" />
                    </EditTemplate>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
        <br />
    }
</div> *@