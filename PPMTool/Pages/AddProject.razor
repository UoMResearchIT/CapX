@page "/addproject/{ProjectId:int}"
@inherits BasePage
@using PPMTool.Enums
@using PPMTool.Data

<div class="container">
    @if (ProjectId < 0)
    {
        <h1>Add Project</h1>
    }
    else
    {
        <div class="row">
            <div class="col">
                <h1>Edit @projectModel.Name</h1>
            </div>
            <div class="col-auto" style="align-content: center">
                <button class="btn btn-danger" type="button" @onclick="DeleteProject"><i class="oi oi-trash" /> Delete</button>
            </div>
        </div>
    }
    <div class="card">
        <EditForm Model="@projectModel" OnValidSubmit="@HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="row">
                <div class="col-3">
                    <label for="RTP">RTP-</label>
                </div>
                <div class="col">
                    <InputNumber min="0" step="1" @bind-Value="projectModel.RTP" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="Name">Name</label>
                </div>
                <div class="col">
                    <InputText @bind-Value="projectModel.Name" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="PI">Principal Investigator</label>
                </div>
                <div class="col">
                    <InputText @bind-Value="projectModel.PI" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="InnateActivity">Innate Activity</label>
                </div>
                <div class="col">
                    <InputSelect @bind-Value="projectModel.InnateActivity">
                        @foreach (var c in ResourceHelper.AvailableInnateActivities)
                        {
                            <option value="@c">@c</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="Portfolio">Portfolio</label>
                </div>
                <div class="col">
                    <InputSelect @bind-Value="projectModel.Portfolio">
                        @foreach (var c in (Portfolio[])Enum.GetValues(typeof(Portfolio)))
                        {
                            <option value="@c">@c.ToNiceString()</option>
                        }
                    </InputSelect>
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="Budget">Agreed Budget (£)</label>
                </div>
                <div class="col">
                    <InputNumber type="currency" min="0.0" step="0.01" placeholder="0.00" @bind-Value="projectModel.Budget" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="FundsReceived">Funds Received (£)</label>
                </div>
                <div class="col">
                    <InputNumber min="0.0" step="0.01" placeholder="0.00" @bind-Value="projectModel.FundsReceived" />
                </div>
            </div>
            <div class="row">
                <div class="col-3">
                    <label for="ProjectStatus">Project Status</label>
                </div>
                <div class="col">
                    <InputSelect @bind-Value="projectModel.ProjectStatus">
                        @foreach (var c in (ProjectStatus[])Enum.GetValues(typeof(ProjectStatus)))
                        {
                            <option value="@c">@c.ToNiceString()</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div>
            <button class="btn btn-primary" type="submit" @onclick="@(()=> { gotoDetails = false; discardChanges = false; })"><i class="oi oi-check" /> Save</button>
            <button class="btn btn-outline-danger" type="submit" @onclick="@(()=> { gotoDetails = false; discardChanges = true; })"><i class="oi oi-x" /> Discard</button>
            </div>

            <div>
            <button class="btn btn-primary" type="submit" @onclick="@(()=> { gotoDetails = true; discardChanges = false; })"><i class="oi oi-check" /> Save and See Details</button>
            @if (ProjectId > -1)
            {
                <button class="btn btn-outline-danger" style="margin-left: 5px" type="submit" @onclick="@(()=> { gotoDetails = true; discardChanges = true; })"><i class="oi oi-x" /> Discard and See Details</button>
            }
            </div>
        </EditForm>
    </div>
</div>