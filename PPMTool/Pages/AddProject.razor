@page "/addproject/{ProjectId:int}"
@inherits BasePage
@using PPMTool.Enums
@using PPMTool.Data
@using PPMTool.Pages.Components

<div class="container">
    @if (ProjectId <= 0)
    {
        <h1>Add Project</h1>
    }
    else
    {
        <div class="row">
            <div class="col">
                <h1>Edit <i>@projectModel.GetFullName()</i></h1>
            </div>
            <div class="col-auto" style="align-content: center">
                <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Button" Click="@DeleteProject" Text="Delete" Icon="delete" Disabled=!EditAuthorised />
            </div>
        </div>
    }
    @if (!EditAuthorised)
    {
        <RadzenStack Orientation="Radzen.Orientation.Vertical" Gap="0.1rem">
            <ProjectManagerOnlyComponent />
        </RadzenStack>
    }
    <hr />
    <div class="card">
        <EditForm EditContext="editContext" OnSubmit="HandleSubmit">
            <div class="row">
                <div class="col-8">
                    <RadzenLabel class="radzen-form-label" Text="Project Name" /><br />
                    <RadzenTextBox TValue="string" @bind-Value="projectModel.Name" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Project Status" /><br />
                    <RadzenDropDown class="radzen-dropdown" @bind-Value="projectModel.ProjectStatus" Data=@statuses>
                        <Template Context="x">
                            @GetNiceString(x)
                        </Template>
                    </RadzenDropDown>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="RTP Number" /><br />
                    <RadzenNumeric class="radzen-numeric" TValue="int" Min="0" Step="1" @bind-Value="projectModel.RTP" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Faculty" /><br />
                    <RadzenDropDown class="radzen-dropdown" TValue="Faculty" @bind-Value="projectModel.Faculty" Data="@faculties" Change="OnFacultyChosen">
                        <Template Context="x">
                            @GetNiceString(x)
                        </Template>
                    </RadzenDropDown>
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="School" /><br />
                    <RadzenDropDown class="radzen-dropdown" TValue="School" @bind-Value="projectModel.School" Data="@schools">
                        <Template Context="x">
                            @GetNiceString(x)
                        </Template>
                    </RadzenDropDown>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Product Owner" /><br />
                    <RadzenTextBox TValue="string" @bind-Value="projectModel.PI" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Project Manager" /><br />
                    <RadzenDropDown class="radzen-dropdown" style="width: 100%" @bind-Value="projectModel.ProjectManager" Data="@projectManagers">
                        <Template Context="person">
                            @person.Name
                        </Template>
                    </RadzenDropDown>
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Innate Activity" /><br />
                    <RadzenDropDown class="radzen-dropdown" style="width: 100%" @bind-Value="projectModel.InnateActivity" Data="@innateActivities" 
                                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" AllowFiltering="true" AllowClear="true"
                                    LoadData="@LoadInnateDropdownData">
                        <Template Context="activity">
                            @activity.GetCodeAsString()
                        </Template>
                    </RadzenDropDown>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Public Description" /><br />
                    <RadzenHtmlEditor @bind-Value="@projectModel.Description" Style="min-height: 10rem" Placeholder="Note that this description will be displayed on the project bullentin board and will be visible to all users!"/>
                </div>
            </div>
            <div class="row">
                <div class="col-4">
                    <RadzenLabel class="radzen-form-label" Text="Link to Request Doc" /><br />
                    <RadzenTextBox TValue="string" @bind-Value="projectModel.RequestDocLink" Placeholder="https://..."  />
                </div>
                <div class="col-4">
                    <RadzenLabel class="radzen-form-label" Text="Link to Scrum Project" /><br />
                    <RadzenTextBox TValue="string" @bind-Value="projectModel.ScrumProjectLink" Placeholder="https://..." />
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Day Rate (£)" /><br />
                    <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.01" Placeholder="0.00" @bind-Value="projectModel.DayRate" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Agreed Budget (£)" /><br />
                    <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.01" Placeholder="0.00" @bind-Value="projectModel.Budget" />
                </div>
                <div class="col">
                    <RadzenLabel class="radzen-form-label" Text="Funds Received (£)" /><br />
                    <RadzenNumeric class="radzen-numeric" TValue="double" Min="@Convert.ToDecimal(0.0)" Step="0.01" Placeholder="0.00" @bind-Value="projectModel.FundsReceived" />
                </div>
            </div>
            <hr />
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div>
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save" Icon="check" Click="@(()=> { gotoDetails = true; discardChanges = false; })" Disabled=!EditAuthorised />
                <RadzenButton ButtonStyle="ButtonStyle.Danger" ButtonType="ButtonType.Submit" Text="Discard" Icon="close" Click="@(()=> { gotoDetails = ProjectId > 0; discardChanges = true; })" />
            </div>
        </EditForm>
    </div>
</div>