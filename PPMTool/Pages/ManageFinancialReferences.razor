@page "/managefinref"
@inherits DataGridPage<FinancialReference>
@using PPMTool.Data.Entities
@using PPMTool.Data.Enums
@using PPMTool.Pages.Components
<PageTitle>Manage Financial Refs - CapX</PageTitle>

<FeatureCheckComponent Feature="FeatureType.ProjectFinance">

    <div class="container">
        <div class="row">
            <div class="col-auto mr-auto">
                <h1>Manage Financial References</h1>
            </div>
            <div class="col-auto">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal">
                    <RadzenButton class="float-right mr-2" Text="Manage Value Sets" Icon="list" Click="@ManageValueSets" Disabled="@(!EditAuthorised)" />
                    <RadzenButton class="float-right" Text="Add" Icon="add" Click="@AddReference" Disabled="@(!EditAuthorised)" />
                </RadzenStack>
            </div>
        </div>
        <div class="row">
            <div class="col py-2">
                <RadzenText Text="Manage financial reference sets by year and maintain their named values." />
            </div>
        </div>
        @if (ErrorMessage != null)
        {
            <StatusMessageComponent Message="ErrorMessage" />
        }
        <hr />
        <RadzenDataGrid @ref="dataGrid"
                        AllowFiltering="@(dataGridEntities != null && dataGridEntities.Count > 0)"
                        AllowPaging="true"
                        PageSize="15"
                        ShowPagingSummary="true"
                        PagerHorizontalAlign="HorizontalAlign.Left"
                        PagerPosition="PagerPosition.TopAndBottom"
                        AllowSorting="true"
                        FilterMode="FilterMode.Simple"
                        Data="@dataGridEntities"
                        TItem="FinancialReference"
                        FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive">
            <Columns>
                <RadzenDataGridColumn TItem="FinancialReference" Property="FinancialYear" Title="Financial Year" Width="12rem" MinWidth="10px" />
                <RadzenDataGridColumn TItem="FinancialReference" Property="Values" Title="Values" MinWidth="10px" Filterable="false" Sortable="false">
                    <Template Context="fin">
                        @(fin.Values != null && fin.Values.Count() > 0 ? string.Join(", ", fin.Values.Select(x => $"{x.FinancialReferenceValueSet?.Name}: {x.Value:C}")) : "")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TItem="FinancialReference" Filterable="false" Sortable="false" TextAlign="TextAlign.Center" Width="12rem" MinWidth="10px" Title="Actions">
                    <Template Context="fin">
                        <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Class="m-1" Click="@(args => EditReference(fin))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Edit"))" Disabled="@(!EditAuthorised)" />
                        <RadzenButton Icon="content_copy" ButtonStyle="ButtonStyle.Primary" Class="m-1" Click="@(args => CopyReference(fin))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Duplicate"))" Disabled="@(!EditAuthorised)" />
                        <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Class="m-1" Click="@(args => DeleteReference(fin))" @onclick:stopPropagation="true" MouseEnter="@(args => ShowTooltip(args, "Delete"))" Disabled="@(!EditAuthorised)" />
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
        <br />
    </div>

</FeatureCheckComponent>
