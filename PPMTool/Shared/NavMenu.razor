@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand" href="">CapX</a><RadzenImage Path="images/rse-logo-374x335.png" Style="width: 30%; align-items: center" AlternateText="RSE logo" />
    <button class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass row">
    <ul class="nav flex-column">
        <AuthorizeView Roles="Superuser,Manager,Developer,Reader">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="oi oi-briefcase" aria-hidden="true"></span> Projects
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Superuser,Manager,Developer,Reader">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="capacity">
                        <span class="oi oi-list-rich" aria-hidden="true"></span> Capacity
                    </NavLink>
                </li>
        </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Superuser,Manager,Developer">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="people">
                        <span class="oi oi-people" aria-hidden="true"></span> People
                    </NavLink>
                </li>
        </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Superuser,Manager,Developer">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="projectbulletinboard">
                        <span class="oi oi-spreadsheet" aria-hidden="true"></span> Available Projects
                    </NavLink>
                </li>
        </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Superuser,Manager">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="manageskills">
                        <span class="oi oi-tags" aria-hidden="true"></span> Skills Tags
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Superuser">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="manageaccess">
                        <span class="oi oi-lock-locked" aria-hidden="true"></span> Access Control
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Superuser">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="managecodes">
                        <span class="oi oi-timer" aria-hidden="true"></span> Timesheet Codes
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Superuser">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="managefinref">
                        <span class="oi oi-british-pound" aria-hidden="true"></span> Financial Refs
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Roles="Superuser,Manager,Developer,None">
            <Authorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="datadashboard">
                        <span class="oi oi-dashboard" aria-hidden="true"></span> Data Dashboard
                    </NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
    </ul>
</div>

<div class="col" style="position: absolute; bottom: 0">
    <div class="row" style="justify-content: center">
        <RadzenText TextStyle=TextStyle.Subtitle1 Style="color: white" Text=@versionString />
    </div>
</div>

@code {
    private bool collapseNavMenu = true;

    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private string versionString;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        versionString = $"v{Configuration["VersionNumber"]}";
    }
}
