
<AuthorizeView>
    <Authorized>
        Hello, @(context.User.Identity.Name)!
        <a class="btn btn-secondary mx-2" href="/Account/Logout">Log out</a>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-secondary mx-2" href="/Account/Login">Log in</a>
    </NotAuthorized>
</AuthorizeView>