@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Hosting;
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Hosting;
@using System.Diagnostics
@using System.Linq
@using Microsoft.Extensions.Logging
@using PPMTool.Data.Context
@using PPMTool.Data.Entities
@using PPMTool.Data.Enums
@using PPMTool.Pages.Components
@using PPMTool.Services
@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
@inject SettingsService SettingsService
@inject FeatureService FeatureService
<PageTitle>CapX - Log In</PageTitle>

@* Style the hamburger icon *@
@if (Environment.IsDevelopment())
{
    <style>
        .rz-sidebar-toggle {
            color: var(--rz-on-danger);
        }
    </style>
}
else
{
    <style>
        .rz-sidebar-toggle {
            color: var(--rz-on-primary);
        }
    </style>
}

<RadzenComponents />
<RadzenLayout>
    <RadzenHeader Style="@($"background-color: {GetBannerColour()}; padding-top: 0.2rem; padding-bottom: 0.2rem;")">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0" JustifyContent="JustifyContent.SpaceBetween" Style="height: 3rem">
            <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Start">
                <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
                @{
                    var logo = SettingsService.GetSetting(SettingType.OrganisationLogo);
                    if (!string.IsNullOrWhiteSpace(logo))
                    {
                        <img class="header-logo" src="@logo" alt="Organisation Logo" />
                    }
                }
                <RadzenText TextStyle="TextStyle.DisplayH5" TagName="TagName.H1" class="@($"header-footer-text {(Environment.IsDevelopment() ? "header-footer-text-dev" : "")}")">CapX - RSE Operational Management Tool</RadzenText>
            </RadzenStack>
            @if (Environment.IsDevelopment())
            {
                <RadzenText TextStyle="TextStyle.DisplayH5" TagName="TagName.H2" class="header-footer-text header-footer-text-dev">&#x26A0; DEVELOPMENT VERSION &#x26A0;</RadzenText>
            }
            <LoginView @ref=loginView />
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar Responsive="false" Style="width: max-content">
        <RadzenPanelMenu DisplayStyle="@(sidebarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)" ShowArrow="true">
            <AuthorizeView>
                <Authorized>
                    @if (FeatureService.IsFeatureEnabled(FeatureType.DataDashboard))
                    {
                        <RadzenPanelMenuItem Path="datadashboard" Text="Data Dashboard" Icon="speed" />
                    }
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Superuser,Manager,Reader,Developer,Finance">
                <Authorized>
                    @if (FeatureService.IsFeatureEnabled(FeatureType.ProjectsAndCapacity))
                    {
                        <RadzenPanelMenuItem Text="Projects" Icon="work" Expanded="true">
                            @if (FeatureService.IsFeatureEnabled(FeatureType.ProjectsAndCapacity))
                            {
                                <AuthorizeView Roles="Superuser,Manager">
                                    <Authorized Context="sub_context">
                                        <RadzenPanelMenuItem Path="myprojects" Text="My Projects" Icon="assignment" />
                                    </Authorized>
                                </AuthorizeView>
                            }
                            @if (FeatureService.IsFeatureEnabled(FeatureType.ProjectsAndCapacity) && FeatureService.IsFeatureEnabled(FeatureType.ProjectFinance))
                            {
                                <AuthorizeView Roles="Superuser,Manager,Reader,Finance">
                                    <Authorized Context="sub_context_2">
                                        <RadzenPanelMenuItem Path="managefinancialitems" Text="Manage Finance" Icon="payments" />
                                    </Authorized>
                                </AuthorizeView>
                                <AuthorizeView Roles="Superuser,Manager,Reader,Finance">
                                    <Authorized Context="sub_context_3">
                                        <RadzenPanelMenuItem Path="estimatecost" Text="Estimate Project Cost" Icon="calculate" />
                                    </Authorized>
                                </AuthorizeView>
                            }
                            @if (FeatureService.IsFeatureEnabled(FeatureType.ProjectsAndCapacity))
                            {
                                <RadzenPanelMenuItem Path="projects" Text="Manage Projects" Icon="folder_managed" />
                                <AuthorizeView Roles="Superuser,Manager,Developer">
                                    <Authorized Context="sub_context_1">
                                        <RadzenPanelMenuItem Path="projectbulletinboard" Text="Available Projects" Icon="developer_board" />
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </RadzenPanelMenuItem>
                    }
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Superuser,Manager,Developer,Reader">
                <Authorized>
                    @if (FeatureService.IsFeatureEnabled(FeatureType.ProjectsAndCapacity))
                    {
                        <RadzenPanelMenuItem Text="Capacity" Icon="lists" Expanded="true">
                            <RadzenPanelMenuItem Path="capacity" Text="Development" Icon="deployed_code_account" />
                            <AuthorizeView Roles="Superuser,Manager,Reader">
                                <Authorized Context="sub_context_1">
                                    <RadzenPanelMenuItem Path="managementcapacity" Text="Management" Icon="supervisor_account" />
                                </Authorized>
                            </AuthorizeView>
                        </RadzenPanelMenuItem>
                    }
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Superuser,Manager,Developer">
                <Authorized>
                    <RadzenPanelMenuItem Text="People" Icon="people" Expanded="true">
                        <RadzenPanelMenuItem Path="people" Text="@(activeUserRoleType == RoleType.Developer ? "My Details" : "Manage People")" Icon="manage_accounts" />
                        @if (activeUserId != null && FeatureService.IsFeatureEnabled(FeatureType.Skills))
                        {
                            <RadzenPanelMenuItem Path="skills" Icon="military_tech">
                                <Template>
                                    <div style="flex: 1;">
                                        @if (sidebarExpanded)
                                        {
                                            <span>My Skills</span>
                                        }
                                        @if (totalIncompleteSkills > 0)
                                        {
                                            <span class="rz-badge rz-badge-warning notification-badge" style="margin-left: 0.25rem;">@totalIncompleteSkills</span>
                                        }
                                    </div>
                                </Template>
                            </RadzenPanelMenuItem>
                        }
                        @if (FeatureService.IsFeatureEnabled(FeatureType.Timesheets))
                        {
                            <RadzenPanelMenuItem Path="wlmanalysis" Text="Workload Model Analysis" Icon="stacked_bar_chart" />
                        }
                        @if (FeatureService.IsFeatureEnabled(FeatureType.DevelopmentJourney))
                        {
                            <RadzenPanelMenuItem Path="competencies" Text="Development Journey" Icon="signpost" />
                        }
                        @if (FeatureService.IsFeatureEnabled(FeatureType.Timesheets))
                        {
                            <RadzenPanelMenuItem Path="timesheets" Icon="timer">
                                <Template>
                                    <div style="flex: 1;">
                                        @if (sidebarExpanded)
                                        {
                                            <span>Timesheets</span>
                                        }
                                        @if (totalTimesheetIssues > 0)
                                        {
                                            <span class="rz-badge rz-badge-danger notification-badge" style="margin-left: 0.25rem;">@totalTimesheetIssues</span>
                                        }
                                    </div>
                                </Template>
                            </RadzenPanelMenuItem>
                        }
                        <AuthorizeView Roles="Superuser,Manager">
                            <Authorized Context="sub_context">
                                @if (FeatureService.IsFeatureEnabled(FeatureType.Absences))
                                {
                                    <RadzenPanelMenuItem Path="absences" Text="Current Absences" Icon="bed" />
                                }
                            </Authorized>
                        </AuthorizeView>
                    </RadzenPanelMenuItem>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Superuser,Manager">
                <Authorized>
                    @if (activeUserRoleType == RoleType.Superuser ||
                            (activeUserRoleType == RoleType.Manager &&
                                (FeatureService.IsFeatureEnabled(FeatureType.ProjectsAndCapacity) && FeatureService.IsFeatureEnabled(FeatureType.ProjectFinance)) ||
                                            FeatureService.IsFeatureEnabled(FeatureType.Skills)
                            )
                        )
                    {
                        <RadzenPanelMenuItem Text="Admin" Icon="admin_panel_settings" Expanded="@adminMenuItemExpanded">
                            <AuthorizeView Roles="Superuser">
                                <Authorized Context="sub_context">
                                    <RadzenPanelMenuItem Path="managesettings" Text="Settings" Icon="settings" />
                                    @if (FeatureService.IsFeatureEnabled(FeatureType.ProjectsAndCapacity))
                                    {
                                        <RadzenPanelMenuItem Path="manageorgunits" Text="Org Units" Icon="widgets" />
                                    }
                                    <RadzenPanelMenuItem Path="manageaccess" Text="Access Control" Icon="lock" />
                                    @if (FeatureService.IsFeatureEnabled(FeatureType.Timesheets))
                                    {
                                        <RadzenPanelMenuItem Path="managecodes" Icon="punch_clock">
                                            <Template>
                                                <div style="flex: 1;">
                                                    @if (sidebarExpanded)
                                                    {
                                                        <span>Timesheet Codes</span>
                                                    }
                                                    @if (totalTimesheetCodesToDeactivate > 0)
                                                    {
                                                        <span class="rz-badge rz-badge-warning notification-badge" style="margin-left: 0.25rem;">@totalTimesheetCodesToDeactivate</span>
                                                    }
                                                </div>
                                            </Template>
                                        </RadzenPanelMenuItem>
                                    }
                                    <RadzenPanelMenuItem Path="managefeatures" Text="Features" Icon="extension" />
                                </Authorized>
                            </AuthorizeView>
                            @if (FeatureService.IsFeatureEnabled(FeatureType.ProjectsAndCapacity) && FeatureService.IsFeatureEnabled(FeatureType.ProjectFinance))
                            {
                                <RadzenPanelMenuItem Path="managefinref" Text="Financial Refs" Icon="currency_pound" />
                            }
                            @if (FeatureService.IsFeatureEnabled(FeatureType.Skills))
                            {
                                <RadzenPanelMenuItem Path="manageskills" Text="Skills Tags" Icon="style" />
                            }
                        </RadzenPanelMenuItem>
                    }
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Superuser,Manager,Developer">
                <Authorized>
                    @if (FeatureService.IsFeatureEnabled(FeatureType.API))
                    {
                        <RadzenPanelMenuItem Path="profile" Text="Developer Settings" Icon="code" />
                    }
                </Authorized>
            </AuthorizeView>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody class="p-0">
        <div class="body-wrapper">
            <div class="content-area rz-p-4">
                <CascadingValue Value="this">
                    @Body
                </CascadingValue>
            </div>
            <footer class="action-footer" style="@(ShowActionBar ? "" : "display:none")">
                <RadzenStack Orientation="Radzen.Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="1rem">
                    @if (ErrorMessage != null)
                    {
                        <StatusMessageComponent Message="ErrorMessage" />
                    }
                    @foreach (var btn in Buttons)
                    {
                        <RadzenButton Text="@btn.Text"
                                      Icon="@btn.Icon"
                                      ButtonStyle="@btn.ButtonStyle"
                                      Click="@(() => btn.OnClick?.Invoke())"
                                      Disabled="@btn.Disabled" />
                    }
                </RadzenStack>
            </footer>
        </div>
    </RadzenBody>
    <RadzenFooter Style="@($"background-color: {GetBannerColour()}; padding-top: 0.2rem; padding-bottom: 0.2rem;")">
        <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="3rem" JustifyContent="JustifyContent.SpaceBetween" Style="height: 3rem">
            <RadzenStack Orientation="Radzen.Orientation.Vertical" Wrap="FlexWrap.NoWrap" Gap=".25rem" JustifyContent="JustifyContent.Start" AlignItems="AlignItems.Center">
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.Span" class="@($"header-footer-text {(Environment.IsDevelopment() ? "header-footer-text-dev" : "")}")" Text="@versionString" title="@commitString" />
                @if (Environment.IsDevelopment())
                {
                    <RadzenBadge BadgeStyle="BadgeStyle.Light" Variant="Variant.Outlined" Text="@commitString" />
                }
            </RadzenStack>
            <AuthorizeView>
                <Authorized>
                    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Style="width: 100%">
                        <div id="magic-bar" style="width: 100%">
                            <RadzenTextBox @bind-Value=@searchTerm
                                           Placeholder="Navigate to a Project or Person by typing and pressing enter..."
                                           Change=@OnSearchTermEntered
                                           aria-label="Search bar to navigate to project or person" />
                        </div>
                        <RadzenButton ButtonStyle="ButtonStyle.Light" ButtonType="ButtonType.Button" Click="ClearMagicBar" Icon="close" />
                    </RadzenStack>
                </Authorized>
            </AuthorizeView>
            <RadzenText TextStyle="TextStyle.Subtitle2"
                        TagName="TagName.Span"
                        class="@($"header-footer-text {(Environment.IsDevelopment() ? "header-footer-text-dev" : "")}")"
                        Text="@SettingsService.GetSetting(SettingType.OrganisationName)" />
        </RadzenStack>
    </RadzenFooter>
</RadzenLayout>